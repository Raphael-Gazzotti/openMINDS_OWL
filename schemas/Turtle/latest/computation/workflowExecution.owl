@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/configuration> a owl:ObjectProperty ;
    rdfs:label "Configuration" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Configuration> <https://openminds.om-i.org/types/Environment> <https://openminds.om-i.org/types/ModelVersion> <https://openminds.om-i.org/types/ValidationTestVersion> <https://openminds.om-i.org/types/WorkflowExecution> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Configuration> <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/PropertyValueList> <https://openminds.om-i.org/types/WebResource> ) ] .

<https://openminds.om-i.org/props/recipe> a owl:ObjectProperty ;
    rdfs:label "Recipe" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/DataAnalysis> <https://openminds.om-i.org/types/DataCopy> <https://openminds.om-i.org/types/GenericComputation> <https://openminds.om-i.org/types/ModelValidation> <https://openminds.om-i.org/types/Optimization> <https://openminds.om-i.org/types/Simulation> <https://openminds.om-i.org/types/Visualization> <https://openminds.om-i.org/types/WorkflowExecution> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/WorkflowRecipeVersion> .

<https://openminds.om-i.org/props/stage> a owl:ObjectProperty ;
    rdfs:label "Stage" ;
    rdfs:domain <https://openminds.om-i.org/types/WorkflowExecution> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/DataAnalysis> <https://openminds.om-i.org/types/DataCopy> <https://openminds.om-i.org/types/GenericComputation> <https://openminds.om-i.org/types/ModelValidation> <https://openminds.om-i.org/types/Optimization> <https://openminds.om-i.org/types/Simulation> <https://openminds.om-i.org/types/Visualization> ) ] .

<https://openminds.om-i.org/props/startedBy> a owl:ObjectProperty ;
    rdfs:label "Started by" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/DataAnalysis> <https://openminds.om-i.org/types/DataCopy> <https://openminds.om-i.org/types/GenericComputation> <https://openminds.om-i.org/types/ModelValidation> <https://openminds.om-i.org/types/Optimization> <https://openminds.om-i.org/types/Simulation> <https://openminds.om-i.org/types/Visualization> <https://openminds.om-i.org/types/WorkflowExecution> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Person> <https://openminds.om-i.org/types/SoftwareAgent> ) ] .

<https://openminds.om-i.org/types/WorkflowExecution> a owl:Class ;
    rdfs:label "Workflow execution" ;
    rdfs:comment "Structured information about an execution of a computational workflow." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/SoftwareAgent> <https://openminds.om-i.org/types/Person> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/startedBy> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/DataAnalysis> <https://openminds.om-i.org/types/DataCopy> <https://openminds.om-i.org/types/GenericComputation> <https://openminds.om-i.org/types/ModelValidation> <https://openminds.om-i.org/types/Optimization> <https://openminds.om-i.org/types/Simulation> <https://openminds.om-i.org/types/Visualization> ) ] ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/stage> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/WorkflowRecipeVersion> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/recipe> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/Configuration> <https://openminds.om-i.org/types/File> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/configuration> ] .

