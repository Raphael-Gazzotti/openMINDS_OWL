<https://openminds.om-i.org/props/homepage> a owl:DatatypeProperty ;
    rdfs:label "Homepage" ;
    rdfs:comment "Main website of something or someone." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalAtlas> <https://openminds.om-i.org/types/AnatomicalAtlasVersion> <https://openminds.om-i.org/types/CommonCoordinateFramework> <https://openminds.om-i.org/types/CommonCoordinateFrameworkVersion> <https://openminds.om-i.org/types/Consortium> <https://openminds.om-i.org/types/Dataset> <https://openminds.om-i.org/types/DatasetVersion> <https://openminds.om-i.org/types/Interface> <https://openminds.om-i.org/types/InterfaceVersion> <https://openminds.om-i.org/types/LivePaper> <https://openminds.om-i.org/types/LivePaperVersion> <https://openminds.om-i.org/types/MetaDataModel> <https://openminds.om-i.org/types/MetaDataModelVersion> <https://openminds.om-i.org/types/Model> <https://openminds.om-i.org/types/ModelVersion> <https://openminds.om-i.org/types/Organization> <https://openminds.om-i.org/types/Project> <https://openminds.om-i.org/types/Software> <https://openminds.om-i.org/types/SoftwareVersion> <https://openminds.om-i.org/types/ValidationTest> <https://openminds.om-i.org/types/ValidationTestVersion> <https://openminds.om-i.org/types/WorkflowRecipe> <https://openminds.om-i.org/types/WorkflowRecipeVersion> ) ] ;
    rdfs:range xsd:string .

