@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/accessibility> a owl:ObjectProperty ;
    rdfs:label "Accessibility" ;
    rdfs:comment "Level to which something is accessible to someone or something." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalAtlasVersion> <https://openminds.om-i.org/types/CommonCoordinateFrameworkVersion> <https://openminds.om-i.org/types/DatasetVersion> <https://openminds.om-i.org/types/DeployedInterface> <https://openminds.om-i.org/types/InterfaceVersion> <https://openminds.om-i.org/types/LivePaperVersion> <https://openminds.om-i.org/types/MetaDataModelVersion> <https://openminds.om-i.org/types/ModelVersion> <https://openminds.om-i.org/types/SoftwareVersion> <https://openminds.om-i.org/types/ValidationTestVersion> <https://openminds.om-i.org/types/WorkflowRecipeVersion> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/Accessibility> .

<https://openminds.om-i.org/props/entryPoint> a owl:ObjectProperty ;
    rdfs:label "Entry point" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/DeployedInterface> <https://openminds.om-i.org/types/ModelVersion> <https://openminds.om-i.org/types/ValidationTestVersion> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/WebResource> .

<https://openminds.om-i.org/props/interface> a owl:ObjectProperty ;
    rdfs:label "Interface" ;
    rdfs:domain <https://openminds.om-i.org/types/DeployedInterface> ;
    rdfs:range <https://openminds.om-i.org/types/InterfaceVersion> .

<https://openminds.om-i.org/types/DeployedInterface> a owl:Class ;
    rdfs:label "Deployed interface" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/WebResource> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/entryPoint> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/InterfaceVersion> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/interface> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Accessibility> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/accessibility> ] .

