@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/amount> a owl:ObjectProperty ;
    rdfs:label "Amount" ;
    rdfs:domain <https://openminds.om-i.org/types/AmountOfChemical> ;
    rdfs:range <https://openminds.om-i.org/types/QuantitativeValue> .

<https://openminds.om-i.org/props/chemicalProduct> a owl:ObjectProperty ;
    rdfs:label "Chemical product" ;
    rdfs:domain <https://openminds.om-i.org/types/AmountOfChemical> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/ChemicalMixture> <https://openminds.om-i.org/types/ChemicalSubstance> <https://openminds.om-i.org/types/MolecularEntity> ) ] .

<https://openminds.om-i.org/types/AmountOfChemical> a owl:Class ;
    rdfs:label "Amount of chemical" ;
    rdfs:comment "Structured information about the amount of a given chemical that was used." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/QuantitativeValue> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/amount> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/ChemicalMixture> <https://openminds.om-i.org/types/ChemicalSubstance> <https://openminds.om-i.org/types/MolecularEntity> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/chemicalProduct> ] .

