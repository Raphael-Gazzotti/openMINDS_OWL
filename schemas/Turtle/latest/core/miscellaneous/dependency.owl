@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/failureImpact> a owl:ObjectProperty ;
    rdfs:label "Failure impact" ;
    rdfs:domain <https://openminds.om-i.org/types/Dependency> ;
    rdfs:range <https://openminds.om-i.org/types/DependencyImpact> .

<https://openminds.om-i.org/props/fulfilledBy> a owl:ObjectProperty ;
    rdfs:label "Fulfilled by" ;
    rdfs:domain <https://openminds.om-i.org/types/Dependency> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Configuration> <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/InterfaceVersion> <https://openminds.om-i.org/types/SoftwareVersion> <https://openminds.om-i.org/types/WebResource> ) ] .

<https://openminds.om-i.org/types/Dependency> a owl:Class ;
    rdfs:label "Dependency" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/DependencyImpact> ;
            owl:onProperty <https://openminds.om-i.org/props/failureImpact> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/Configuration> <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/InterfaceVersion> <https://openminds.om-i.org/types/SoftwareVersion> <https://openminds.om-i.org/types/WebResource> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/fulfilledBy> ] .

