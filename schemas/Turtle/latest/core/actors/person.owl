@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/familyName> a owl:DatatypeProperty ;
    rdfs:label "Family name" ;
    rdfs:comment "Name borne in common by members of a family." ;
    rdfs:domain <https://openminds.om-i.org/types/Person> ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/givenName> a owl:DatatypeProperty ;
    rdfs:label "Given name" ;
    rdfs:comment "Name given to a person, including all potential middle names, but excluding the family name." ;
    rdfs:domain <https://openminds.om-i.org/types/Person> ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/alternateName> a owl:DatatypeProperty ;
    rdfs:label "Alternate name" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Organization> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/Person> ) ] ;
    rdfs:range rdf:List .

<https://openminds.om-i.org/props/associatedAccount> a owl:ObjectProperty ;
    rdfs:label "Associated account" ;
    rdfs:domain <https://openminds.om-i.org/types/Person> ;
    rdfs:range <https://openminds.om-i.org/types/AccountInformation> .

<https://openminds.om-i.org/props/contactInformation> a owl:ObjectProperty ;
    rdfs:label "Contact information" ;
    rdfs:comment "Any available way used to contact a person or business (e.g., address, phone number, email address, etc.)." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Consortium> <https://openminds.om-i.org/types/Person> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/ContactInformation> .

<https://openminds.om-i.org/props/digitalIdentifier> a owl:ObjectProperty ;
    rdfs:label "Digital identifier" ;
    rdfs:comment "Digital handle to identify objects or legal persons." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalAtlas> <https://openminds.om-i.org/types/AnatomicalAtlasVersion> <https://openminds.om-i.org/types/Book> <https://openminds.om-i.org/types/Chapter> <https://openminds.om-i.org/types/CommonCoordinateFramework> <https://openminds.om-i.org/types/CommonCoordinateFrameworkVersion> <https://openminds.om-i.org/types/Dataset> <https://openminds.om-i.org/types/DatasetVersion> <https://openminds.om-i.org/types/HardwareProduct> <https://openminds.om-i.org/types/LearningResource> <https://openminds.om-i.org/types/LivePaper> <https://openminds.om-i.org/types/LivePaperVersion> <https://openminds.om-i.org/types/MetaDataModel> <https://openminds.om-i.org/types/MetaDataModelVersion> <https://openminds.om-i.org/types/Model> <https://openminds.om-i.org/types/ModelVersion> <https://openminds.om-i.org/types/Organization> <https://openminds.om-i.org/types/ParcellationTerminology> <https://openminds.om-i.org/types/ParcellationTerminologyVersion> <https://openminds.om-i.org/types/Periodical> <https://openminds.om-i.org/types/Person> <https://openminds.om-i.org/types/ProductSource> <https://openminds.om-i.org/types/ScholarlyArticle> <https://openminds.om-i.org/types/Software> <https://openminds.om-i.org/types/SoftwareVersion> <https://openminds.om-i.org/types/Strain> <https://openminds.om-i.org/types/ValidationTest> <https://openminds.om-i.org/types/ValidationTestVersion> <https://openminds.om-i.org/types/WorkflowRecipe> <https://openminds.om-i.org/types/WorkflowRecipeVersion> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/DOI> <https://openminds.om-i.org/types/GenericIdentifier> <https://openminds.om-i.org/types/ISBN> <https://openminds.om-i.org/types/ISNI> <https://openminds.om-i.org/types/ISSN> <https://openminds.om-i.org/types/IdentifiersDotOrgID> <https://openminds.om-i.org/types/LEI> <https://openminds.om-i.org/types/ORCID> <https://openminds.om-i.org/types/RORID> <https://openminds.om-i.org/types/RRID> <https://openminds.om-i.org/types/SWHID> ) ] .

<https://openminds.om-i.org/props/preferredName> a owl:DatatypeProperty ;
    rdfs:label "Preferred name" ;
    rdfs:domain <https://openminds.om-i.org/types/Person> ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/types/Person> a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "Structured information on a person." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/ContactInformation> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/contactInformation> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/preferredName> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/AccountInformation> ;
            owl:onProperty <https://openminds.om-i.org/props/associatedAccount> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/alternateName> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/GenericIdentifier> <https://openminds.om-i.org/types/ORCID> ) ] ;
            owl:onProperty <https://openminds.om-i.org/props/digitalIdentifier> ] .

