    rdfs:comment "Term or code used to identify something or someone registered within a particular ontology." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalAtlas> <https://openminds.om-i.org/types/AnatomicalAtlasVersion> <https://openminds.om-i.org/types/CommonCoordinateFramework> <https://openminds.om-i.org/types/CommonCoordinateFrameworkVersion> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/ParcellationTerminology> <https://openminds.om-i.org/types/ParcellationTerminologyVersion> <https://openminds.om-i.org/types/Strain> ) ] ;
    rdfs:range rdf:List .

<https://openminds.om-i.org/props/species> a owl:ObjectProperty ;
    rdfs:label "Species" ;
    rdfs:comment "Category of biological classification comprising related organisms or populations potentially capable of interbreeding, and being designated by a binomial that consists of the name of a genus followed by a Latin or latinized uncapitalized noun or adjective." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Strain> <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Species> <https://openminds.om-i.org/types/Strain> ) ] .

<https://openminds.om-i.org/props/stockNumber> a owl:ObjectProperty ;
    rdfs:label "Stock number" ;
    rdfs:domain <https://openminds.om-i.org/types/Strain> ;
    rdfs:range <https://openminds.om-i.org/types/StockNumber> .

<https://openminds.om-i.org/props/synonym> a owl:DatatypeProperty ;
    rdfs:label "Synonym" ;
    rdfs:comment "Words or expressions used in the same language that have the same or nearly the same meaning in some or all senses." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AccessChannel> <https://openminds.om-i.org/types/AccessEligibilityType> <https://openminds.om-i.org/types/AccessForm> <https://openminds.om-i.org/types/AccessProcessType> <https://openminds.om-i.org/types/ActionStatusType> <https://openminds.om-i.org/types/AgeCategory> <https://openminds.om-i.org/types/AgeReference> <https://openminds.om-i.org/types/AnalysisTechnique> <https://openminds.om-i.org/types/AnatomicalAxesOrientation> <https://openminds.om-i.org/types/AnatomicalCavity> <https://openminds.om-i.org/types/AnatomicalIdentificationType> <https://openminds.om-i.org/types/AnatomicalPlane> <https://openminds.om-i.org/types/AnnotationCriteriaType> <https://openminds.om-i.org/types/AnnotationType> <https://openminds.om-i.org/types/AtlasType> <https://openminds.om-i.org/types/AuditoryStimulusType> <https://openminds.om-i.org/types/BiologicalOrder> <https://openminds.om-i.org/types/BiologicalProcess> <https://openminds.om-i.org/types/BiologicalSex> <https://openminds.om-i.org/types/BreedingType> <https://openminds.om-i.org/types/CellCultureType> <https://openminds.om-i.org/types/CellType> <https://openminds.om-i.org/types/ChemicalMixtureType> <https://openminds.om-i.org/types/Colormap> <https://openminds.om-i.org/types/CommunicationInterfaceType> <https://openminds.om-i.org/types/CommunicationProtocol> <https://openminds.om-i.org/types/ContentType> <https://openminds.om-i.org/types/ContributionType> <https://openminds.om-i.org/types/CranialWindowConstructionType> <https://openminds.om-i.org/types/CranialWindowReinforcementType> <https://openminds.om-i.org/types/CriteriaQualityType> <https://openminds.om-i.org/types/DataType> <https://openminds.om-i.org/types/DependencyImpact> <https://openminds.om-i.org/types/DeploymentEnvironmentType> <https://openminds.om-i.org/types/DeviceMountingType> <https://openminds.om-i.org/types/DeviceType> <https://openminds.om-i.org/types/DifferenceMeasure> <https://openminds.om-i.org/types/Disease> <https://openminds.om-i.org/types/DiseaseModel> <https://openminds.om-i.org/types/EducationalLevel> <https://openminds.om-i.org/types/ElectricalStimulusType> <https://openminds.om-i.org/types/ExperimentalApproach> <https://openminds.om-i.org/types/ExternalBodyRegion> <https://openminds.om-i.org/types/FileBundleGrouping> <https://openminds.om-i.org/types/FileRepositoryType> <https://openminds.om-i.org/types/FileUsageRole> <https://openminds.om-i.org/types/GeneticStrainType> <https://openminds.om-i.org/types/GustatoryStimulusType> <https://openminds.om-i.org/types/Handedness> <https://openminds.om-i.org/types/Language> <https://openminds.om-i.org/types/Laterality> <https://openminds.om-i.org/types/LearningResourceType> <https://openminds.om-i.org/types/MRIFatSuppressionTechnique> <https://openminds.om-i.org/types/MRIParallelAcquisitionTechnique> <https://openminds.om-i.org/types/MRIPulseSequence> <https://openminds.om-i.org/types/MRISpoilingTechnique> <https://openminds.om-i.org/types/MRIWeighting> <https://openminds.om-i.org/types/MeasuredQuantity> <https://openminds.om-i.org/types/MeasuredSignalType> <https://openminds.om-i.org/types/MetaDataModelType> <https://openminds.om-i.org/types/ModelAbstractionLevel> <https://openminds.om-i.org/types/ModelScope> <https://openminds.om-i.org/types/ModificationConsentRequirement> <https://openminds.om-i.org/types/ModificationConstraint> <https://openminds.om-i.org/types/ModificationForm> <https://openminds.om-i.org/types/ModificationScope> <https://openminds.om-i.org/types/MolecularEntity> <https://openminds.om-i.org/types/MuscularStructure> <https://openminds.om-i.org/types/NervousSystemStructure> <https://openminds.om-i.org/types/OlfactoryStimulusType> <https://openminds.om-i.org/types/OperatingDevice> <https://openminds.om-i.org/types/OperatingSystem> <https://openminds.om-i.org/types/OperationalApproach> <https://openminds.om-i.org/types/OpticalStimulusType> <https://openminds.om-i.org/types/Organ> <https://openminds.om-i.org/types/OrganSystemStructure> <https://openminds.om-i.org/types/OrganismSubstance> <https://openminds.om-i.org/types/OrganismSystem> <https://openminds.om-i.org/types/OrganizationType> <https://openminds.om-i.org/types/PatchClampVariation> <https://openminds.om-i.org/types/PaymentModelType> <https://openminds.om-i.org/types/PreparationType> <https://openminds.om-i.org/types/ProgrammingLanguage> <https://openminds.om-i.org/types/ProjectType> <https://openminds.om-i.org/types/PublicationStatus> <https://openminds.om-i.org/types/PulseShape> <https://openminds.om-i.org/types/QualitativeOverlap> <https://openminds.om-i.org/types/SemanticDataType> <https://openminds.om-i.org/types/SetupType> <https://openminds.om-i.org/types/SignalDirectionality> <https://openminds.om-i.org/types/SkeletalStructure> <https://openminds.om-i.org/types/SoftwareApplicationCategory> <https://openminds.om-i.org/types/SoftwareFeature> <https://openminds.om-i.org/types/SovereignState> <https://openminds.om-i.org/types/SpatialEncoding> <https://openminds.om-i.org/types/Species> <https://openminds.om-i.org/types/StimulationApproach> <https://openminds.om-i.org/types/StimulationTechnique> <https://openminds.om-i.org/types/Strain> <https://openminds.om-i.org/types/SubcellularEntity> <https://openminds.om-i.org/types/SubjectAttribute> <https://openminds.om-i.org/types/SupranationalBody> <https://openminds.om-i.org/types/TactileStimulusType> <https://openminds.om-i.org/types/Technique> <https://openminds.om-i.org/types/TermSuggestion> <https://openminds.om-i.org/types/Terminology> <https://openminds.om-i.org/types/TissueSampleAttribute> <https://openminds.om-i.org/types/TissueSampleType> <https://openminds.om-i.org/types/TissueStructure> <https://openminds.om-i.org/types/TypeOfUncertainty> <https://openminds.om-i.org/types/UnitOfMeasurement> <https://openminds.om-i.org/types/VascularStructure> <https://openminds.om-i.org/types/VisualStimulusType> <https://openminds.om-i.org/types/WeightType> ) ] ;
    rdfs:range rdf:List .

<https://openminds.om-i.org/types/Strain> a owl:Class ;
    rdfs:label "Strain" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/Disease> <https://openminds.om-i.org/types/DiseaseModel> ) ] ;
            owl:onProperty <https://openminds.om-i.org/props/diseaseModel> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/synonym> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Species> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/species> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/BreedingType> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/breedingType> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/alternateIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/RRID> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/digitalIdentifier> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/ontologyIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/GeneticStrainType> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/geneticStrainType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/StockNumber> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/stockNumber> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Strain> ;
            owl:onProperty <https://openminds.om-i.org/props/backgroundStrain> ] .

