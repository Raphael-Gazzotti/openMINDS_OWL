@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/additionalRemarks> a owl:DatatypeProperty ;
    rdfs:label "Additional remarks" ;
    rdfs:comment "Mention of what deserves additional attention or notice." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalTargetPosition> <https://openminds.om-i.org/types/ChemicalMixture> <https://openminds.om-i.org/types/ChemicalSubstance> <https://openminds.om-i.org/types/GridImage> <https://openminds.om-i.org/types/GridImageStack> <https://openminds.om-i.org/types/GridVolume> <https://openminds.om-i.org/types/GridVolumeSequence> <https://openminds.om-i.org/types/Measurement> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/SubjectGroupState> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueSampleCollection> <https://openminds.om-i.org/types/TissueSampleCollectionState> <https://openminds.om-i.org/types/TissueSampleState> <https://openminds.om-i.org/types/ViewerSpecification> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/timestamp> a owl:DatatypeProperty ;
    rdfs:label "Timestamp" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Comment> <https://openminds.om-i.org/types/Measurement> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/measuredQuantity> a owl:ObjectProperty ;
    rdfs:label "Measured quantity" ;
    rdfs:domain <https://openminds.om-i.org/types/Measurement> ;
    rdfs:range <https://openminds.om-i.org/types/MeasuredQuantity> .

<https://openminds.om-i.org/props/obtainedWith> a owl:ObjectProperty ;
    rdfs:label "Obtained with" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/GridImage> <https://openminds.om-i.org/types/GridImageStack> <https://openminds.om-i.org/types/GridVolume> <https://openminds.om-i.org/types/GridVolumeSequence> <https://openminds.om-i.org/types/Measurement> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/ElectrodeArrayUsage> <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/MRICoilUsage> <https://openminds.om-i.org/types/MRIScannerUsage> <https://openminds.om-i.org/types/PipetteUsage> <https://openminds.om-i.org/types/SlicingDeviceUsage> ) ] .

<https://openminds.om-i.org/props/value> a owl:ObjectProperty ;
    rdfs:label "Value" ;
    rdfs:comment "Entry for a property." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Measurement> <https://openminds.om-i.org/types/NumericalProperty> <https://openminds.om-i.org/types/QuantitativeValue> <https://openminds.om-i.org/types/SingleColor> <https://openminds.om-i.org/types/StringProperty> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/QuantitativeValue> <https://openminds.om-i.org/types/QuantitativeValueRange> ) ] .

<https://openminds.om-i.org/types/Measurement> a owl:Class ;
    rdfs:label "Measurement" ;
    rdfs:comment "Structured information about a measurement performed during a scientific experiment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/QuantitativeValue> <https://openminds.om-i.org/types/QuantitativeValueRange> ) ] ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/MeasuredQuantity> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/measuredQuantity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/ElectrodeArrayUsage> <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/PipetteUsage> <https://openminds.om-i.org/types/MRICoilUsage> <https://openminds.om-i.org/types/MRIScannerUsage> <https://openminds.om-i.org/types/SlicingDeviceUsage> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/obtainedWith> ] .

