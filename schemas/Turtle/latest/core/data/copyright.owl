@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/customUsageClause> a owl:DatatypeProperty ;
    rdfs:label "Custom usage clause" ;
    rdfs:domain <https://openminds.om-i.org/types/Copyright> ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/holder> a owl:ObjectProperty ;
    rdfs:label "Holder" ;
    rdfs:comment "Legal person in possession of something." ;
    rdfs:domain <https://openminds.om-i.org/types/Copyright> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Organization> <https://openminds.om-i.org/types/Person> ) ] .

<https://openminds.om-i.org/props/year> a owl:DatatypeProperty ;
    rdfs:label "Year" ;
    rdfs:comment "Cycle in the Gregorian calendar specified by a number and comprised of 365 or 366 days divided into 12 months beginning with January and ending with December." ;
    rdfs:domain <https://openminds.om-i.org/types/Copyright> ;
    rdfs:range rdf:List .

<https://openminds.om-i.org/types/Copyright> a owl:Class ;
    rdfs:label "Copyright" ;
    rdfs:comment "Structured information on the copyright." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/year> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/year> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/Organization> <https://openminds.om-i.org/types/Person> ) ] ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/holder> ] .

