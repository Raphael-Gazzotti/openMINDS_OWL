@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/lookupLabel> a owl:DatatypeProperty ;
    rdfs:label "Lookup label" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CellPatching> <https://openminds.om-i.org/types/ChemicalSubstance> <https://openminds.om-i.org/types/Configuration> <https://openminds.om-i.org/types/ContentTypePattern> <https://openminds.om-i.org/types/CranialWindowPreparation> <https://openminds.om-i.org/types/DataAnalysis> <https://openminds.om-i.org/types/DataCopy> <https://openminds.om-i.org/types/DynamicMRIAcquisition> <https://openminds.om-i.org/types/ElectrodeArrayUsage> <https://openminds.om-i.org/types/ElectrodePlacement> <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/EphysStimulus> <https://openminds.om-i.org/types/FileRepositoryStructure> <https://openminds.om-i.org/types/GenericComputation> <https://openminds.om-i.org/types/MRICoilUsage> <https://openminds.om-i.org/types/MRIScannerUsage> <https://openminds.om-i.org/types/ModelValidation> <https://openminds.om-i.org/types/Optimization> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/PipetteUsage> <https://openminds.om-i.org/types/PropertyValueList> <https://openminds.om-i.org/types/ProtocolExecution> <https://openminds.om-i.org/types/RecordingActivity> <https://openminds.om-i.org/types/Simulation> <https://openminds.om-i.org/types/SlicingDeviceUsage> <https://openminds.om-i.org/types/StaticMRIAcquisition> <https://openminds.om-i.org/types/StimulationActivity> <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/SubjectGroupState> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueCulturePreparation> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> <https://openminds.om-i.org/types/TissueSampleCollectionState> <https://openminds.om-i.org/types/TissueSampleSlicing> <https://openminds.om-i.org/types/TissueSampleState> <https://openminds.om-i.org/types/Visualization> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/anatomicalLocation> a owl:ObjectProperty ;
    rdfs:label "Anatomical location" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/PipetteUsage> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalCavity> <https://openminds.om-i.org/types/CellType> <https://openminds.om-i.org/types/CustomAnatomicalEntity> <https://openminds.om-i.org/types/ExternalBodyRegion> <https://openminds.om-i.org/types/MuscularStructure> <https://openminds.om-i.org/types/NervousSystemStructure> <https://openminds.om-i.org/types/Organ> <https://openminds.om-i.org/types/OrganSystemStructure> <https://openminds.om-i.org/types/OrganismSubstance> <https://openminds.om-i.org/types/OrganismSystem> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/SkeletalStructure> <https://openminds.om-i.org/types/SubcellularEntity> <https://openminds.om-i.org/types/TissueStructure> <https://openminds.om-i.org/types/VascularStructure> ) ] .

<https://openminds.om-i.org/props/chlorideReversalPotential> a owl:ObjectProperty ;
    rdfs:label "Chloride reversal potential" ;
    rdfs:domain <https://openminds.om-i.org/types/PipetteUsage> ;
    rdfs:range <https://openminds.om-i.org/types/Measurement> .

<https://openminds.om-i.org/props/compensationCurrent> a owl:ObjectProperty ;
    rdfs:label "Compensation current" ;
    rdfs:domain <https://openminds.om-i.org/types/PipetteUsage> ;
    rdfs:range <https://openminds.om-i.org/types/Measurement> .

<https://openminds.om-i.org/props/device> a owl:ObjectProperty ;
    rdfs:label "Device" ;
    rdfs:comment "Piece of equipment or mechanism (hardware) designed to serve a special purpose or perform a special function." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CellPatching> <https://openminds.om-i.org/types/DynamicMRIAcquisition> <https://openminds.om-i.org/types/ElectrodeArrayUsage> <https://openminds.om-i.org/types/ElectrodePlacement> <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/MRICoilUsage> <https://openminds.om-i.org/types/MRIScannerUsage> <https://openminds.om-i.org/types/PipetteUsage> <https://openminds.om-i.org/types/RecordingActivity> <https://openminds.om-i.org/types/SlicingDeviceUsage> <https://openminds.om-i.org/types/StaticMRIAcquisition> <https://openminds.om-i.org/types/TissueSampleSlicing> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Electrode> <https://openminds.om-i.org/types/ElectrodeArray> <https://openminds.om-i.org/types/ElectrodeArrayUsage> <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/MRICoil> <https://openminds.om-i.org/types/MRICoilUsage> <https://openminds.om-i.org/types/MRIScanner> <https://openminds.om-i.org/types/MRIScannerUsage> <https://openminds.om-i.org/types/Pipette> <https://openminds.om-i.org/types/PipetteUsage> <https://openminds.om-i.org/types/SlicingDevice> <https://openminds.om-i.org/types/SlicingDeviceUsage> ) ] .

<https://openminds.om-i.org/props/endMembranePotential> a owl:ObjectProperty ;
    rdfs:label "End membrane potential" ;
    rdfs:domain <https://openminds.om-i.org/types/PipetteUsage> ;
    rdfs:range <https://openminds.om-i.org/types/Measurement> .

<https://openminds.om-i.org/props/holdingPotential> a owl:ObjectProperty ;
    rdfs:label "Holding potential" ;
    rdfs:domain <https://openminds.om-i.org/types/PipetteUsage> ;
    rdfs:range <https://openminds.om-i.org/types/Measurement> .

<https://openminds.om-i.org/props/inputResistance> a owl:ObjectProperty ;
    rdfs:label "Input resistance" ;
    rdfs:domain <https://openminds.om-i.org/types/PipetteUsage> ;
    rdfs:range <https://openminds.om-i.org/types/Measurement> .

<https://openminds.om-i.org/props/labelingCompound> a owl:ObjectProperty ;
    rdfs:label "Labeling compound" ;
    rdfs:domain <https://openminds.om-i.org/types/PipetteUsage> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/ChemicalMixture> <https://openminds.om-i.org/types/ChemicalSubstance> <https://openminds.om-i.org/types/MolecularEntity> ) ] .

<https://openminds.om-i.org/props/liquidJunctionPotential> a owl:ObjectProperty ;
    rdfs:label "Liquid junction potential" ;
    rdfs:domain <https://openminds.om-i.org/types/PipetteUsage> ;
    rdfs:range <https://openminds.om-i.org/types/Measurement> .

<https://openminds.om-i.org/props/metadataLocation> a owl:ObjectProperty ;
    rdfs:label "Metadata location" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/ElectrodeArrayUsage> <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/MRICoilUsage> <https://openminds.om-i.org/types/MRIScannerUsage> <https://openminds.om-i.org/types/PipetteUsage> <https://openminds.om-i.org/types/SlicingDeviceUsage> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/FileBundle> ) ] .

<https://openminds.om-i.org/props/pipetteResistance> a owl:ObjectProperty ;
    rdfs:label "Pipette resistance" ;
    rdfs:domain <https://openminds.om-i.org/types/PipetteUsage> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/QuantitativeValue> <https://openminds.om-i.org/types/QuantitativeValueRange> ) ] .

<https://openminds.om-i.org/props/pipetteSolution> a owl:ObjectProperty ;
    rdfs:label "Pipette solution" ;
    rdfs:domain <https://openminds.om-i.org/types/PipetteUsage> ;
    rdfs:range <https://openminds.om-i.org/types/ChemicalMixture> .

<https://openminds.om-i.org/props/sealResistance> a owl:ObjectProperty ;
    rdfs:label "Seal resistance" ;
    rdfs:domain <https://openminds.om-i.org/types/PipetteUsage> ;
    rdfs:range <https://openminds.om-i.org/types/Measurement> .

<https://openminds.om-i.org/props/seriesResistance> a owl:ObjectProperty ;
    rdfs:label "Series resistance" ;
    rdfs:domain <https://openminds.om-i.org/types/PipetteUsage> ;
    rdfs:range <https://openminds.om-i.org/types/Measurement> .

<https://openminds.om-i.org/props/spatialLocation> a owl:ObjectProperty ;
    rdfs:label "Spatial location" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalTargetPosition> <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/PipetteUsage> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/CoordinatePoint> .

<https://openminds.om-i.org/props/startMembranePotential> a owl:ObjectProperty ;
    rdfs:label "Start membrane potential" ;
    rdfs:domain <https://openminds.om-i.org/types/PipetteUsage> ;
    rdfs:range <https://openminds.om-i.org/types/Measurement> .

<https://openminds.om-i.org/props/usedSpecimen> a owl:ObjectProperty ;
    rdfs:label "Used specimen" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalAtlasVersion> <https://openminds.om-i.org/types/CommonCoordinateFrameworkVersion> <https://openminds.om-i.org/types/ElectrodeArrayUsage> <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/MRICoilUsage> <https://openminds.om-i.org/types/MRIScannerUsage> <https://openminds.om-i.org/types/PipetteUsage> <https://openminds.om-i.org/types/SlicingDeviceUsage> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> <https://openminds.om-i.org/types/TissueSampleState> ) ] .

<https://openminds.om-i.org/types/PipetteUsage> a owl:Class ;
    rdfs:label "Pipette usage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Measurement> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/inputResistance> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/ChemicalMixture> <https://openminds.om-i.org/types/ChemicalSubstance> <https://openminds.om-i.org/types/MolecularEntity> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/labelingCompound> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Measurement> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/seriesResistance> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/CoordinatePoint> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/spatialLocation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalCavity> <https://openminds.om-i.org/types/CellType> <https://openminds.om-i.org/types/ExternalBodyRegion> <https://openminds.om-i.org/types/MuscularStructure> <https://openminds.om-i.org/types/NervousSystemStructure> <https://openminds.om-i.org/types/Organ> <https://openminds.om-i.org/types/OrganSystemStructure> <https://openminds.om-i.org/types/OrganismSubstance> <https://openminds.om-i.org/types/OrganismSystem> <https://openminds.om-i.org/types/SkeletalStructure> <https://openminds.om-i.org/types/SubcellularEntity> <https://openminds.om-i.org/types/TissueStructure> <https://openminds.om-i.org/types/VascularStructure> <https://openminds.om-i.org/types/CustomAnatomicalEntity> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/anatomicalLocation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Pipette> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/device> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Measurement> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/compensationCurrent> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/FileBundle> ) ] ;
            owl:onProperty <https://openminds.om-i.org/props/metadataLocation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Measurement> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/startMembranePotential> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Measurement> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/liquidJunctionPotential> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/QuantitativeValue> <https://openminds.om-i.org/types/QuantitativeValueRange> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/pipetteResistance> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Measurement> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/holdingPotential> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Measurement> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/endMembranePotential> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Measurement> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/sealResistance> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueSampleState> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/usedSpecimen> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Measurement> ;
            owl:onProperty <https://openminds.om-i.org/props/chlorideReversalPotential> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/ChemicalMixture> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/pipetteSolution> ] .

