@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/equatorialDiameter> a owl:ObjectProperty ;
    rdfs:label "Equatorial diameter" ;
    rdfs:domain <https://openminds.om-i.org/types/Spheroid> ;
    rdfs:range <https://openminds.om-i.org/types/QuantitativeValue> .

<https://openminds.om-i.org/props/polarDiameter> a owl:ObjectProperty ;
    rdfs:label "Polar diameter" ;
    rdfs:domain <https://openminds.om-i.org/types/Spheroid> ;
    rdfs:range <https://openminds.om-i.org/types/QuantitativeValue> .

<https://openminds.om-i.org/types/Spheroid> a owl:Class ;
    rdfs:label "Spheroid" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/QuantitativeValue> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/equatorialDiameter> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/QuantitativeValue> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/polarDiameter> ] .

