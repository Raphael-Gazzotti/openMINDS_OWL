@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/intermediateDiameter> a owl:ObjectProperty ;
    rdfs:label "Intermediate diameter" ;
    rdfs:domain <https://openminds.om-i.org/types/Ellipsoid> ;
    rdfs:range <https://openminds.om-i.org/types/QuantitativeValue> .

<https://openminds.om-i.org/props/majorDiameter> a owl:ObjectProperty ;
    rdfs:label "Major diameter" ;
    rdfs:domain <https://openminds.om-i.org/types/Ellipsoid> ;
    rdfs:range <https://openminds.om-i.org/types/QuantitativeValue> .

<https://openminds.om-i.org/props/minorDiameter> a owl:ObjectProperty ;
    rdfs:label "Minor diameter" ;
    rdfs:domain <https://openminds.om-i.org/types/Ellipsoid> ;
    rdfs:range <https://openminds.om-i.org/types/QuantitativeValue> .

<https://openminds.om-i.org/types/Ellipsoid> a owl:Class ;
    rdfs:label "Ellipsoid" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/QuantitativeValue> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/intermediateDiameter> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/QuantitativeValue> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/majorDiameter> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/QuantitativeValue> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/minorDiameter> ] .

