@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/internalIdentifier> a owl:DatatypeProperty ;
    rdfs:label "Internal identifier" ;
    rdfs:comment "Term or code that identifies someone or something within a particular product." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AtlasAnnotation> <https://openminds.om-i.org/types/BehavioralProtocol> <https://openminds.om-i.org/types/Channel> <https://openminds.om-i.org/types/CustomAnnotation> <https://openminds.om-i.org/types/Electrode> <https://openminds.om-i.org/types/ElectrodeArray> <https://openminds.om-i.org/types/EphysStimulus> <https://openminds.om-i.org/types/Pipette> <https://openminds.om-i.org/types/Recording> <https://openminds.om-i.org/types/RecordingActivity> <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/SubjectGroupState> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> <https://openminds.om-i.org/types/TissueSampleCollectionState> <https://openminds.om-i.org/types/TissueSampleState> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/anchorPoint> a owl:ObjectProperty ;
    rdfs:label "Anchor point" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AtlasAnnotation> <https://openminds.om-i.org/types/CustomAnnotation> <https://openminds.om-i.org/types/ViewerSpecification> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/QuantitativeValue> .

<https://openminds.om-i.org/props/criteria> a owl:ObjectProperty ;
    rdfs:label "Criteria" ;
    rdfs:comment "Aspects or standards on which a judgement or decision is based." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AtlasAnnotation> <https://openminds.om-i.org/types/CustomAnnotation> <https://openminds.om-i.org/types/QualitativeRelationAssessment> <https://openminds.om-i.org/types/QuantitativeRelationAssessment> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/ProtocolExecution> .

<https://openminds.om-i.org/props/criteriaQualityType> a owl:ObjectProperty ;
    rdfs:label "Criteria quality type" ;
    rdfs:comment "Distinct class that defines how the judgement or decision was made for a particular criteria." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AtlasAnnotation> <https://openminds.om-i.org/types/CustomAnnotation> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/CriteriaQualityType> .

<https://openminds.om-i.org/props/criteriaType> a owl:ObjectProperty ;
    rdfs:label "Criteria type" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AtlasAnnotation> <https://openminds.om-i.org/types/CustomAnnotation> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/AnnotationCriteriaType> .

<https://openminds.om-i.org/props/inspiredBy> a owl:ObjectProperty ;
    rdfs:label "Inspired by" ;
    rdfs:comment "Reference to an inspiring element." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AtlasAnnotation> <https://openminds.om-i.org/types/CustomAnnotation> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/File> .

<https://openminds.om-i.org/props/laterality> a owl:ObjectProperty ;
    rdfs:label "Laterality" ;
    rdfs:comment "Differentiation between a pair of lateral homologous parts of the body." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AtlasAnnotation> <https://openminds.om-i.org/types/CustomAnnotation> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/Laterality> .

<https://openminds.om-i.org/props/preferredVisualization> a owl:ObjectProperty ;
    rdfs:label "Preferred visualization" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AtlasAnnotation> <https://openminds.om-i.org/types/CustomAnnotation> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/ViewerSpecification> .

<https://openminds.om-i.org/props/specification> a owl:ObjectProperty ;
    rdfs:label "Specification" ;
    rdfs:comment "Detailed and precise presentation of, or proposal for something." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AtlasAnnotation> <https://openminds.om-i.org/types/ContentType> <https://openminds.om-i.org/types/CustomAnnotation> <https://openminds.om-i.org/types/EphysStimulus> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Configuration> <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/FileBundle> <https://openminds.om-i.org/types/PropertyValueList> ) ] .

<https://openminds.om-i.org/props/type> a owl:ObjectProperty ;
    rdfs:label "Type" ;
    rdfs:comment "Distinct class to which a group of entities or concepts with similar characteristics or attributes belong to." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AtlasAnnotation> <https://openminds.om-i.org/types/BrainAtlasVersion> <https://openminds.om-i.org/types/ChemicalMixture> <https://openminds.om-i.org/types/Contribution> <https://openminds.om-i.org/types/CustomAnnotation> <https://openminds.om-i.org/types/EphysStimulus> <https://openminds.om-i.org/types/FileRepository> <https://openminds.om-i.org/types/LearningResource> <https://openminds.om-i.org/types/LivePaperSection> <https://openminds.om-i.org/types/MetaDataModelVersion> <https://openminds.om-i.org/types/Setup> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnnotationType> <https://openminds.om-i.org/types/AtlasType> <https://openminds.om-i.org/types/ChemicalMixtureType> <https://openminds.om-i.org/types/ContributionType> <https://openminds.om-i.org/types/ElectricalStimulusType> <https://openminds.om-i.org/types/FileRepositoryType> <https://openminds.om-i.org/types/LearningResourceType> <https://openminds.om-i.org/types/MetaDataModelType> <https://openminds.om-i.org/types/SetupType> <https://openminds.om-i.org/types/TissueSampleType> ) ] .

<https://openminds.om-i.org/types/AtlasAnnotation> a owl:Class ;
    rdfs:label "Atlas annotation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Laterality> ;
            owl:onProperty <https://openminds.om-i.org/props/laterality> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/File> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/specification> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/ProtocolExecution> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/criteria> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/CriteriaQualityType> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/criteriaQualityType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/QuantitativeValue> ;
            owl:onProperty <https://openminds.om-i.org/props/anchorPoint> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/File> ;
            owl:onProperty <https://openminds.om-i.org/props/inspiredBy> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/AnnotationCriteriaType> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/criteriaType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/ViewerSpecification> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/preferredVisualization> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/AnnotationType> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/type> ] .

