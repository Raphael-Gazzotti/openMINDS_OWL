<https://openminds.om-i.org/props/license> a owl:ObjectProperty ;
    rdfs:label "License" ;
    rdfs:comment "Grant by a party to another party as an element of an agreement between those parties that permits to do, use, or own something." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Book> <https://openminds.om-i.org/types/BrainAtlasVersion> <https://openminds.om-i.org/types/Chapter> <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/DatasetVersion> <https://openminds.om-i.org/types/LearningResource> <https://openminds.om-i.org/types/LivePaperVersion> <https://openminds.om-i.org/types/MetaDataModelVersion> <https://openminds.om-i.org/types/ModelVersion> <https://openminds.om-i.org/types/ScholarlyArticle> <https://openminds.om-i.org/types/SoftwareVersion> <https://openminds.om-i.org/types/ValidationTestVersion> <https://openminds.om-i.org/types/WorkflowRecipeVersion> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/License> <https://openminds.om-i.org/types/WebResource> ) ] .

