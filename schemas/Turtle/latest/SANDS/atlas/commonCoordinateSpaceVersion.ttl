<https://openminds.om-i.org/props/accessibility> a owl:ObjectProperty ;
    rdfs:label "Accessibility" ;
    rdfs:comment "Level to which something is accessible to someone or something." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/BrainAtlasVersion> <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/DatasetVersion> <https://openminds.om-i.org/types/LivePaperVersion> <https://openminds.om-i.org/types/MetaDataModelVersion> <https://openminds.om-i.org/types/ModelVersion> <https://openminds.om-i.org/types/SoftwareVersion> <https://openminds.om-i.org/types/ValidationTestVersion> <https://openminds.om-i.org/types/WebServiceVersion> <https://openminds.om-i.org/types/WorkflowRecipeVersion> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/ProductAccessibility> .

<https://openminds.om-i.org/props/anatomicalAxesOrientation> a owl:ObjectProperty ;
    rdfs:label "Anatomical axes orientation" ;
    rdfs:comment "Relation between reference planes used in anatomy and mathematics." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/CustomCoordinateSpace> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/AnatomicalAxesOrientation> .

<https://openminds.om-i.org/props/author> a owl:ObjectProperty ;
    rdfs:label "Author" ;
    rdfs:comment "Creator of a literary or creative work, as well as a dataset publication." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Book> <https://openminds.om-i.org/types/BrainAtlas> <https://openminds.om-i.org/types/BrainAtlasVersion> <https://openminds.om-i.org/types/Chapter> <https://openminds.om-i.org/types/CommonCoordinateSpace> <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/Dataset> <https://openminds.om-i.org/types/DatasetVersion> <https://openminds.om-i.org/types/LearningResource> <https://openminds.om-i.org/types/LivePaper> <https://openminds.om-i.org/types/LivePaperVersion> <https://openminds.om-i.org/types/ScholarlyArticle> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Consortium> <https://openminds.om-i.org/types/Organization> <https://openminds.om-i.org/types/Person> ) ] .

<https://openminds.om-i.org/props/axesOrigin> a owl:ObjectProperty ;
    rdfs:label "Axes origin" ;
    rdfs:comment "Special point in a coordinate system used as a fixed point of reference for the geometry of the surrounding space." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/CustomCoordinateSpace> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/QuantitativeValue> .

<https://openminds.om-i.org/props/copyright> a owl:ObjectProperty ;
    rdfs:label "Copyright" ;
    rdfs:comment "Exclusive and assignable legal right of an originator to reproduce, publish, sell, or distribute the matter and form of a creative work for a defined time period." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Book> <https://openminds.om-i.org/types/BrainAtlasVersion> <https://openminds.om-i.org/types/Chapter> <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/DatasetVersion> <https://openminds.om-i.org/types/LearningResource> <https://openminds.om-i.org/types/LivePaperVersion> <https://openminds.om-i.org/types/MetaDataModelVersion> <https://openminds.om-i.org/types/ModelVersion> <https://openminds.om-i.org/types/ScholarlyArticle> <https://openminds.om-i.org/types/SoftwareVersion> <https://openminds.om-i.org/types/ValidationTestVersion> <https://openminds.om-i.org/types/WebServiceVersion> <https://openminds.om-i.org/types/WorkflowRecipeVersion> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/Copyright> .

