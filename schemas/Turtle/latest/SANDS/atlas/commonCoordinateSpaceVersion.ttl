<https://openminds.om-i.org/props/usedSpecimen> a owl:ObjectProperty ;
    rdfs:label "Used specimen" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/BrainAtlasVersion> <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/ElectrodeArrayUsage> <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/PipetteUsage> <https://openminds.om-i.org/types/SlicingDeviceUsage> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> <https://openminds.om-i.org/types/TissueSampleState> ) ] .

<https://openminds.om-i.org/props/versionIdentifier> a owl:DatatypeProperty ;
    rdfs:label "Version identifier" ;
    rdfs:comment "Term or code used to identify the version of something." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Book> <https://openminds.om-i.org/types/BrainAtlasVersion> <https://openminds.om-i.org/types/Chapter> <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/DatasetVersion> <https://openminds.om-i.org/types/HardwareSystem> <https://openminds.om-i.org/types/LearningResource> <https://openminds.om-i.org/types/LivePaperVersion> <https://openminds.om-i.org/types/MetaDataModelVersion> <https://openminds.om-i.org/types/ModelVersion> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/ScholarlyArticle> <https://openminds.om-i.org/types/SoftwareVersion> <https://openminds.om-i.org/types/ValidationTestVersion> <https://openminds.om-i.org/types/WebServiceVersion> <https://openminds.om-i.org/types/WorkflowRecipeVersion> ) ] ;
