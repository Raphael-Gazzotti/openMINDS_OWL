    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/BrainAtlasVersion> <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/DatasetVersion> <https://openminds.om-i.org/types/LivePaperVersion> <https://openminds.om-i.org/types/MetaDataModelVersion> <https://openminds.om-i.org/types/ModelVersion> <https://openminds.om-i.org/types/SoftwareVersion> <https://openminds.om-i.org/types/ValidationTestVersion> <https://openminds.om-i.org/types/WebServiceVersion> <https://openminds.om-i.org/types/WorkflowRecipeVersion> ) ] ;
