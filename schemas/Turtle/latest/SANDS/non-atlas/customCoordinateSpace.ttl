@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/anatomicalAxesOrientation> a owl:ObjectProperty ;
    rdfs:label "Anatomical axes orientation" ;
    rdfs:comment "Relation between reference planes used in anatomy and mathematics." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/CustomCoordinateSpace> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/AnatomicalAxesOrientation> .

<https://openminds.om-i.org/props/axesOrigin> a owl:ObjectProperty ;
    rdfs:label "Axes origin" ;
    rdfs:comment "Special point in a coordinate system used as a fixed point of reference for the geometry of the surrounding space." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/CustomCoordinateSpace> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/QuantitativeValue> .

<https://openminds.om-i.org/props/defaultImage> a owl:ObjectProperty ;
    rdfs:label "Default image" ;
    rdfs:comment "Two or three dimensional image that particluarly represents a specific coordinate space." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/CustomCoordinateSpace> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/File> .

<https://openminds.om-i.org/props/name> a owl:DatatypeProperty ;
    rdfs:label "Name" ;
    rdfs:comment "Word or phrase that constitutes the distinctive designation of a being or thing." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/ActionStatusType> <https://openminds.om-i.org/types/AgeCategory> <https://openminds.om-i.org/types/AnalysisTechnique> <https://openminds.om-i.org/types/AnatomicalAxesOrientation> <https://openminds.om-i.org/types/AnatomicalIdentificationType> <https://openminds.om-i.org/types/AnatomicalPlane> <https://openminds.om-i.org/types/AnnotationCriteriaType> <https://openminds.om-i.org/types/AnnotationType> <https://openminds.om-i.org/types/AtlasType> <https://openminds.om-i.org/types/AuditoryStimulusType> <https://openminds.om-i.org/types/BehavioralProtocol> <https://openminds.om-i.org/types/BiologicalOrder> <https://openminds.om-i.org/types/BiologicalProcess> <https://openminds.om-i.org/types/BiologicalSex> <https://openminds.om-i.org/types/Book> <https://openminds.om-i.org/types/BreedingType> <https://openminds.om-i.org/types/CellCultureType> <https://openminds.om-i.org/types/CellType> <https://openminds.om-i.org/types/Chapter> <https://openminds.om-i.org/types/ChemicalMixture> <https://openminds.om-i.org/types/ChemicalMixtureType> <https://openminds.om-i.org/types/Colormap> <https://openminds.om-i.org/types/ContentType> <https://openminds.om-i.org/types/ContributionType> <https://openminds.om-i.org/types/CranialWindowConstructionType> <https://openminds.om-i.org/types/CranialWindowReinforcementType> <https://openminds.om-i.org/types/CriteriaQualityType> <https://openminds.om-i.org/types/CustomAnatomicalEntity> <https://openminds.om-i.org/types/CustomCoordinateSpace> <https://openminds.om-i.org/types/DataType> <https://openminds.om-i.org/types/DeviceType> <https://openminds.om-i.org/types/DifferenceMeasure> <https://openminds.om-i.org/types/Disease> <https://openminds.om-i.org/types/DiseaseModel> <https://openminds.om-i.org/types/EducationalLevel> <https://openminds.om-i.org/types/ElectricalStimulusType> <https://openminds.om-i.org/types/Electrode> <https://openminds.om-i.org/types/ElectrodeArray> <https://openminds.om-i.org/types/Environment> <https://openminds.om-i.org/types/EthicsAssessment> <https://openminds.om-i.org/types/ExperimentalApproach> <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/FileBundle> <https://openminds.om-i.org/types/FileBundleGrouping> <https://openminds.om-i.org/types/FileRepository> <https://openminds.om-i.org/types/FileRepositoryType> <https://openminds.om-i.org/types/FileUsageRole> <https://openminds.om-i.org/types/GeneticStrainType> <https://openminds.om-i.org/types/GustatoryStimulusType> <https://openminds.om-i.org/types/Handedness> <https://openminds.om-i.org/types/HardwareSystem> <https://openminds.om-i.org/types/Language> <https://openminds.om-i.org/types/Laterality> <https://openminds.om-i.org/types/LaunchConfiguration> <https://openminds.om-i.org/types/LearningResource> <https://openminds.om-i.org/types/LearningResourceType> <https://openminds.om-i.org/types/LivePaperResourceItem> <https://openminds.om-i.org/types/LivePaperSection> <https://openminds.om-i.org/types/LocalFile> <https://openminds.om-i.org/types/MRAcquisitionType> <https://openminds.om-i.org/types/MRIPulseSequence> <https://openminds.om-i.org/types/MRIWeighting> <https://openminds.om-i.org/types/MeasuredQuantity> <https://openminds.om-i.org/types/MeasuredSignalType> <https://openminds.om-i.org/types/MetaDataModelType> <https://openminds.om-i.org/types/ModelAbstractionLevel> <https://openminds.om-i.org/types/ModelScope> <https://openminds.om-i.org/types/MolecularEntity> <https://openminds.om-i.org/types/NumericalProperty> <https://openminds.om-i.org/types/OlfactoryStimulusType> <https://openminds.om-i.org/types/OperatingDevice> <https://openminds.om-i.org/types/OperatingSystem> <https://openminds.om-i.org/types/OpticalStimulusType> <https://openminds.om-i.org/types/Organ> <https://openminds.om-i.org/types/OrganismSubstance> <https://openminds.om-i.org/types/OrganismSystem> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/PatchClampVariation> <https://openminds.om-i.org/types/Periodical> <https://openminds.om-i.org/types/Pipette> <https://openminds.om-i.org/types/PreparationType> <https://openminds.om-i.org/types/ProductAccessibility> <https://openminds.om-i.org/types/ProgrammingLanguage> <https://openminds.om-i.org/types/Protocol> <https://openminds.om-i.org/types/QualitativeOverlap> <https://openminds.om-i.org/types/Recording> <https://openminds.om-i.org/types/ScholarlyArticle> <https://openminds.om-i.org/types/SemanticDataType> <https://openminds.om-i.org/types/Service> <https://openminds.om-i.org/types/Setup> <https://openminds.om-i.org/types/SetupType> <https://openminds.om-i.org/types/SlicingDevice> <https://openminds.om-i.org/types/SoftwareAgent> <https://openminds.om-i.org/types/SoftwareApplicationCategory> <https://openminds.om-i.org/types/SoftwareFeature> <https://openminds.om-i.org/types/Species> <https://openminds.om-i.org/types/StimulationApproach> <https://openminds.om-i.org/types/StimulationTechnique> <https://openminds.om-i.org/types/Strain> <https://openminds.om-i.org/types/StringProperty> <https://openminds.om-i.org/types/SubcellularEntity> <https://openminds.om-i.org/types/SubjectAttribute> <https://openminds.om-i.org/types/TactileStimulusType> <https://openminds.om-i.org/types/Technique> <https://openminds.om-i.org/types/TermSuggestion> <https://openminds.om-i.org/types/Terminology> <https://openminds.om-i.org/types/TissueSampleAttribute> <https://openminds.om-i.org/types/TissueSampleType> <https://openminds.om-i.org/types/TypeOfUncertainty> <https://openminds.om-i.org/types/UBERONParcellation> <https://openminds.om-i.org/types/UnitOfMeasurement> <https://openminds.om-i.org/types/VisualStimulusType> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/nativeUnit> a owl:ObjectProperty ;
    rdfs:label "Native unit" ;
    rdfs:comment "Determinate quantity used in the original measurement." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/CustomCoordinateSpace> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/UnitOfMeasurement> .

<https://openminds.om-i.org/types/CustomCoordinateSpace> a owl:Class ;
    rdfs:label "Custom coordinate space" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/UnitOfMeasurement> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/nativeUnit> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/File> ;
            owl:onProperty <https://openminds.om-i.org/props/defaultImage> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/QuantitativeValue> ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/axesOrigin> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/AnatomicalAxesOrientation> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/anatomicalAxesOrientation> ] .

