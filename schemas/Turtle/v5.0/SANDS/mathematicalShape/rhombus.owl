@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/diagonalLengths> a owl:ObjectProperty ;
    rdfs:label "Diagonal lengths" ;
    rdfs:domain <https://openminds.om-i.org/types/Rhombus> ;
    rdfs:range <https://openminds.om-i.org/types/QuantitativeValue> .

<https://openminds.om-i.org/types/Rhombus> a owl:Class ;
    rdfs:label "Rhombus" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/QuantitativeValue> ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/diagonalLengths> ] .

