@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/authoringParty> a owl:ObjectProperty ;
    rdfs:label "Authoring party" ;
    rdfs:domain <https://openminds.om-i.org/types/UsageAgreement> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Organization> <https://openminds.om-i.org/types/Person> ) ] .

<https://openminds.om-i.org/props/fullName> a owl:DatatypeProperty ;
    rdfs:label "Full name" ;
    rdfs:comment "Whole, non-abbreviated name of something or somebody." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalAtlas> <https://openminds.om-i.org/types/AnatomicalAtlasVersion> <https://openminds.om-i.org/types/CommonCoordinateFramework> <https://openminds.om-i.org/types/CommonCoordinateFrameworkVersion> <https://openminds.om-i.org/types/Consortium> <https://openminds.om-i.org/types/Dataset> <https://openminds.om-i.org/types/DatasetVersion> <https://openminds.om-i.org/types/Interface> <https://openminds.om-i.org/types/InterfaceVersion> <https://openminds.om-i.org/types/License> <https://openminds.om-i.org/types/LivePaper> <https://openminds.om-i.org/types/LivePaperVersion> <https://openminds.om-i.org/types/MetaDataModel> <https://openminds.om-i.org/types/MetaDataModelVersion> <https://openminds.om-i.org/types/Model> <https://openminds.om-i.org/types/ModelVersion> <https://openminds.om-i.org/types/Project> <https://openminds.om-i.org/types/Service> <https://openminds.om-i.org/types/Software> <https://openminds.om-i.org/types/SoftwareVersion> <https://openminds.om-i.org/types/UsageAgreement> <https://openminds.om-i.org/types/ValidationTest> <https://openminds.om-i.org/types/ValidationTestVersion> <https://openminds.om-i.org/types/WorkflowRecipe> <https://openminds.om-i.org/types/WorkflowRecipeVersion> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/jurisdiction> a owl:ObjectProperty ;
    rdfs:label "Jurisdiction" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Organization> <https://openminds.om-i.org/types/UsageAgreement> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/SovereignState> <https://openminds.om-i.org/types/SupranationalBody> ) ] .

<https://openminds.om-i.org/props/modificationProfile> a owl:ObjectProperty ;
    rdfs:label "Modification profile" ;
    rdfs:domain <https://openminds.om-i.org/types/UsageAgreement> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/ModificationConsentRequirement> <https://openminds.om-i.org/types/ModificationConstraint> <https://openminds.om-i.org/types/ModificationForm> <https://openminds.om-i.org/types/ModificationScope> ) ] .

<https://openminds.om-i.org/props/shortName> a owl:DatatypeProperty ;
    rdfs:label "Short name" ;
    rdfs:comment "Shortened or fully abbreviated name of something or somebody." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalAtlas> <https://openminds.om-i.org/types/AnatomicalAtlasVersion> <https://openminds.om-i.org/types/CommonCoordinateFramework> <https://openminds.om-i.org/types/CommonCoordinateFrameworkVersion> <https://openminds.om-i.org/types/Consortium> <https://openminds.om-i.org/types/Dataset> <https://openminds.om-i.org/types/DatasetVersion> <https://openminds.om-i.org/types/Interface> <https://openminds.om-i.org/types/InterfaceVersion> <https://openminds.om-i.org/types/License> <https://openminds.om-i.org/types/LivePaper> <https://openminds.om-i.org/types/LivePaperVersion> <https://openminds.om-i.org/types/MetaDataModel> <https://openminds.om-i.org/types/MetaDataModelVersion> <https://openminds.om-i.org/types/Model> <https://openminds.om-i.org/types/ModelVersion> <https://openminds.om-i.org/types/Project> <https://openminds.om-i.org/types/Service> <https://openminds.om-i.org/types/Software> <https://openminds.om-i.org/types/SoftwareVersion> <https://openminds.om-i.org/types/UsageAgreement> <https://openminds.om-i.org/types/ValidationTest> <https://openminds.om-i.org/types/ValidationTestVersion> <https://openminds.om-i.org/types/WorkflowRecipe> <https://openminds.om-i.org/types/WorkflowRecipeVersion> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/source> a owl:ObjectProperty ;
    rdfs:label "Source" ;
    rdfs:domain <https://openminds.om-i.org/types/UsageAgreement> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/License> <https://openminds.om-i.org/types/UsageAgreement> ) ] .

<https://openminds.om-i.org/props/supportChannel> a owl:DatatypeProperty ;
    rdfs:label "Support channel" ;
    rdfs:comment "Way of communication used to interact with users or customers." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalAtlas> <https://openminds.om-i.org/types/AnatomicalAtlasVersion> <https://openminds.om-i.org/types/CommonCoordinateFramework> <https://openminds.om-i.org/types/CommonCoordinateFrameworkVersion> <https://openminds.om-i.org/types/Dataset> <https://openminds.om-i.org/types/DatasetVersion> <https://openminds.om-i.org/types/Interface> <https://openminds.om-i.org/types/InterfaceVersion> <https://openminds.om-i.org/types/LivePaper> <https://openminds.om-i.org/types/LivePaperVersion> <https://openminds.om-i.org/types/MetaDataModel> <https://openminds.om-i.org/types/MetaDataModelVersion> <https://openminds.om-i.org/types/Model> <https://openminds.om-i.org/types/ModelVersion> <https://openminds.om-i.org/types/Service> <https://openminds.om-i.org/types/Software> <https://openminds.om-i.org/types/SoftwareVersion> <https://openminds.om-i.org/types/UsageAgreement> <https://openminds.om-i.org/types/ValidationTest> <https://openminds.om-i.org/types/ValidationTestVersion> <https://openminds.om-i.org/types/WorkflowRecipe> <https://openminds.om-i.org/types/WorkflowRecipeVersion> ) ] ;
    rdfs:range rdf:List .

<https://openminds.om-i.org/props/template> a owl:ObjectProperty ;
    rdfs:label "Template" ;
    rdfs:domain <https://openminds.om-i.org/types/UsageAgreement> ;
    rdfs:range <https://openminds.om-i.org/types/WebResource> .

<https://openminds.om-i.org/types/UsageAgreement> a owl:Class ;
    rdfs:label "Usage agreement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/supportChannel> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/shortName> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/fullName> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/SovereignState> <https://openminds.om-i.org/types/SupranationalBody> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/jurisdiction> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/License> <https://openminds.om-i.org/types/UsageAgreement> ) ] ;
            owl:onProperty <https://openminds.om-i.org/props/source> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/Organization> <https://openminds.om-i.org/types/Person> ) ] ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/authoringParty> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/ModificationConsentRequirement> <https://openminds.om-i.org/types/ModificationConstraint> <https://openminds.om-i.org/types/ModificationForm> <https://openminds.om-i.org/types/ModificationScope> ) ] ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/modificationProfile> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/WebResource> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/template> ] .

