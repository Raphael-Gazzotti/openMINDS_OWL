@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/address> a owl:DatatypeProperty ;
    rdfs:label "Address" ;
    rdfs:domain <https://openminds.om-i.org/types/Location> ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/country> a owl:ObjectProperty ;
    rdfs:label "Country" ;
    rdfs:domain <https://openminds.om-i.org/types/Location> ;
    rdfs:range <https://openminds.om-i.org/types/SovereignState> .

<https://openminds.om-i.org/props/geoCoordinates> a owl:ObjectProperty ;
    rdfs:label "Geo coordinates" ;
    rdfs:domain <https://openminds.om-i.org/types/Location> ;
    rdfs:range <https://openminds.om-i.org/types/GeoCoordinates> .

<https://openminds.om-i.org/types/Location> a owl:Class ;
    rdfs:label "Location" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/SovereignState> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/country> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/GeoCoordinates> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/geoCoordinates> ] .

