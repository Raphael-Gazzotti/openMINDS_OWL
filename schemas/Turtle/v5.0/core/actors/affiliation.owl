@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/organization> a owl:ObjectProperty ;
    rdfs:label "Organization" ;
    rdfs:comment "Legally accountable, administrative and functional structure." ;
    rdfs:domain <https://openminds.om-i.org/types/Affiliation> ;
    rdfs:range <https://openminds.om-i.org/types/Organization> .

<https://openminds.om-i.org/props/person> a owl:ObjectProperty ;
    rdfs:label "Person" ;
    rdfs:domain <https://openminds.om-i.org/types/Affiliation> ;
    rdfs:range <https://openminds.om-i.org/types/Person> .

<https://openminds.om-i.org/types/Affiliation> a owl:Class ;
    rdfs:label "Affiliation" ;
    rdfs:comment "Structured information about a relationship between two entities, such as a person and their employer." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Organization> ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/organization> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Person> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/person> ] .

