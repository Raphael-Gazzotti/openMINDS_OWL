@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/types/ContactInformation> a owl:Class ;
    rdfs:label "Contact information" ;
    rdfs:comment "Structured information about how to contact a given person or consortium." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/email> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/email> ] .

<https://openminds.om-i.org/props/email> a owl:DatatypeProperty ;
    rdfs:label "Email" ;
    rdfs:comment "Address to which or from which an electronic mail can be sent." ;
    rdfs:domain <https://openminds.om-i.org/types/ContactInformation> ;
    rdfs:range rdf:List .

