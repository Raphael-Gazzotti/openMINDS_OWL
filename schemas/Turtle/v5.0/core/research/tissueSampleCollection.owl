@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/additionalRemarks> a owl:DatatypeProperty ;
    rdfs:label "Additional remarks" ;
    rdfs:comment "Mention of what deserves additional attention or notice." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalTargetPosition> <https://openminds.om-i.org/types/ChemicalMixture> <https://openminds.om-i.org/types/ChemicalSubstance> <https://openminds.om-i.org/types/GridImage> <https://openminds.om-i.org/types/GridImageStack> <https://openminds.om-i.org/types/GridVolume> <https://openminds.om-i.org/types/GridVolumeSequence> <https://openminds.om-i.org/types/Measurement> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/SubjectGroupState> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueSampleCollection> <https://openminds.om-i.org/types/TissueSampleCollectionState> <https://openminds.om-i.org/types/TissueSampleState> <https://openminds.om-i.org/types/ViewerSpecification> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/internalIdentifier> a owl:DatatypeProperty ;
    rdfs:label "Internal identifier" ;
    rdfs:comment "Term or code that identifies someone or something within a particular product." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AtlasAnnotation> <https://openminds.om-i.org/types/BehavioralProtocol> <https://openminds.om-i.org/types/CustomAnnotation> <https://openminds.om-i.org/types/Electrode> <https://openminds.om-i.org/types/ElectrodeArray> <https://openminds.om-i.org/types/EphysStimulus> <https://openminds.om-i.org/types/MRICoil> <https://openminds.om-i.org/types/MRIScanner> <https://openminds.om-i.org/types/Pipette> <https://openminds.om-i.org/types/RecordingActivity> <https://openminds.om-i.org/types/SlicingDevice> <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/SubjectGroupState> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> <https://openminds.om-i.org/types/TissueSampleCollectionState> <https://openminds.om-i.org/types/TissueSampleState> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/lookupLabel> a owl:DatatypeProperty ;
    rdfs:label "Lookup label" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CellPatching> <https://openminds.om-i.org/types/ChemicalSubstance> <https://openminds.om-i.org/types/Configuration> <https://openminds.om-i.org/types/ContentTypePattern> <https://openminds.om-i.org/types/CranialWindowPreparation> <https://openminds.om-i.org/types/DataAnalysis> <https://openminds.om-i.org/types/DataCopy> <https://openminds.om-i.org/types/DynamicMRIAcquisition> <https://openminds.om-i.org/types/ElectrodeArrayUsage> <https://openminds.om-i.org/types/ElectrodePlacement> <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/EphysStimulus> <https://openminds.om-i.org/types/FileRepositoryStructure> <https://openminds.om-i.org/types/GenericComputation> <https://openminds.om-i.org/types/MRICoilUsage> <https://openminds.om-i.org/types/MRIScannerUsage> <https://openminds.om-i.org/types/ModelValidation> <https://openminds.om-i.org/types/Optimization> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/PipetteUsage> <https://openminds.om-i.org/types/PropertyValueList> <https://openminds.om-i.org/types/ProtocolExecution> <https://openminds.om-i.org/types/RecordingActivity> <https://openminds.om-i.org/types/Simulation> <https://openminds.om-i.org/types/SlicingDeviceUsage> <https://openminds.om-i.org/types/StaticMRIAcquisition> <https://openminds.om-i.org/types/StimulationActivity> <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/SubjectGroupState> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueCulturePreparation> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> <https://openminds.om-i.org/types/TissueSampleCollectionState> <https://openminds.om-i.org/types/TissueSampleSlicing> <https://openminds.om-i.org/types/TissueSampleState> <https://openminds.om-i.org/types/Visualization> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/numberOfTissueSamples> rdfs:label "Number of tissue samples" ;
    rdfs:domain <https://openminds.om-i.org/types/TissueSampleCollection> .

<https://openminds.om-i.org/props/anatomicalLocation> a owl:ObjectProperty ;
    rdfs:label "Anatomical location" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/PipetteUsage> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalCavity> <https://openminds.om-i.org/types/CellType> <https://openminds.om-i.org/types/CustomAnatomicalEntity> <https://openminds.om-i.org/types/ExternalBodyRegion> <https://openminds.om-i.org/types/MuscularStructure> <https://openminds.om-i.org/types/NervousSystemStructure> <https://openminds.om-i.org/types/Organ> <https://openminds.om-i.org/types/OrganSystemStructure> <https://openminds.om-i.org/types/OrganismSubstance> <https://openminds.om-i.org/types/OrganismSystem> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/SkeletalStructure> <https://openminds.om-i.org/types/SubcellularEntity> <https://openminds.om-i.org/types/TissueStructure> <https://openminds.om-i.org/types/VascularStructure> ) ] .

<https://openminds.om-i.org/props/biologicalSex> a owl:ObjectProperty ;
    rdfs:label "Biological sex" ;
    rdfs:comment "Differentiation of individuals of most species (animals and plants) based on the type of gametes they produce." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/BiologicalSex> .

<https://openminds.om-i.org/props/isPartOf> a owl:ObjectProperty ;
    rdfs:label "Is part of" ;
    rdfs:comment "Reference to the ensemble of multiple things or beings." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CellPatching> <https://openminds.om-i.org/types/Chapter> <https://openminds.om-i.org/types/CranialWindowPreparation> <https://openminds.om-i.org/types/DynamicMRIAcquisition> <https://openminds.om-i.org/types/ElectrodePlacement> <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/FileBundle> <https://openminds.om-i.org/types/LivePaperResourceItem> <https://openminds.om-i.org/types/LivePaperSection> <https://openminds.om-i.org/types/ProtocolExecution> <https://openminds.om-i.org/types/PublicationIssue> <https://openminds.om-i.org/types/PublicationVolume> <https://openminds.om-i.org/types/RecordingActivity> <https://openminds.om-i.org/types/ScholarlyArticle> <https://openminds.om-i.org/types/StaticMRIAcquisition> <https://openminds.om-i.org/types/StimulationActivity> <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/TissueCulturePreparation> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> <https://openminds.om-i.org/types/TissueSampleSlicing> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Book> <https://openminds.om-i.org/types/DatasetVersion> <https://openminds.om-i.org/types/FileBundle> <https://openminds.om-i.org/types/FileRepository> <https://openminds.om-i.org/types/LivePaperSection> <https://openminds.om-i.org/types/LivePaperVersion> <https://openminds.om-i.org/types/Periodical> <https://openminds.om-i.org/types/PublicationIssue> <https://openminds.om-i.org/types/PublicationVolume> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/TissueSampleCollection> ) ] .

<https://openminds.om-i.org/props/laterality> a owl:ObjectProperty ;
    rdfs:label "Laterality" ;
    rdfs:comment "Differentiation between a pair of lateral homologous parts of the body." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AtlasAnnotation> <https://openminds.om-i.org/types/CustomAnnotation> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/Laterality> .

<https://openminds.om-i.org/props/origin> a owl:ObjectProperty ;
    rdfs:label "Origin" ;
    rdfs:comment "Source at which something begins or rises, or from which something derives." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CellType> <https://openminds.om-i.org/types/Organ> <https://openminds.om-i.org/types/OrganismSubstance> ) ] .

<https://openminds.om-i.org/props/species> a owl:ObjectProperty ;
    rdfs:label "Species" ;
    rdfs:comment "Category of biological classification comprising related organisms or populations potentially capable of interbreeding, and being designated by a binomial that consists of the name of a genus followed by a Latin or latinized uncapitalized noun or adjective." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Strain> <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Species> <https://openminds.om-i.org/types/Strain> ) ] .

<https://openminds.om-i.org/props/studiedState> a owl:ObjectProperty ;
    rdfs:label "Studied state" ;
    rdfs:comment "Reference to a point in time at which something or someone was studied in a particular mode or condition." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/SubjectGroupState> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueSampleCollectionState> <https://openminds.om-i.org/types/TissueSampleState> ) ] .

<https://openminds.om-i.org/props/type> a owl:ObjectProperty ;
    rdfs:label "Type" ;
    rdfs:comment "Distinct class to which a group of entities or concepts with similar characteristics or attributes belong to." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalAtlasVersion> <https://openminds.om-i.org/types/AtlasAnnotation> <https://openminds.om-i.org/types/ChemicalMixture> <https://openminds.om-i.org/types/Contribution> <https://openminds.om-i.org/types/CustomAnnotation> <https://openminds.om-i.org/types/Electrode> <https://openminds.om-i.org/types/ElectrodeArray> <https://openminds.om-i.org/types/EphysStimulus> <https://openminds.om-i.org/types/FileRepository> <https://openminds.om-i.org/types/GenericIdentifier> <https://openminds.om-i.org/types/HardwareProduct> <https://openminds.om-i.org/types/LearningResource> <https://openminds.om-i.org/types/LivePaperSection> <https://openminds.om-i.org/types/MRICoil> <https://openminds.om-i.org/types/MRIScanner> <https://openminds.om-i.org/types/MetaDataModelVersion> <https://openminds.om-i.org/types/Organization> <https://openminds.om-i.org/types/Pipette> <https://openminds.om-i.org/types/Project> <https://openminds.om-i.org/types/Setup> <https://openminds.om-i.org/types/SlicingDevice> <https://openminds.om-i.org/types/SpecimenWeight> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnnotationType> <https://openminds.om-i.org/types/AtlasType> <https://openminds.om-i.org/types/ChemicalMixtureType> <https://openminds.om-i.org/types/ContributionType> <https://openminds.om-i.org/types/DeviceType> <https://openminds.om-i.org/types/ElectricalStimulusType> <https://openminds.om-i.org/types/FileRepositoryType> <https://openminds.om-i.org/types/HardwareProduct> <https://openminds.om-i.org/types/LearningResourceType> <https://openminds.om-i.org/types/MetaDataModelType> <https://openminds.om-i.org/types/OrganizationType> <https://openminds.om-i.org/types/ProjectType> <https://openminds.om-i.org/types/SetupType> <https://openminds.om-i.org/types/TissueSampleType> <https://openminds.om-i.org/types/WeightType> ) ] .

<https://openminds.om-i.org/types/TissueSampleCollection> a owl:Class ;
    rdfs:label "Tissue sample collection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Laterality> ;
            owl:onProperty <https://openminds.om-i.org/props/laterality> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/TissueSampleCollection> ;
            owl:onProperty <https://openminds.om-i.org/props/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/BiologicalSex> ;
            owl:onProperty <https://openminds.om-i.org/props/biologicalSex> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/CellType> <https://openminds.om-i.org/types/Organ> <https://openminds.om-i.org/types/OrganismSubstance> ) ] ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/origin> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/TissueSampleType> ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/type> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/TissueSampleCollectionState> ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/studiedState> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/Species> <https://openminds.om-i.org/types/Strain> ) ] ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/species> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalCavity> <https://openminds.om-i.org/types/CellType> <https://openminds.om-i.org/types/ExternalBodyRegion> <https://openminds.om-i.org/types/MuscularStructure> <https://openminds.om-i.org/types/NervousSystemStructure> <https://openminds.om-i.org/types/Organ> <https://openminds.om-i.org/types/OrganSystemStructure> <https://openminds.om-i.org/types/OrganismSubstance> <https://openminds.om-i.org/types/OrganismSystem> <https://openminds.om-i.org/types/SkeletalStructure> <https://openminds.om-i.org/types/SubcellularEntity> <https://openminds.om-i.org/types/TissueStructure> <https://openminds.om-i.org/types/VascularStructure> <https://openminds.om-i.org/types/CustomAnatomicalEntity> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> ) ] ;
            owl:onProperty <https://openminds.om-i.org/props/anatomicalLocation> ] .

