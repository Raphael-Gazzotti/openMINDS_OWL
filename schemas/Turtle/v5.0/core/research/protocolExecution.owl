            owl:unionOf ( <https://openminds.om-i.org/types/Person> <https://openminds.om-i.org/types/SoftwareAgent> ) ] .

<https://openminds.om-i.org/props/preparationDesign> a owl:ObjectProperty ;
    rdfs:label "Preparation design" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CellPatching> <https://openminds.om-i.org/types/CranialWindowPreparation> <https://openminds.om-i.org/types/DynamicMRIAcquisition> <https://openminds.om-i.org/types/ElectrodePlacement> <https://openminds.om-i.org/types/ProtocolExecution> <https://openminds.om-i.org/types/RecordingActivity> <https://openminds.om-i.org/types/StaticMRIAcquisition> <https://openminds.om-i.org/types/StimulationActivity> <https://openminds.om-i.org/types/TissueCulturePreparation> <https://openminds.om-i.org/types/TissueSampleSlicing> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/PreparationType> .

<https://openminds.om-i.org/props/protocol> a owl:ObjectProperty ;
    rdfs:label "Protocol" ;
    rdfs:comment "Plan that describes the process of a scientific or medical experiment, treatment, or procedure." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CellPatching> <https://openminds.om-i.org/types/CranialWindowPreparation> <https://openminds.om-i.org/types/DatasetVersion> <https://openminds.om-i.org/types/DynamicMRIAcquisition> <https://openminds.om-i.org/types/ElectrodePlacement> <https://openminds.om-i.org/types/ProtocolExecution> <https://openminds.om-i.org/types/RecordingActivity> <https://openminds.om-i.org/types/StaticMRIAcquisition> <https://openminds.om-i.org/types/StimulationActivity> <https://openminds.om-i.org/types/TissueCulturePreparation> <https://openminds.om-i.org/types/TissueSampleSlicing> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/BehavioralProtocol> <https://openminds.om-i.org/types/Protocol> ) ] .

<https://openminds.om-i.org/props/studyTarget> a owl:ObjectProperty ;
    rdfs:label "Study target" ;
    rdfs:comment "Structure or function that was targeted within a study." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CellPatching> <https://openminds.om-i.org/types/CranialWindowPreparation> <https://openminds.om-i.org/types/DataAnalysis> <https://openminds.om-i.org/types/DataCopy> <https://openminds.om-i.org/types/DatasetVersion> <https://openminds.om-i.org/types/DynamicMRIAcquisition> <https://openminds.om-i.org/types/ElectrodePlacement> <https://openminds.om-i.org/types/GenericComputation> <https://openminds.om-i.org/types/Model> <https://openminds.om-i.org/types/ModelValidation> <https://openminds.om-i.org/types/Optimization> <https://openminds.om-i.org/types/ProtocolExecution> <https://openminds.om-i.org/types/RecordingActivity> <https://openminds.om-i.org/types/Simulation> <https://openminds.om-i.org/types/StaticMRIAcquisition> <https://openminds.om-i.org/types/StimulationActivity> <https://openminds.om-i.org/types/TissueCulturePreparation> <https://openminds.om-i.org/types/TissueSampleSlicing> <https://openminds.om-i.org/types/ValidationTest> <https://openminds.om-i.org/types/Visualization> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalCavity> <https://openminds.om-i.org/types/AuditoryStimulusType> <https://openminds.om-i.org/types/BiologicalOrder> <https://openminds.om-i.org/types/BiologicalSex> <https://openminds.om-i.org/types/BreedingType> <https://openminds.om-i.org/types/CellCultureType> <https://openminds.om-i.org/types/CellType> <https://openminds.om-i.org/types/CustomAnatomicalEntity> <https://openminds.om-i.org/types/DeviceType> <https://openminds.om-i.org/types/Disease> <https://openminds.om-i.org/types/DiseaseModel> <https://openminds.om-i.org/types/ElectricalStimulusType> <https://openminds.om-i.org/types/ExternalBodyRegion> <https://openminds.om-i.org/types/GeneticStrainType> <https://openminds.om-i.org/types/GustatoryStimulusType> <https://openminds.om-i.org/types/Handedness> <https://openminds.om-i.org/types/MolecularEntity> <https://openminds.om-i.org/types/MuscularStructure> <https://openminds.om-i.org/types/NervousSystemStructure> <https://openminds.om-i.org/types/OlfactoryStimulusType> <https://openminds.om-i.org/types/OpticalStimulusType> <https://openminds.om-i.org/types/Organ> <https://openminds.om-i.org/types/OrganSystemStructure> <https://openminds.om-i.org/types/OrganismSubstance> <https://openminds.om-i.org/types/OrganismSystem> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/SkeletalStructure> <https://openminds.om-i.org/types/Species> <https://openminds.om-i.org/types/SubcellularEntity> <https://openminds.om-i.org/types/TactileStimulusType> <https://openminds.om-i.org/types/TermSuggestion> <https://openminds.om-i.org/types/TissueSampleType> <https://openminds.om-i.org/types/TissueStructure> <https://openminds.om-i.org/types/VascularStructure> <https://openminds.om-i.org/types/VisualStimulusType> ) ] .

<https://openminds.om-i.org/types/ProtocolExecution> a owl:Class ;
    rdfs:label "Protocol execution" ;
    rdfs:comment "Structured information on a protocol execution." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/PreparationType> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/preparationDesign> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/FileBundle> <https://openminds.om-i.org/types/SubjectGroupState> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueSampleCollectionState> <https://openminds.om-i.org/types/TissueSampleState> ) ] ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/output> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/SoftwareAgent> <https://openminds.om-i.org/types/Person> ) ] ;
            owl:onProperty <https://openminds.om-i.org/props/performedBy> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/CustomPropertySet> ;
            owl:onProperty <https://openminds.om-i.org/props/customPropertySet> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/FileBundle> <https://openminds.om-i.org/types/SubjectGroupState> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueSampleCollectionState> <https://openminds.om-i.org/types/TissueSampleState> <https://openminds.om-i.org/types/AnatomicalAtlasVersion> <https://openminds.om-i.org/types/CommonCoordinateFrameworkVersion> ) ] ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/input> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/BehavioralProtocol> ;
            owl:onProperty <https://openminds.om-i.org/props/behavioralProtocol> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/DatasetVersion> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalCavity> <https://openminds.om-i.org/types/AuditoryStimulusType> <https://openminds.om-i.org/types/BiologicalOrder> <https://openminds.om-i.org/types/BiologicalSex> <https://openminds.om-i.org/types/BreedingType> <https://openminds.om-i.org/types/CellCultureType> <https://openminds.om-i.org/types/CellType> <https://openminds.om-i.org/types/DeviceType> <https://openminds.om-i.org/types/Disease> <https://openminds.om-i.org/types/DiseaseModel> <https://openminds.om-i.org/types/ElectricalStimulusType> <https://openminds.om-i.org/types/ExternalBodyRegion> <https://openminds.om-i.org/types/GeneticStrainType> <https://openminds.om-i.org/types/GustatoryStimulusType> <https://openminds.om-i.org/types/Handedness> <https://openminds.om-i.org/types/MolecularEntity> <https://openminds.om-i.org/types/MuscularStructure> <https://openminds.om-i.org/types/NervousSystemStructure> <https://openminds.om-i.org/types/OlfactoryStimulusType> <https://openminds.om-i.org/types/OpticalStimulusType> <https://openminds.om-i.org/types/Organ> <https://openminds.om-i.org/types/OrganSystemStructure> <https://openminds.om-i.org/types/OrganismSubstance> <https://openminds.om-i.org/types/OrganismSystem> <https://openminds.om-i.org/types/SkeletalStructure> <https://openminds.om-i.org/types/Species> <https://openminds.om-i.org/types/SubcellularEntity> <https://openminds.om-i.org/types/TactileStimulusType> <https://openminds.om-i.org/types/TermSuggestion> <https://openminds.om-i.org/types/TissueSampleType> <https://openminds.om-i.org/types/TissueStructure> <https://openminds.om-i.org/types/VascularStructure> <https://openminds.om-i.org/types/VisualStimulusType> <https://openminds.om-i.org/types/CustomAnatomicalEntity> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> ) ] ;
            owl:onProperty <https://openminds.om-i.org/props/studyTarget> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Protocol> ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/protocol> ] .

