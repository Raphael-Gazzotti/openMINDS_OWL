@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/coordinator> a owl:ObjectProperty ;
    rdfs:label "Coordinator" ;
    rdfs:comment "Legal person who organizes the collaborative work of people or groups." ;
    rdfs:domain <https://openminds.ebrains.eu/core/Project> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Organization> <https://openminds.ebrains.eu/core/Person> ) ] .

<https://openminds.ebrains.eu/vocab/description> a owl:DatatypeProperty ;
    rdfs:label "Description" ;
    rdfs:comment "Longer statement or account giving the characteristics of someone or something." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/controlledTerms/AgeCategory> <https://openminds.ebrains.eu/controlledTerms/AnatomicalAxesOrientation> <https://openminds.ebrains.eu/controlledTerms/BehavioralTask> <https://openminds.ebrains.eu/controlledTerms/BiologicalSex> <https://openminds.ebrains.eu/controlledTerms/CellType> <https://openminds.ebrains.eu/controlledTerms/ContributionType> <https://openminds.ebrains.eu/controlledTerms/CriteriaQualityType> <https://openminds.ebrains.eu/controlledTerms/DatasetType> <https://openminds.ebrains.eu/controlledTerms/Disease> <https://openminds.ebrains.eu/controlledTerms/DiseaseModel> <https://openminds.ebrains.eu/controlledTerms/EthicsAssessment> <https://openminds.ebrains.eu/controlledTerms/FileBundleGrouping> <https://openminds.ebrains.eu/controlledTerms/FileUsageRole> <https://openminds.ebrains.eu/controlledTerms/Genotype> <https://openminds.ebrains.eu/controlledTerms/Language> <https://openminds.ebrains.eu/controlledTerms/Laterality> <https://openminds.ebrains.eu/controlledTerms/MetaDataModelType> <https://openminds.ebrains.eu/controlledTerms/Modality> <https://openminds.ebrains.eu/controlledTerms/ModelAbstractionLevel> <https://openminds.ebrains.eu/controlledTerms/ModelScope> <https://openminds.ebrains.eu/controlledTerms/OperatingDevice> <https://openminds.ebrains.eu/controlledTerms/OperatingSystem> <https://openminds.ebrains.eu/controlledTerms/Organ> <https://openminds.ebrains.eu/controlledTerms/Phenotype> <https://openminds.ebrains.eu/controlledTerms/PreparationType> <https://openminds.ebrains.eu/controlledTerms/ProductAccessibility> <https://openminds.ebrains.eu/controlledTerms/ProgrammingLanguage> <https://openminds.ebrains.eu/controlledTerms/QualitativeOverlap> <https://openminds.ebrains.eu/controlledTerms/SoftwareApplicationCategory> <https://openminds.ebrains.eu/controlledTerms/SoftwareFeature> <https://openminds.ebrains.eu/controlledTerms/SoftwareFeatureCategory> <https://openminds.ebrains.eu/controlledTerms/Species> <https://openminds.ebrains.eu/controlledTerms/Strain> <https://openminds.ebrains.eu/controlledTerms/Technique> <https://openminds.ebrains.eu/controlledTerms/TermSuggestion> <https://openminds.ebrains.eu/controlledTerms/Terminology> <https://openminds.ebrains.eu/controlledTerms/TissueSampleType> <https://openminds.ebrains.eu/controlledTerms/UnitOfMeasurement> <https://openminds.ebrains.eu/core/BehavioralTask> <https://openminds.ebrains.eu/core/ContentType> <https://openminds.ebrains.eu/core/Dataset> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/MetaDataModel> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/Model> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/Project> <https://openminds.ebrains.eu/core/Protocol> <https://openminds.ebrains.eu/core/ProtocolExecution> <https://openminds.ebrains.eu/core/Software> <https://openminds.ebrains.eu/core/SoftwareVersion> <https://openminds.ebrains.eu/sands/BrainAtlas> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/fullName> a owl:DatatypeProperty ;
    rdfs:label "Full name" ;
    rdfs:comment "Whole, non-abbreviated name of something or somebody." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/BehavioralTask> <https://openminds.ebrains.eu/core/Dataset> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/License> <https://openminds.ebrains.eu/core/MetaDataModel> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/Model> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/Organization> <https://openminds.ebrains.eu/core/Project> <https://openminds.ebrains.eu/core/Software> <https://openminds.ebrains.eu/core/SoftwareVersion> <https://openminds.ebrains.eu/sands/AtlasTerminology> <https://openminds.ebrains.eu/sands/BrainAtlas> <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CoordinateSpace> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/hasResearchProducts> a owl:ObjectProperty ;
    rdfs:label "Has research products" ;
    rdfs:comment "Reference to subsidiary research products." ;
    rdfs:domain <https://openminds.ebrains.eu/core/Project> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Dataset> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/MetaDataModel> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/Model> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/Software> <https://openminds.ebrains.eu/core/SoftwareVersion> ) ] .

<https://openminds.ebrains.eu/vocab/homepage> a owl:ObjectProperty ;
    rdfs:label "Homepage" ;
    rdfs:comment "Main website of something or someone." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Dataset> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/MetaDataModel> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/Model> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/Organization> <https://openminds.ebrains.eu/core/Project> <https://openminds.ebrains.eu/core/Software> <https://openminds.ebrains.eu/core/SoftwareVersion> <https://openminds.ebrains.eu/sands/BrainAtlas> <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CoordinateSpace> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/core/URL> .

<https://openminds.ebrains.eu/vocab/shortName> a owl:DatatypeProperty ;
    rdfs:label "Short name" ;
    rdfs:comment "Shortened or fully abbreviated name of something or somebody." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/BehavioralTask> <https://openminds.ebrains.eu/core/Dataset> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/License> <https://openminds.ebrains.eu/core/MetaDataModel> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/Model> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/Organization> <https://openminds.ebrains.eu/core/Project> <https://openminds.ebrains.eu/core/Software> <https://openminds.ebrains.eu/core/SoftwareVersion> <https://openminds.ebrains.eu/sands/AtlasTerminology> <https://openminds.ebrains.eu/sands/BrainAtlas> <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CoordinateSpace> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/core/Project> a owl:Class ;
    rdfs:label "Project" ;
    rdfs:comment "Structured information on a research project." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/fullName> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/shortName> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/core/Organization> <https://openminds.ebrains.eu/core/Person> ) ] ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/coordinator> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/URL> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/homepage> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/core/Dataset> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/MetaDataModel> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/Model> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/Software> <https://openminds.ebrains.eu/core/SoftwareVersion> ) ] ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/hasResearchProducts> ] .

