@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/core/URL> a owl:Class ;
    rdfs:label "Url" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/URL> ] .

<https://openminds.ebrains.eu/vocab/URL> a owl:DatatypeProperty ;
    rdfs:label "URL" ;
    rdfs:domain <https://openminds.ebrains.eu/core/URL> ;
    rdfs:range xsd:string .

