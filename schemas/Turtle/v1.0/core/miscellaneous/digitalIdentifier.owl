@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/core/DigitalIdentifier> a owl:Class ;
    rdfs:label "Digital identifier" ;
    rdfs:comment "Structured information on a digital identifier." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/identifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/DigitalIdentifierSchema> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/identifierSchema> ] .

<https://openminds.ebrains.eu/vocab/howToCite> a owl:DatatypeProperty ;
    rdfs:label "How to cite" ;
    rdfs:comment "Preferred format for citing a particular object or legal person." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Dataset> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/MetaDataModel> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/Model> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/Software> <https://openminds.ebrains.eu/core/SoftwareVersion> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/identifier> a owl:DatatypeProperty ;
    rdfs:label "Identifier" ;
    rdfs:comment "Term or code used to identify something or someone." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/DOI> <https://openminds.ebrains.eu/core/GRIDID> <https://openminds.ebrains.eu/core/ISBN> <https://openminds.ebrains.eu/core/ORCID> <https://openminds.ebrains.eu/core/RORID> <https://openminds.ebrains.eu/core/SWHID> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/identifierSchema> a owl:ObjectProperty ;
    rdfs:label "Identifier schema" ;
    rdfs:comment "Standard for creating a particular identifier for something or someone." .

