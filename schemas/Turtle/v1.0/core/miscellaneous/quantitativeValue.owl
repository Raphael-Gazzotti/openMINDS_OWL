@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/typeOfUncertainty> a owl:ObjectProperty ;
    rdfs:label "Type of uncertainty" ;
    rdfs:comment "Distinct technique used to quantify the uncertainty of a measurement." ;
    rdfs:domain <https://openminds.ebrains.eu/core/QuantitativeValue> ;
    rdfs:range <https://openminds.ebrains.eu/controlledTerms/TypeOfUncertainty> .

<https://openminds.ebrains.eu/vocab/uncertainty> a owl:DatatypeProperty ;
    rdfs:label "Uncertainty" ;
    rdfs:comment "Quantitative value range defining the uncertainty of a measurement." ;
    rdfs:domain <https://openminds.ebrains.eu/core/QuantitativeValue> ;
    rdfs:range rdf:List .

<https://openminds.ebrains.eu/vocab/unit> a owl:ObjectProperty ;
    rdfs:label "Unit" ;
    rdfs:comment "Determinate quantity adopted as a standard of measurement." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/QuantitativeValue> <https://openminds.ebrains.eu/core/QuantitativeValueRange> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/controlledTerms/UnitOfMeasurement> .

<https://openminds.ebrains.eu/vocab/value> a owl:DatatypeProperty ;
    rdfs:label "Value" ;
    rdfs:comment "Entry for a property." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/NumericalParameter> <https://openminds.ebrains.eu/core/QuantitativeValue> <https://openminds.ebrains.eu/core/StringParameter> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/QuantitativeValue> <https://openminds.ebrains.eu/core/QuantitativeValueRange> ) ],
        xsd:decimal .

<https://openminds.ebrains.eu/core/QuantitativeValue> a owl:Class ;
    rdfs:label "Quantitative value" ;
    rdfs:comment "Structured information on a quantitative value." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/controlledTerms/UnitOfMeasurement> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/unit> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/uncertainty> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/controlledTerms/TypeOfUncertainty> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/typeOfUncertainty> ] .

