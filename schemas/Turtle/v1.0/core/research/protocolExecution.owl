@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/description> a owl:DatatypeProperty ;
    rdfs:label "Description" ;
    rdfs:comment "Longer statement or account giving the characteristics of someone or something." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/controlledTerms/AgeCategory> <https://openminds.ebrains.eu/controlledTerms/AnatomicalAxesOrientation> <https://openminds.ebrains.eu/controlledTerms/BehavioralTask> <https://openminds.ebrains.eu/controlledTerms/BiologicalSex> <https://openminds.ebrains.eu/controlledTerms/CellType> <https://openminds.ebrains.eu/controlledTerms/ContributionType> <https://openminds.ebrains.eu/controlledTerms/CriteriaQualityType> <https://openminds.ebrains.eu/controlledTerms/DatasetType> <https://openminds.ebrains.eu/controlledTerms/Disease> <https://openminds.ebrains.eu/controlledTerms/DiseaseModel> <https://openminds.ebrains.eu/controlledTerms/EthicsAssessment> <https://openminds.ebrains.eu/controlledTerms/FileBundleGrouping> <https://openminds.ebrains.eu/controlledTerms/FileUsageRole> <https://openminds.ebrains.eu/controlledTerms/Genotype> <https://openminds.ebrains.eu/controlledTerms/Language> <https://openminds.ebrains.eu/controlledTerms/Laterality> <https://openminds.ebrains.eu/controlledTerms/MetaDataModelType> <https://openminds.ebrains.eu/controlledTerms/Modality> <https://openminds.ebrains.eu/controlledTerms/ModelAbstractionLevel> <https://openminds.ebrains.eu/controlledTerms/ModelScope> <https://openminds.ebrains.eu/controlledTerms/OperatingDevice> <https://openminds.ebrains.eu/controlledTerms/OperatingSystem> <https://openminds.ebrains.eu/controlledTerms/Organ> <https://openminds.ebrains.eu/controlledTerms/Phenotype> <https://openminds.ebrains.eu/controlledTerms/PreparationType> <https://openminds.ebrains.eu/controlledTerms/ProductAccessibility> <https://openminds.ebrains.eu/controlledTerms/ProgrammingLanguage> <https://openminds.ebrains.eu/controlledTerms/QualitativeOverlap> <https://openminds.ebrains.eu/controlledTerms/SoftwareApplicationCategory> <https://openminds.ebrains.eu/controlledTerms/SoftwareFeature> <https://openminds.ebrains.eu/controlledTerms/SoftwareFeatureCategory> <https://openminds.ebrains.eu/controlledTerms/Species> <https://openminds.ebrains.eu/controlledTerms/Strain> <https://openminds.ebrains.eu/controlledTerms/Technique> <https://openminds.ebrains.eu/controlledTerms/TermSuggestion> <https://openminds.ebrains.eu/controlledTerms/Terminology> <https://openminds.ebrains.eu/controlledTerms/TissueSampleType> <https://openminds.ebrains.eu/controlledTerms/UnitOfMeasurement> <https://openminds.ebrains.eu/core/BehavioralTask> <https://openminds.ebrains.eu/core/ContentType> <https://openminds.ebrains.eu/core/Dataset> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/MetaDataModel> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/Model> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/Project> <https://openminds.ebrains.eu/core/Protocol> <https://openminds.ebrains.eu/core/ProtocolExecution> <https://openminds.ebrains.eu/core/Software> <https://openminds.ebrains.eu/core/SoftwareVersion> <https://openminds.ebrains.eu/sands/BrainAtlas> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/endedAtTime> a owl:DatatypeProperty ;
    rdfs:label "Ended at time" ;
    rdfs:domain <https://openminds.ebrains.eu/core/ProtocolExecution> ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/lookupLabel> a owl:DatatypeProperty ;
    rdfs:label "Lookup label" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/ContentTypePattern> <https://openminds.ebrains.eu/core/FileRepositoryStructure> <https://openminds.ebrains.eu/core/ProtocolExecution> <https://openminds.ebrains.eu/core/Subject> <https://openminds.ebrains.eu/core/SubjectGroup> <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> <https://openminds.ebrains.eu/core/TissueSample> <https://openminds.ebrains.eu/core/TissueSampleCollection> <https://openminds.ebrains.eu/core/TissueSampleCollectionState> <https://openminds.ebrains.eu/core/TissueSampleState> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/startedAtTime> a owl:DatatypeProperty ;
    rdfs:label "Started at time" ;
    rdfs:domain <https://openminds.ebrains.eu/core/ProtocolExecution> ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/behavioralTask> a owl:ObjectProperty ;
    rdfs:label "Behavioral task" ;
    rdfs:comment "Specific set of defined activities (or their absence) that should be performed (or avoided) by a subject." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/ProtocolExecution> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/core/BehavioralTask> .

<https://openminds.ebrains.eu/vocab/input> a owl:ObjectProperty ;
    rdfs:label "Input" ;
    rdfs:comment "Something or someone that is put into or participates in a process or machine." ;
    rdfs:domain <https://openminds.ebrains.eu/core/ProtocolExecution> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/File> <https://openminds.ebrains.eu/core/FileBundle> <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> <https://openminds.ebrains.eu/core/TissueSampleCollectionState> <https://openminds.ebrains.eu/core/TissueSampleState> ) ] .

<https://openminds.ebrains.eu/vocab/isPartOf> a owl:ObjectProperty ;
    rdfs:label "Is part of" ;
    rdfs:comment "Reference to the ensemble of multiple things or beings." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/File> <https://openminds.ebrains.eu/core/FileBundle> <https://openminds.ebrains.eu/core/ProtocolExecution> <https://openminds.ebrains.eu/core/Subject> <https://openminds.ebrains.eu/core/TissueSample> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/FileBundle> <https://openminds.ebrains.eu/core/FileRepository> <https://openminds.ebrains.eu/core/SubjectGroup> <https://openminds.ebrains.eu/core/TissueSampleCollection> ) ] .

<https://openminds.ebrains.eu/vocab/output> a owl:ObjectProperty ;
    rdfs:label "Output" ;
    rdfs:comment "Something or someone that comes out of, is delivered or produced by a process or machine." ;
    rdfs:domain <https://openminds.ebrains.eu/core/ProtocolExecution> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/File> <https://openminds.ebrains.eu/core/FileBundle> <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> <https://openminds.ebrains.eu/core/TissueSampleCollectionState> <https://openminds.ebrains.eu/core/TissueSampleState> ) ] .

<https://openminds.ebrains.eu/vocab/parameterSet> a owl:ObjectProperty ;
    rdfs:label "Parameter set" ;
    rdfs:comment "Manner, position, or direction in which digital or physical properties are set to determine a particular function, characteristics or behavior of something." ;
    rdfs:domain <https://openminds.ebrains.eu/core/ProtocolExecution> ;
    rdfs:range <https://openminds.ebrains.eu/core/ParameterSet> .

<https://openminds.ebrains.eu/vocab/preparationType> a owl:ObjectProperty ;
    rdfs:label "Preparation type" ;
    rdfs:comment "Distinct class of actions or processes that make something ready for use or service." ;
    rdfs:domain <https://openminds.ebrains.eu/core/ProtocolExecution> ;
    rdfs:range <https://openminds.ebrains.eu/controlledTerms/PreparationType> .

<https://openminds.ebrains.eu/vocab/protocol> a owl:ObjectProperty ;
    rdfs:label "Protocol" ;
    rdfs:comment "Plan that describes the process of a scientific or medical experiment, treatment, or procedure." ;
    rdfs:domain <https://openminds.ebrains.eu/core/ProtocolExecution> ;
    rdfs:range <https://openminds.ebrains.eu/core/Protocol> .

<https://openminds.ebrains.eu/vocab/studyTarget> a owl:ObjectProperty ;
    rdfs:label "Study target" ;
    rdfs:comment "Structure or function that was targeted within a study." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Model> <https://openminds.ebrains.eu/core/ProtocolExecution> ) ] .

<https://openminds.ebrains.eu/core/ProtocolExecution> a owl:Class ;
    rdfs:label "Protocol execution" ;
    rdfs:comment "Structured information on a protocol execution." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf [ ] ] ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/studyTarget> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/Protocol> ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/protocol> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/DatasetVersion> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/controlledTerms/PreparationType> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/preparationType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/core/File> <https://openminds.ebrains.eu/core/FileBundle> <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> <https://openminds.ebrains.eu/core/TissueSampleCollectionState> <https://openminds.ebrains.eu/core/TissueSampleState> ) ] ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/input> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/BehavioralTask> ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/behavioralTask> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/core/File> <https://openminds.ebrains.eu/core/FileBundle> <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> <https://openminds.ebrains.eu/core/TissueSampleCollectionState> <https://openminds.ebrains.eu/core/TissueSampleState> ) ] ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/output> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/ParameterSet> ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/parameterSet> ] .

