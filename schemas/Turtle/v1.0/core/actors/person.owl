@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/familyName> a owl:DatatypeProperty ;
    rdfs:label "Family name" ;
    rdfs:comment "Name borne in common by members of a family." ;
    rdfs:domain <https://openminds.ebrains.eu/core/Person> ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/affiliation> a owl:ObjectProperty ;
    rdfs:label "Affiliation" ;
    rdfs:comment "Declaration of a person being closely associated to an organization." ;
    rdfs:domain <https://openminds.ebrains.eu/core/Person> ;
    rdfs:range <https://openminds.ebrains.eu/core/Affiliation> .

<https://openminds.ebrains.eu/vocab/contactInformation> a owl:ObjectProperty ;
    rdfs:label "Contact information" ;
    rdfs:comment "Any available way used to contact a person or business (e.g., address, phone number, email address, etc.)." ;
    rdfs:domain <https://openminds.ebrains.eu/core/Person> ;
    rdfs:range <https://openminds.ebrains.eu/core/ContactInformation> .

<https://openminds.ebrains.eu/vocab/digitalIdentifier> a owl:ObjectProperty ;
    rdfs:label "Digital identifier" ;
    rdfs:comment "Digital handle to identify objects or legal persons." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Dataset> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/MetaDataModel> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/Model> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/Organization> <https://openminds.ebrains.eu/core/Person> <https://openminds.ebrains.eu/core/Software> <https://openminds.ebrains.eu/core/SoftwareVersion> <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CoordinateSpace> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/DOI> <https://openminds.ebrains.eu/core/DigitalIdentifier> <https://openminds.ebrains.eu/core/GRIDID> <https://openminds.ebrains.eu/core/ORCID> <https://openminds.ebrains.eu/core/RORID> <https://openminds.ebrains.eu/core/SWHID> ) ] .

<https://openminds.ebrains.eu/vocab/givenName> a owl:DatatypeProperty ;
    rdfs:label "Given name" ;
    rdfs:comment "Name given to a person, including all potential middle names, but excluding the family name." ;
    rdfs:domain <https://openminds.ebrains.eu/core/Person> ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/core/Person> a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "Structured information on a person." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/ContactInformation> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/contactInformation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/ORCID> ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/digitalIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/Affiliation> ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/affiliation> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/givenName> ] .

