@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/endDate> a owl:DatatypeProperty ;
    rdfs:label "End date" ;
    rdfs:comment "Date in the Gregorian calendar at which something terminates in time." ;
    rdfs:domain <https://openminds.ebrains.eu/core/Affiliation> ;
    rdfs:range xsd:date .

<https://openminds.ebrains.eu/vocab/startDate> a owl:DatatypeProperty ;
    rdfs:label "Start date" ;
    rdfs:comment "Date in the Gregorian calendar at which something begins in time" ;
    rdfs:domain <https://openminds.ebrains.eu/core/Affiliation> ;
    rdfs:range xsd:date .

<https://openminds.ebrains.eu/vocab/organization> a owl:ObjectProperty ;
    rdfs:label "Organization" ;
    rdfs:comment "Legally accountable, administrative and functional structure." ;
    rdfs:domain <https://openminds.ebrains.eu/core/Affiliation> ;
    rdfs:range <https://openminds.ebrains.eu/core/Organization> .

<https://openminds.ebrains.eu/core/Affiliation> a owl:Class ;
    rdfs:label "Affiliation" ;
    rdfs:comment "Structured information about a relationship between two entities, such as a person and their employer." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/Organization> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/organization> ] .

