@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/bestViewPoint> a owl:ObjectProperty ;
    rdfs:label "Best view point" ;
    rdfs:comment "Coordinate point from which you get the best view of something." ;
    rdfs:domain <https://openminds.ebrains.eu/sands/Annotation> ;
    rdfs:range <https://openminds.ebrains.eu/sands/CoordinatePoint> .

<https://openminds.ebrains.eu/vocab/criteria> a owl:ObjectProperty ;
    rdfs:label "Criteria" ;
    rdfs:comment "Aspects or standards on which a judgement or decision is based." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/sands/AnatomicalEntityRelation> <https://openminds.ebrains.eu/sands/Annotation> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/core/ProtocolExecution> .

<https://openminds.ebrains.eu/vocab/criteriaQualityType> a owl:ObjectProperty ;
    rdfs:label "Criteria quality type" ;
    rdfs:comment "Distinct class that defines how the judgement or decision was made for a particular criteria." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/sands/AnatomicalEntityRelation> <https://openminds.ebrains.eu/sands/Annotation> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/controlledTerms/CriteriaQualityType> .

<https://openminds.ebrains.eu/vocab/displayColor> a owl:DatatypeProperty ;
    rdfs:label "Display color" ;
    rdfs:comment "Preferred coloring." ;
    rdfs:domain <https://openminds.ebrains.eu/sands/Annotation> ;
    rdfs:range rdf:List .

<https://openminds.ebrains.eu/vocab/inspiredBy> a owl:ObjectProperty ;
    rdfs:label "Inspired by" ;
    rdfs:comment "Reference to an inspiring element." ;
    rdfs:domain <https://openminds.ebrains.eu/sands/Annotation> ;
    rdfs:range <https://openminds.ebrains.eu/sands/Image> .

<https://openminds.ebrains.eu/vocab/internalIdentifier> a owl:DatatypeProperty ;
    rdfs:label "Internal identifier" ;
    rdfs:comment "Term or code that identifies someone or something within a particular product." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Subject> <https://openminds.ebrains.eu/core/SubjectGroup> <https://openminds.ebrains.eu/core/TissueSample> <https://openminds.ebrains.eu/core/TissueSampleCollection> <https://openminds.ebrains.eu/sands/Annotation> <https://openminds.ebrains.eu/sands/Electrode> <https://openminds.ebrains.eu/sands/ElectrodeArray> <https://openminds.ebrains.eu/sands/ElectrodeContact> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/laterality> a owl:ObjectProperty ;
    rdfs:label "Laterality" ;
    rdfs:comment "Differentiation between a pair of lateral homologous parts of the body." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/TissueSample> <https://openminds.ebrains.eu/core/TissueSampleCollection> <https://openminds.ebrains.eu/sands/Annotation> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/controlledTerms/Laterality> .

<https://openminds.ebrains.eu/vocab/namingTerm> a owl:ObjectProperty ;
    rdfs:label "Naming term" ;
    rdfs:comment "Word or expression that has a precise meaning within a science, art, profession, or subject." ;
    rdfs:domain <https://openminds.ebrains.eu/sands/Annotation> ;
    rdfs:range <https://openminds.ebrains.eu/sands/AnatomicalEntity> .

<https://openminds.ebrains.eu/vocab/relatedAtlasTerm> a owl:ObjectProperty ;
    rdfs:label "Related atlas term" ;
    rdfs:comment "Reference to a related naming term of an anatomical structure that is defined in a particular brain atlas." ;
    rdfs:domain <https://openminds.ebrains.eu/sands/Annotation> ;
    rdfs:range <https://openminds.ebrains.eu/sands/AnatomicalEntity> .

<https://openminds.ebrains.eu/vocab/visualizedIn> a owl:ObjectProperty ;
    rdfs:label "Visualized in" ;
    rdfs:comment "Reference to an image in which something is visible." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/sands/Annotation> <https://openminds.ebrains.eu/sands/ElectrodeContact> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/sands/Image> .

<https://openminds.ebrains.eu/sands/Annotation> a owl:Class ;
    rdfs:label "Annotation" ;
    rdfs:comment "Structured information on an image annotation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/sands/Image> ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/inspiredBy> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/sands/AnatomicalEntity> ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/relatedAtlasTerm> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/internalIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/sands/CoordinatePoint> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/bestViewPoint> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/ProtocolExecution> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/criteria> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/sands/Image> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/visualizedIn> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/displayColor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/controlledTerms/Laterality> ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/laterality> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/sands/AnatomicalEntity> ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/namingTerm> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/controlledTerms/CriteriaQualityType> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/criteriaQualityType> ] .

