@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/criteria> a owl:ObjectProperty ;
    rdfs:label "Criteria" ;
    rdfs:comment "Aspects or standards on which a judgement or decision is based." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/sands/AnatomicalEntityRelation> <https://openminds.ebrains.eu/sands/Annotation> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/core/ProtocolExecution> .

<https://openminds.ebrains.eu/vocab/criteriaQualityType> a owl:ObjectProperty ;
    rdfs:label "Criteria quality type" ;
    rdfs:comment "Distinct class that defines how the judgement or decision was made for a particular criteria." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/sands/AnatomicalEntityRelation> <https://openminds.ebrains.eu/sands/Annotation> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/controlledTerms/CriteriaQualityType> .

<https://openminds.ebrains.eu/vocab/inRelationTo> a owl:ObjectProperty ;
    rdfs:label "In relation to" ;
    rdfs:comment "Reference to a related element." ;
    rdfs:domain <https://openminds.ebrains.eu/sands/AnatomicalEntityRelation> ;
    rdfs:range <https://openminds.ebrains.eu/sands/AnatomicalEntity> .

<https://openminds.ebrains.eu/vocab/qualitativeOverlap> a owl:ObjectProperty ;
    rdfs:label "Qualitative overlap" ;
    rdfs:comment "Semantic characterization of how much two things occupy the same space." ;
    rdfs:domain <https://openminds.ebrains.eu/sands/AnatomicalEntityRelation> ;
    rdfs:range <https://openminds.ebrains.eu/controlledTerms/QualitativeOverlap> .

<https://openminds.ebrains.eu/vocab/quantitativeOverlap> a owl:ObjectProperty ;
    rdfs:label "Quantitative overlap" ;
    rdfs:comment "Numerical characterization of how much two things occupy the same space." ;
    rdfs:domain <https://openminds.ebrains.eu/sands/AnatomicalEntityRelation> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/QuantitativeValue> <https://openminds.ebrains.eu/core/QuantitativeValueRange> ) ] .

<https://openminds.ebrains.eu/sands/AnatomicalEntityRelation> a owl:Class ;
    rdfs:label "Anatomical entity relation" ;
    rdfs:comment "Structured information on the relation between one anatomical entity and another." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/controlledTerms/CriteriaQualityType> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/criteriaQualityType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/core/QuantitativeValue> <https://openminds.ebrains.eu/core/QuantitativeValueRange> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/quantitativeOverlap> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/ProtocolExecution> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/criteria> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/controlledTerms/QualitativeOverlap> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/qualitativeOverlap> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/sands/AnatomicalEntity> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/inRelationTo> ] .

