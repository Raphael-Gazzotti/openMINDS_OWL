@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/lookupLabel> a owl:DatatypeProperty ;
    rdfs:label "Lookup label" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CellPatching> <https://openminds.om-i.org/types/ChemicalSubstance> <https://openminds.om-i.org/types/Configuration> <https://openminds.om-i.org/types/ContentTypePattern> <https://openminds.om-i.org/types/CranialWindowPreparation> <https://openminds.om-i.org/types/DataAnalysis> <https://openminds.om-i.org/types/DataCopy> <https://openminds.om-i.org/types/Electrode> <https://openminds.om-i.org/types/ElectrodeArray> <https://openminds.om-i.org/types/ElectrodeArrayUsage> <https://openminds.om-i.org/types/ElectrodePlacement> <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/EphysStimulus> <https://openminds.om-i.org/types/FileRepositoryStructure> <https://openminds.om-i.org/types/GenericComputation> <https://openminds.om-i.org/types/ModelValidation> <https://openminds.om-i.org/types/Optimization> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/Pipette> <https://openminds.om-i.org/types/PipetteUsage> <https://openminds.om-i.org/types/PropertyValueList> <https://openminds.om-i.org/types/ProtocolExecution> <https://openminds.om-i.org/types/RecordingActivity> <https://openminds.om-i.org/types/Simulation> <https://openminds.om-i.org/types/SlicingDevice> <https://openminds.om-i.org/types/SlicingDeviceUsage> <https://openminds.om-i.org/types/StimulationActivity> <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/SubjectGroupState> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueCulturePreparation> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> <https://openminds.om-i.org/types/TissueSampleCollectionState> <https://openminds.om-i.org/types/TissueSampleSlicing> <https://openminds.om-i.org/types/TissueSampleState> <https://openminds.om-i.org/types/Visualization> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/anatomicalLocationOfArray> a owl:ObjectProperty ;
    rdfs:label "Anatomical location of array" ;
    rdfs:domain <https://openminds.om-i.org/types/ElectrodeArrayUsage> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CellType> <https://openminds.om-i.org/types/CustomAnatomicalEntity> <https://openminds.om-i.org/types/Organ> <https://openminds.om-i.org/types/OrganismSubstance> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/SubcellularEntity> <https://openminds.om-i.org/types/UBERONParcellation> ) ] .

<https://openminds.om-i.org/props/anatomicalLocationOfElectrodes> a owl:ObjectProperty ;
    rdfs:label "Anatomical location of electrodes" ;
    rdfs:domain <https://openminds.om-i.org/types/ElectrodeArrayUsage> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CellType> <https://openminds.om-i.org/types/CustomAnatomicalEntity> <https://openminds.om-i.org/types/Organ> <https://openminds.om-i.org/types/OrganismSubstance> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/SubcellularEntity> <https://openminds.om-i.org/types/UBERONParcellation> ) ] .

<https://openminds.om-i.org/props/contactResistances> a owl:ObjectProperty ;
    rdfs:label "Contact resistances" ;
    rdfs:domain <https://openminds.om-i.org/types/ElectrodeArrayUsage> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/QuantitativeValue> <https://openminds.om-i.org/types/QuantitativeValueRange> ) ] .

<https://openminds.om-i.org/props/device> a owl:ObjectProperty ;
    rdfs:label "Device" ;
    rdfs:comment "Piece of equipment or mechanism (hardware) designed to serve a special purpose or perform a special function." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CellPatching> <https://openminds.om-i.org/types/ElectrodeArrayUsage> <https://openminds.om-i.org/types/ElectrodePlacement> <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/PipetteUsage> <https://openminds.om-i.org/types/RecordingActivity> <https://openminds.om-i.org/types/SlicingDeviceUsage> <https://openminds.om-i.org/types/SoftwareVersion> <https://openminds.om-i.org/types/TissueSampleSlicing> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Electrode> <https://openminds.om-i.org/types/ElectrodeArray> <https://openminds.om-i.org/types/ElectrodeArrayUsage> <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/OperatingDevice> <https://openminds.om-i.org/types/Pipette> <https://openminds.om-i.org/types/PipetteUsage> <https://openminds.om-i.org/types/SlicingDevice> <https://openminds.om-i.org/types/SlicingDeviceUsage> ) ] .

<https://openminds.om-i.org/props/metadataLocation> a owl:ObjectProperty ;
    rdfs:label "Metadata location" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/ElectrodeArrayUsage> <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/PipetteUsage> <https://openminds.om-i.org/types/SlicingDeviceUsage> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/FileBundle> ) ] .

<https://openminds.om-i.org/props/spatialLocationOfElectrodes> a owl:ObjectProperty ;
    rdfs:label "Spatial location of electrodes" ;
    rdfs:domain <https://openminds.om-i.org/types/ElectrodeArrayUsage> ;
    rdfs:range <https://openminds.om-i.org/types/CoordinatePoint> .

<https://openminds.om-i.org/props/usedElectrode> a owl:DatatypeProperty ;
    rdfs:label "Used electrode" ;
    rdfs:domain <https://openminds.om-i.org/types/ElectrodeArrayUsage> ;
    rdfs:range rdf:List .

<https://openminds.om-i.org/props/usedSpecimen> a owl:ObjectProperty ;
    rdfs:label "Used specimen" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/BrainAtlasVersion> <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/ElectrodeArrayUsage> <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/PipetteUsage> <https://openminds.om-i.org/types/SlicingDeviceUsage> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> <https://openminds.om-i.org/types/TissueSampleState> ) ] .

<https://openminds.om-i.org/types/ElectrodeArrayUsage> a owl:Class ;
    rdfs:label "Electrode array usage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/FileBundle> ) ] ;
            owl:onProperty <https://openminds.om-i.org/props/metadataLocation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueSampleState> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/usedSpecimen> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/ElectrodeArray> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/device> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/CellType> <https://openminds.om-i.org/types/Organ> <https://openminds.om-i.org/types/OrganismSubstance> <https://openminds.om-i.org/types/SubcellularEntity> <https://openminds.om-i.org/types/UBERONParcellation> <https://openminds.om-i.org/types/CustomAnatomicalEntity> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> ) ] ;
            owl:onProperty <https://openminds.om-i.org/props/anatomicalLocationOfElectrodes> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/QuantitativeValue> <https://openminds.om-i.org/types/QuantitativeValueRange> ) ] ;
            owl:onProperty <https://openminds.om-i.org/props/contactResistances> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/usedElectrode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/CoordinatePoint> ;
            owl:onProperty <https://openminds.om-i.org/props/spatialLocationOfElectrodes> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/CellType> <https://openminds.om-i.org/types/Organ> <https://openminds.om-i.org/types/OrganismSubstance> <https://openminds.om-i.org/types/SubcellularEntity> <https://openminds.om-i.org/types/UBERONParcellation> <https://openminds.om-i.org/types/CustomAnatomicalEntity> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> ) ] ;
            owl:onProperty <https://openminds.om-i.org/props/anatomicalLocationOfArray> ] .

