@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/groupingType> a owl:ObjectProperty ;
    rdfs:label "Grouping type" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/FileBundle> <https://openminds.om-i.org/types/FilePathPattern> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/FileBundleGrouping> .

<https://openminds.om-i.org/props/regex> a owl:DatatypeProperty ;
    rdfs:label "Regex" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/ContentTypePattern> <https://openminds.om-i.org/types/FilePathPattern> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/types/FilePathPattern> a owl:Class ;
    rdfs:label "File path pattern" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/regex> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/FileBundleGrouping> ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/groupingType> ] .

