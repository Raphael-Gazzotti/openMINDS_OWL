@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/IRI> a owl:DatatypeProperty ;
    rdfs:label "Iri" ;
    rdfs:comment "Stands for Internationalized Resource Identifier which is an internet protocol standard that builds on the URI protocol, extending the set of permitted characters to include Unicode/ISO 10646." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Book> <https://openminds.om-i.org/types/Chapter> <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/FileArchive> <https://openminds.om-i.org/types/FileRepository> <https://openminds.om-i.org/types/LearningResource> <https://openminds.om-i.org/types/LivePaperResourceItem> <https://openminds.om-i.org/types/ScholarlyArticle> <https://openminds.om-i.org/types/WebResource> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/contentTypePattern> a owl:ObjectProperty ;
    rdfs:label "Content type pattern" ;
    rdfs:domain <https://openminds.om-i.org/types/FileRepository> ;
    rdfs:range <https://openminds.om-i.org/types/ContentTypePattern> .

<https://openminds.om-i.org/props/format> a owl:ObjectProperty ;
    rdfs:label "Format" ;
    rdfs:comment "Method of digitally organizing and structuring data or information." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Configuration> <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/FileArchive> <https://openminds.om-i.org/types/FileBundle> <https://openminds.om-i.org/types/FileRepository> <https://openminds.om-i.org/types/LocalFile> <https://openminds.om-i.org/types/ModelVersion> <https://openminds.om-i.org/types/ValidationTestVersion> <https://openminds.om-i.org/types/WebResource> <https://openminds.om-i.org/types/WorkflowRecipeVersion> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/ContentType> .

<https://openminds.om-i.org/props/hash> a owl:ObjectProperty ;
    rdfs:label "Hash" ;
    rdfs:comment "Term used for the process of converting any data into a single value. Often also directly refers to the resulting single value." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/FileBundle> <https://openminds.om-i.org/types/FileRepository> <https://openminds.om-i.org/types/LocalFile> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/Hash> .

<https://openminds.om-i.org/props/hostedBy> a owl:ObjectProperty ;
    rdfs:label "Hosted by" ;
    rdfs:comment "Reference to an organization that provides facilities and services for something." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/FileRepository> <https://openminds.om-i.org/types/LivePaperResourceItem> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/Organization> .

<https://openminds.om-i.org/props/name> a owl:DatatypeProperty ;
    rdfs:label "Name" ;
    rdfs:comment "Word or phrase that constitutes the distinctive designation of a being or thing." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/ActionStatusType> <https://openminds.om-i.org/types/AgeCategory> <https://openminds.om-i.org/types/AnalysisTechnique> <https://openminds.om-i.org/types/AnatomicalAxesOrientation> <https://openminds.om-i.org/types/AnatomicalIdentificationType> <https://openminds.om-i.org/types/AnatomicalPlane> <https://openminds.om-i.org/types/AnnotationCriteriaType> <https://openminds.om-i.org/types/AnnotationType> <https://openminds.om-i.org/types/AtlasType> <https://openminds.om-i.org/types/AuditoryStimulusType> <https://openminds.om-i.org/types/BehavioralProtocol> <https://openminds.om-i.org/types/BiologicalOrder> <https://openminds.om-i.org/types/BiologicalProcess> <https://openminds.om-i.org/types/BiologicalSex> <https://openminds.om-i.org/types/Book> <https://openminds.om-i.org/types/BreedingType> <https://openminds.om-i.org/types/CellCultureType> <https://openminds.om-i.org/types/CellType> <https://openminds.om-i.org/types/Chapter> <https://openminds.om-i.org/types/ChemicalMixture> <https://openminds.om-i.org/types/ChemicalMixtureType> <https://openminds.om-i.org/types/Colormap> <https://openminds.om-i.org/types/ContentType> <https://openminds.om-i.org/types/ContributionType> <https://openminds.om-i.org/types/CranialWindowConstructionType> <https://openminds.om-i.org/types/CranialWindowReinforcementType> <https://openminds.om-i.org/types/CriteriaQualityType> <https://openminds.om-i.org/types/CustomAnatomicalEntity> <https://openminds.om-i.org/types/CustomCoordinateSpace> <https://openminds.om-i.org/types/DataType> <https://openminds.om-i.org/types/DeviceType> <https://openminds.om-i.org/types/DifferenceMeasure> <https://openminds.om-i.org/types/Disease> <https://openminds.om-i.org/types/DiseaseModel> <https://openminds.om-i.org/types/EducationalLevel> <https://openminds.om-i.org/types/ElectricalStimulusType> <https://openminds.om-i.org/types/Electrode> <https://openminds.om-i.org/types/ElectrodeArray> <https://openminds.om-i.org/types/Environment> <https://openminds.om-i.org/types/EthicsAssessment> <https://openminds.om-i.org/types/ExperimentalApproach> <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/FileBundle> <https://openminds.om-i.org/types/FileBundleGrouping> <https://openminds.om-i.org/types/FileRepository> <https://openminds.om-i.org/types/FileRepositoryType> <https://openminds.om-i.org/types/FileUsageRole> <https://openminds.om-i.org/types/GeneticStrainType> <https://openminds.om-i.org/types/GustatoryStimulusType> <https://openminds.om-i.org/types/Handedness> <https://openminds.om-i.org/types/HardwareSystem> <https://openminds.om-i.org/types/Language> <https://openminds.om-i.org/types/Laterality> <https://openminds.om-i.org/types/LaunchConfiguration> <https://openminds.om-i.org/types/LearningResource> <https://openminds.om-i.org/types/LearningResourceType> <https://openminds.om-i.org/types/LivePaperResourceItem> <https://openminds.om-i.org/types/LivePaperSection> <https://openminds.om-i.org/types/LocalFile> <https://openminds.om-i.org/types/MRIPulseSequence> <https://openminds.om-i.org/types/MRIWeighting> <https://openminds.om-i.org/types/MeasuredQuantity> <https://openminds.om-i.org/types/MeasuredSignalType> <https://openminds.om-i.org/types/MetaDataModelType> <https://openminds.om-i.org/types/ModelAbstractionLevel> <https://openminds.om-i.org/types/ModelScope> <https://openminds.om-i.org/types/MolecularEntity> <https://openminds.om-i.org/types/NumericalProperty> <https://openminds.om-i.org/types/OlfactoryStimulusType> <https://openminds.om-i.org/types/OperatingDevice> <https://openminds.om-i.org/types/OperatingSystem> <https://openminds.om-i.org/types/OpticalStimulusType> <https://openminds.om-i.org/types/Organ> <https://openminds.om-i.org/types/OrganismSubstance> <https://openminds.om-i.org/types/OrganismSystem> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/PatchClampVariation> <https://openminds.om-i.org/types/Periodical> <https://openminds.om-i.org/types/Pipette> <https://openminds.om-i.org/types/PreparationType> <https://openminds.om-i.org/types/ProductAccessibility> <https://openminds.om-i.org/types/ProgrammingLanguage> <https://openminds.om-i.org/types/Protocol> <https://openminds.om-i.org/types/QualitativeOverlap> <https://openminds.om-i.org/types/Recording> <https://openminds.om-i.org/types/ScholarlyArticle> <https://openminds.om-i.org/types/SemanticDataType> <https://openminds.om-i.org/types/Service> <https://openminds.om-i.org/types/Setup> <https://openminds.om-i.org/types/SetupType> <https://openminds.om-i.org/types/SlicingDevice> <https://openminds.om-i.org/types/SoftwareAgent> <https://openminds.om-i.org/types/SoftwareApplicationCategory> <https://openminds.om-i.org/types/SoftwareFeature> <https://openminds.om-i.org/types/Species> <https://openminds.om-i.org/types/StimulationApproach> <https://openminds.om-i.org/types/StimulationTechnique> <https://openminds.om-i.org/types/Strain> <https://openminds.om-i.org/types/StringProperty> <https://openminds.om-i.org/types/SubcellularEntity> <https://openminds.om-i.org/types/SubjectAttribute> <https://openminds.om-i.org/types/TactileStimulusType> <https://openminds.om-i.org/types/Technique> <https://openminds.om-i.org/types/TermSuggestion> <https://openminds.om-i.org/types/Terminology> <https://openminds.om-i.org/types/TissueSampleAttribute> <https://openminds.om-i.org/types/TissueSampleType> <https://openminds.om-i.org/types/TypeOfUncertainty> <https://openminds.om-i.org/types/UBERONParcellation> <https://openminds.om-i.org/types/UnitOfMeasurement> <https://openminds.om-i.org/types/VisualStimulusType> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/storageSize> a owl:ObjectProperty ;
    rdfs:label "Storage size" ;
    rdfs:comment "Quantitative value defining how much disk space is used by an object on a computer system." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/FileBundle> <https://openminds.om-i.org/types/FileRepository> <https://openminds.om-i.org/types/LocalFile> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/QuantitativeValue> .

<https://openminds.om-i.org/props/structurePattern> a owl:ObjectProperty ;
    rdfs:label "Structure pattern" ;
    rdfs:domain <https://openminds.om-i.org/types/FileRepository> ;
    rdfs:range <https://openminds.om-i.org/types/FileRepositoryStructure> .

<https://openminds.om-i.org/props/type> a owl:ObjectProperty ;
    rdfs:label "Type" ;
    rdfs:comment "Distinct class to which a group of entities or concepts with similar characteristics or attributes belong to." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AtlasAnnotation> <https://openminds.om-i.org/types/BrainAtlasVersion> <https://openminds.om-i.org/types/ChemicalMixture> <https://openminds.om-i.org/types/Contribution> <https://openminds.om-i.org/types/CustomAnnotation> <https://openminds.om-i.org/types/EphysStimulus> <https://openminds.om-i.org/types/FileRepository> <https://openminds.om-i.org/types/LearningResource> <https://openminds.om-i.org/types/LivePaperSection> <https://openminds.om-i.org/types/MetaDataModelVersion> <https://openminds.om-i.org/types/Setup> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnnotationType> <https://openminds.om-i.org/types/AtlasType> <https://openminds.om-i.org/types/ChemicalMixtureType> <https://openminds.om-i.org/types/ContributionType> <https://openminds.om-i.org/types/ElectricalStimulusType> <https://openminds.om-i.org/types/FileRepositoryType> <https://openminds.om-i.org/types/LearningResourceType> <https://openminds.om-i.org/types/MetaDataModelType> <https://openminds.om-i.org/types/SetupType> <https://openminds.om-i.org/types/TissueSampleType> ) ] .

<https://openminds.om-i.org/types/FileRepository> a owl:Class ;
    rdfs:label "File repository" ;
    rdfs:comment "Structured information on a file repository." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/FileRepositoryStructure> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/structurePattern> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/ContentType> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/format> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/ContentTypePattern> ;
            owl:onProperty <https://openminds.om-i.org/props/contentTypePattern> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/IRI> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/FileRepositoryType> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/type> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Hash> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/hash> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/Organization> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/hostedBy> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/QuantitativeValue> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/storageSize> ] .

