@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/internalIdentifier> a owl:DatatypeProperty ;
    rdfs:label "Internal identifier" ;
    rdfs:comment "Term or code that identifies someone or something within a particular product." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AtlasAnnotation> <https://openminds.om-i.org/types/BehavioralProtocol> <https://openminds.om-i.org/types/Channel> <https://openminds.om-i.org/types/CustomAnnotation> <https://openminds.om-i.org/types/Electrode> <https://openminds.om-i.org/types/ElectrodeArray> <https://openminds.om-i.org/types/EphysStimulus> <https://openminds.om-i.org/types/Pipette> <https://openminds.om-i.org/types/Recording> <https://openminds.om-i.org/types/RecordingActivity> <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/SubjectGroupState> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> <https://openminds.om-i.org/types/TissueSampleCollectionState> <https://openminds.om-i.org/types/TissueSampleState> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/lookupLabel> a owl:DatatypeProperty ;
    rdfs:label "Lookup label" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CellPatching> <https://openminds.om-i.org/types/ChemicalSubstance> <https://openminds.om-i.org/types/Configuration> <https://openminds.om-i.org/types/ContentTypePattern> <https://openminds.om-i.org/types/CranialWindowPreparation> <https://openminds.om-i.org/types/DataAnalysis> <https://openminds.om-i.org/types/DataCopy> <https://openminds.om-i.org/types/Electrode> <https://openminds.om-i.org/types/ElectrodeArray> <https://openminds.om-i.org/types/ElectrodeArrayUsage> <https://openminds.om-i.org/types/ElectrodePlacement> <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/EphysStimulus> <https://openminds.om-i.org/types/FileRepositoryStructure> <https://openminds.om-i.org/types/GenericComputation> <https://openminds.om-i.org/types/ModelValidation> <https://openminds.om-i.org/types/Optimization> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/Pipette> <https://openminds.om-i.org/types/PipetteUsage> <https://openminds.om-i.org/types/PropertyValueList> <https://openminds.om-i.org/types/ProtocolExecution> <https://openminds.om-i.org/types/RecordingActivity> <https://openminds.om-i.org/types/Simulation> <https://openminds.om-i.org/types/SlicingDevice> <https://openminds.om-i.org/types/SlicingDeviceUsage> <https://openminds.om-i.org/types/StimulationActivity> <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/SubjectGroupState> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueCulturePreparation> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> <https://openminds.om-i.org/types/TissueSampleCollectionState> <https://openminds.om-i.org/types/TissueSampleSlicing> <https://openminds.om-i.org/types/TissueSampleState> <https://openminds.om-i.org/types/Visualization> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/biologicalSex> a owl:ObjectProperty ;
    rdfs:label "Biological sex" ;
    rdfs:comment "Differentiation of individuals of most species (animals and plants) based on the type of gametes they produce." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/BiologicalSex> .

<https://openminds.om-i.org/props/isPartOf> a owl:ObjectProperty ;
    rdfs:label "Is part of" ;
    rdfs:comment "Reference to the ensemble of multiple things or beings." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CellPatching> <https://openminds.om-i.org/types/Chapter> <https://openminds.om-i.org/types/CranialWindowPreparation> <https://openminds.om-i.org/types/ElectrodePlacement> <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/FileBundle> <https://openminds.om-i.org/types/LivePaperResourceItem> <https://openminds.om-i.org/types/LivePaperSection> <https://openminds.om-i.org/types/ProtocolExecution> <https://openminds.om-i.org/types/PublicationIssue> <https://openminds.om-i.org/types/PublicationVolume> <https://openminds.om-i.org/types/RecordingActivity> <https://openminds.om-i.org/types/ScholarlyArticle> <https://openminds.om-i.org/types/StimulationActivity> <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/TissueCulturePreparation> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleSlicing> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Book> <https://openminds.om-i.org/types/DatasetVersion> <https://openminds.om-i.org/types/FileBundle> <https://openminds.om-i.org/types/FileRepository> <https://openminds.om-i.org/types/LivePaperSection> <https://openminds.om-i.org/types/LivePaperVersion> <https://openminds.om-i.org/types/Periodical> <https://openminds.om-i.org/types/PublicationIssue> <https://openminds.om-i.org/types/PublicationVolume> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/TissueSampleCollection> ) ] .

<https://openminds.om-i.org/props/species> a owl:ObjectProperty ;
    rdfs:label "Species" ;
    rdfs:comment "Category of biological classification comprising related organisms or populations potentially capable of interbreeding, and being designated by a binomial that consists of the name of a genus followed by a Latin or latinized uncapitalized noun or adjective." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Strain> <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Species> <https://openminds.om-i.org/types/Strain> ) ] .

<https://openminds.om-i.org/props/studiedState> a owl:ObjectProperty ;
    rdfs:label "Studied state" ;
    rdfs:comment "Reference to a point in time at which something or someone was studied in a particular mode or condition." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/SubjectGroupState> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueSampleCollectionState> <https://openminds.om-i.org/types/TissueSampleState> ) ] .

<https://openminds.om-i.org/types/Subject> a owl:Class ;
    rdfs:label "Subject" ;
    rdfs:comment "Structured information on a subject." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/Species> <https://openminds.om-i.org/types/Strain> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/species> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/BiologicalSex> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/biologicalSex> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/SubjectGroup> ;
            owl:onProperty <https://openminds.om-i.org/props/isPartOf> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/SubjectState> ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/studiedState> ] .

