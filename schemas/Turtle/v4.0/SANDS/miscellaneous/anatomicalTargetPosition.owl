@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/additionalRemarks> a owl:DatatypeProperty ;
    rdfs:label "Additional remarks" ;
    rdfs:comment "Mention of what deserves additional attention or notice." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalTargetPosition> <https://openminds.om-i.org/types/ChemicalMixture> <https://openminds.om-i.org/types/ChemicalSubstance> <https://openminds.om-i.org/types/Measurement> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/Recording> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/SubjectGroupState> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueSampleCollection> <https://openminds.om-i.org/types/TissueSampleCollectionState> <https://openminds.om-i.org/types/TissueSampleState> <https://openminds.om-i.org/types/ViewerSpecification> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/anatomicalTarget> a owl:ObjectProperty ;
    rdfs:label "Anatomical target" ;
    rdfs:domain <https://openminds.om-i.org/types/AnatomicalTargetPosition> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CellType> <https://openminds.om-i.org/types/CustomAnatomicalEntity> <https://openminds.om-i.org/types/Organ> <https://openminds.om-i.org/types/OrganismSubstance> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/SubcellularEntity> <https://openminds.om-i.org/types/UBERONParcellation> ) ] .

<https://openminds.om-i.org/props/spatialLocation> a owl:ObjectProperty ;
    rdfs:label "Spatial location" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalTargetPosition> <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/PipetteUsage> ) ] ;
    rdfs:range <https://openminds.om-i.org/types/CoordinatePoint> .

<https://openminds.om-i.org/props/targetIdentificationType> a owl:ObjectProperty ;
    rdfs:label "Target identification type" ;
    rdfs:domain <https://openminds.om-i.org/types/AnatomicalTargetPosition> ;
    rdfs:range <https://openminds.om-i.org/types/AnatomicalIdentificationType> .

<https://openminds.om-i.org/types/AnatomicalTargetPosition> a owl:Class ;
    rdfs:label "Anatomical target position" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/CoordinatePoint> ;
            owl:onProperty <https://openminds.om-i.org/props/spatialLocation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/CellType> <https://openminds.om-i.org/types/Organ> <https://openminds.om-i.org/types/OrganismSubstance> <https://openminds.om-i.org/types/SubcellularEntity> <https://openminds.om-i.org/types/UBERONParcellation> <https://openminds.om-i.org/types/CustomAnatomicalEntity> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> ) ] ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/anatomicalTarget> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/AnatomicalIdentificationType> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/targetIdentificationType> ] .

