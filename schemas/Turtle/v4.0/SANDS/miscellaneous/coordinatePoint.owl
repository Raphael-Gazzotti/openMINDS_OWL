@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/coordinateSpace> a owl:ObjectProperty ;
    rdfs:label "Coordinate space" ;
    rdfs:comment "Two or three dimensional geometric setting." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/BrainAtlasVersion> <https://openminds.om-i.org/types/CoordinatePoint> <https://openminds.om-i.org/types/CustomAnnotation> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/CustomCoordinateSpace> ) ] .

<https://openminds.om-i.org/props/coordinates> a owl:ObjectProperty ;
    rdfs:label "Coordinates" ;
    rdfs:comment "Pair or triplet of numbers defining a location in a given coordinate space." ;
    rdfs:domain <https://openminds.om-i.org/types/CoordinatePoint> ;
    rdfs:range <https://openminds.om-i.org/types/QuantitativeValue> .

<https://openminds.om-i.org/types/CoordinatePoint> a owl:Class ;
    rdfs:label "Coordinate point" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/CustomCoordinateSpace> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/coordinateSpace> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/QuantitativeValue> ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/coordinates> ] .

