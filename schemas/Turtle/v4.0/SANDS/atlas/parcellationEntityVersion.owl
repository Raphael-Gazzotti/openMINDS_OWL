@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.om-i.org/props/abbreviation> a owl:DatatypeProperty ;
    rdfs:label "Abbreviation" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/BrainAtlas> <https://openminds.om-i.org/types/BrainAtlasVersion> <https://openminds.om-i.org/types/CommonCoordinateSpace> <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/Periodical> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/additionalRemarks> a owl:DatatypeProperty ;
    rdfs:label "Additional remarks" ;
    rdfs:comment "Mention of what deserves additional attention or notice." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AnatomicalTargetPosition> <https://openminds.om-i.org/types/ChemicalMixture> <https://openminds.om-i.org/types/ChemicalSubstance> <https://openminds.om-i.org/types/Measurement> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/Recording> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/SubjectGroupState> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueSampleCollection> <https://openminds.om-i.org/types/TissueSampleCollectionState> <https://openminds.om-i.org/types/TissueSampleState> <https://openminds.om-i.org/types/ViewerSpecification> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/correctedName> a owl:DatatypeProperty ;
    rdfs:label "Corrected name" ;
    rdfs:domain <https://openminds.om-i.org/types/ParcellationEntityVersion> ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/lookupLabel> a owl:DatatypeProperty ;
    rdfs:label "Lookup label" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CellPatching> <https://openminds.om-i.org/types/ChemicalSubstance> <https://openminds.om-i.org/types/Configuration> <https://openminds.om-i.org/types/ContentTypePattern> <https://openminds.om-i.org/types/CranialWindowPreparation> <https://openminds.om-i.org/types/DataAnalysis> <https://openminds.om-i.org/types/DataCopy> <https://openminds.om-i.org/types/Electrode> <https://openminds.om-i.org/types/ElectrodeArray> <https://openminds.om-i.org/types/ElectrodeArrayUsage> <https://openminds.om-i.org/types/ElectrodePlacement> <https://openminds.om-i.org/types/ElectrodeUsage> <https://openminds.om-i.org/types/EphysStimulus> <https://openminds.om-i.org/types/FileRepositoryStructure> <https://openminds.om-i.org/types/GenericComputation> <https://openminds.om-i.org/types/ModelValidation> <https://openminds.om-i.org/types/Optimization> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/Pipette> <https://openminds.om-i.org/types/PipetteUsage> <https://openminds.om-i.org/types/PropertyValueList> <https://openminds.om-i.org/types/ProtocolExecution> <https://openminds.om-i.org/types/RecordingActivity> <https://openminds.om-i.org/types/Simulation> <https://openminds.om-i.org/types/SlicingDevice> <https://openminds.om-i.org/types/SlicingDeviceUsage> <https://openminds.om-i.org/types/StimulationActivity> <https://openminds.om-i.org/types/Subject> <https://openminds.om-i.org/types/SubjectGroup> <https://openminds.om-i.org/types/SubjectGroupState> <https://openminds.om-i.org/types/SubjectState> <https://openminds.om-i.org/types/TissueCulturePreparation> <https://openminds.om-i.org/types/TissueSample> <https://openminds.om-i.org/types/TissueSampleCollection> <https://openminds.om-i.org/types/TissueSampleCollectionState> <https://openminds.om-i.org/types/TissueSampleSlicing> <https://openminds.om-i.org/types/TissueSampleState> <https://openminds.om-i.org/types/Visualization> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/versionInnovation> a owl:DatatypeProperty ;
    rdfs:label "Version innovation" ;
    rdfs:comment "Documentation on what changed in comparison to a previously published form of something." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/BrainAtlasVersion> <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/DatasetVersion> <https://openminds.om-i.org/types/LivePaperVersion> <https://openminds.om-i.org/types/MetaDataModelVersion> <https://openminds.om-i.org/types/ModelVersion> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/SoftwareVersion> <https://openminds.om-i.org/types/ValidationTestVersion> <https://openminds.om-i.org/types/WebServiceVersion> <https://openminds.om-i.org/types/WorkflowRecipeVersion> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/alternateName> a owl:DatatypeProperty ;
    rdfs:label "Alternate name" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/Person> ) ] ;
    rdfs:range rdf:List .

<https://openminds.om-i.org/props/hasAnnotation> a owl:ObjectProperty ;
    rdfs:label "Has annotation" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CustomAnatomicalEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/AtlasAnnotation> <https://openminds.om-i.org/types/CustomAnnotation> ) ] .

<https://openminds.om-i.org/props/hasParent> a owl:ObjectProperty ;
    rdfs:label "Has parent" ;
    rdfs:comment "Reference to a parent object or legal person." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Organization> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Organization> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> ) ] .

<https://openminds.om-i.org/props/name> a owl:DatatypeProperty ;
    rdfs:label "Name" ;
    rdfs:comment "Word or phrase that constitutes the distinctive designation of a being or thing." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/ActionStatusType> <https://openminds.om-i.org/types/AgeCategory> <https://openminds.om-i.org/types/AnalysisTechnique> <https://openminds.om-i.org/types/AnatomicalAxesOrientation> <https://openminds.om-i.org/types/AnatomicalIdentificationType> <https://openminds.om-i.org/types/AnatomicalPlane> <https://openminds.om-i.org/types/AnnotationCriteriaType> <https://openminds.om-i.org/types/AnnotationType> <https://openminds.om-i.org/types/AtlasType> <https://openminds.om-i.org/types/AuditoryStimulusType> <https://openminds.om-i.org/types/BehavioralProtocol> <https://openminds.om-i.org/types/BiologicalOrder> <https://openminds.om-i.org/types/BiologicalProcess> <https://openminds.om-i.org/types/BiologicalSex> <https://openminds.om-i.org/types/Book> <https://openminds.om-i.org/types/BreedingType> <https://openminds.om-i.org/types/CellCultureType> <https://openminds.om-i.org/types/CellType> <https://openminds.om-i.org/types/Chapter> <https://openminds.om-i.org/types/ChemicalMixture> <https://openminds.om-i.org/types/ChemicalMixtureType> <https://openminds.om-i.org/types/Colormap> <https://openminds.om-i.org/types/ContentType> <https://openminds.om-i.org/types/ContributionType> <https://openminds.om-i.org/types/CranialWindowConstructionType> <https://openminds.om-i.org/types/CranialWindowReinforcementType> <https://openminds.om-i.org/types/CriteriaQualityType> <https://openminds.om-i.org/types/CustomAnatomicalEntity> <https://openminds.om-i.org/types/CustomCoordinateSpace> <https://openminds.om-i.org/types/DataType> <https://openminds.om-i.org/types/DeviceType> <https://openminds.om-i.org/types/DifferenceMeasure> <https://openminds.om-i.org/types/Disease> <https://openminds.om-i.org/types/DiseaseModel> <https://openminds.om-i.org/types/EducationalLevel> <https://openminds.om-i.org/types/ElectricalStimulusType> <https://openminds.om-i.org/types/Electrode> <https://openminds.om-i.org/types/ElectrodeArray> <https://openminds.om-i.org/types/Environment> <https://openminds.om-i.org/types/EthicsAssessment> <https://openminds.om-i.org/types/ExperimentalApproach> <https://openminds.om-i.org/types/File> <https://openminds.om-i.org/types/FileBundle> <https://openminds.om-i.org/types/FileBundleGrouping> <https://openminds.om-i.org/types/FileRepository> <https://openminds.om-i.org/types/FileRepositoryType> <https://openminds.om-i.org/types/FileUsageRole> <https://openminds.om-i.org/types/GeneticStrainType> <https://openminds.om-i.org/types/GustatoryStimulusType> <https://openminds.om-i.org/types/Handedness> <https://openminds.om-i.org/types/HardwareSystem> <https://openminds.om-i.org/types/Language> <https://openminds.om-i.org/types/Laterality> <https://openminds.om-i.org/types/LaunchConfiguration> <https://openminds.om-i.org/types/LearningResource> <https://openminds.om-i.org/types/LearningResourceType> <https://openminds.om-i.org/types/LivePaperResourceItem> <https://openminds.om-i.org/types/LivePaperSection> <https://openminds.om-i.org/types/LocalFile> <https://openminds.om-i.org/types/MRIPulseSequence> <https://openminds.om-i.org/types/MRIWeighting> <https://openminds.om-i.org/types/MeasuredQuantity> <https://openminds.om-i.org/types/MeasuredSignalType> <https://openminds.om-i.org/types/MetaDataModelType> <https://openminds.om-i.org/types/ModelAbstractionLevel> <https://openminds.om-i.org/types/ModelScope> <https://openminds.om-i.org/types/MolecularEntity> <https://openminds.om-i.org/types/NumericalProperty> <https://openminds.om-i.org/types/OlfactoryStimulusType> <https://openminds.om-i.org/types/OperatingDevice> <https://openminds.om-i.org/types/OperatingSystem> <https://openminds.om-i.org/types/OpticalStimulusType> <https://openminds.om-i.org/types/Organ> <https://openminds.om-i.org/types/OrganismSubstance> <https://openminds.om-i.org/types/OrganismSystem> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/PatchClampVariation> <https://openminds.om-i.org/types/Periodical> <https://openminds.om-i.org/types/Pipette> <https://openminds.om-i.org/types/PreparationType> <https://openminds.om-i.org/types/ProductAccessibility> <https://openminds.om-i.org/types/ProgrammingLanguage> <https://openminds.om-i.org/types/Protocol> <https://openminds.om-i.org/types/QualitativeOverlap> <https://openminds.om-i.org/types/Recording> <https://openminds.om-i.org/types/ScholarlyArticle> <https://openminds.om-i.org/types/SemanticDataType> <https://openminds.om-i.org/types/Service> <https://openminds.om-i.org/types/Setup> <https://openminds.om-i.org/types/SetupType> <https://openminds.om-i.org/types/SlicingDevice> <https://openminds.om-i.org/types/SoftwareAgent> <https://openminds.om-i.org/types/SoftwareApplicationCategory> <https://openminds.om-i.org/types/SoftwareFeature> <https://openminds.om-i.org/types/Species> <https://openminds.om-i.org/types/StimulationApproach> <https://openminds.om-i.org/types/StimulationTechnique> <https://openminds.om-i.org/types/Strain> <https://openminds.om-i.org/types/StringProperty> <https://openminds.om-i.org/types/SubcellularEntity> <https://openminds.om-i.org/types/SubjectAttribute> <https://openminds.om-i.org/types/TactileStimulusType> <https://openminds.om-i.org/types/Technique> <https://openminds.om-i.org/types/TermSuggestion> <https://openminds.om-i.org/types/Terminology> <https://openminds.om-i.org/types/TissueSampleAttribute> <https://openminds.om-i.org/types/TissueSampleType> <https://openminds.om-i.org/types/TypeOfUncertainty> <https://openminds.om-i.org/types/UBERONParcellation> <https://openminds.om-i.org/types/UnitOfMeasurement> <https://openminds.om-i.org/types/VisualStimulusType> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/props/ontologyIdentifier> a owl:DatatypeProperty ;
    rdfs:label "Ontology identifier" ;
    rdfs:comment "Term or code used to identify something or someone registered within a particular ontology." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/BrainAtlas> <https://openminds.om-i.org/types/BrainAtlasVersion> <https://openminds.om-i.org/types/CommonCoordinateSpace> <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/ParcellationTerminology> <https://openminds.om-i.org/types/ParcellationTerminologyVersion> <https://openminds.om-i.org/types/Strain> ) ] ;
    rdfs:range rdf:List .

<https://openminds.om-i.org/props/relationAssessment> a owl:ObjectProperty ;
    rdfs:label "Relation assessment" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/CustomAnatomicalEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/QualitativeRelationAssessment> <https://openminds.om-i.org/types/QuantitativeRelationAssessment> ) ] .

<https://openminds.om-i.org/props/versionIdentifier> a owl:DatatypeProperty ;
    rdfs:label "Version identifier" ;
    rdfs:comment "Term or code used to identify the version of something." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.om-i.org/types/Book> <https://openminds.om-i.org/types/BrainAtlasVersion> <https://openminds.om-i.org/types/Chapter> <https://openminds.om-i.org/types/CommonCoordinateSpaceVersion> <https://openminds.om-i.org/types/DatasetVersion> <https://openminds.om-i.org/types/HardwareSystem> <https://openminds.om-i.org/types/LearningResource> <https://openminds.om-i.org/types/LivePaperVersion> <https://openminds.om-i.org/types/MetaDataModelVersion> <https://openminds.om-i.org/types/ModelVersion> <https://openminds.om-i.org/types/ParcellationEntityVersion> <https://openminds.om-i.org/types/ScholarlyArticle> <https://openminds.om-i.org/types/SoftwareVersion> <https://openminds.om-i.org/types/ValidationTestVersion> <https://openminds.om-i.org/types/WebServiceVersion> <https://openminds.om-i.org/types/WorkflowRecipeVersion> ) ] ;
    rdfs:range xsd:string .

<https://openminds.om-i.org/types/ParcellationEntityVersion> a owl:Class ;
    rdfs:label "Parcellation entity version" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/ontologyIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.om-i.org/types/AtlasAnnotation> ;
            owl:onProperty <https://openminds.om-i.org/props/hasAnnotation> ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/alternateName> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/ParcellationEntity> <https://openminds.om-i.org/types/ParcellationEntityVersion> ) ] ;
            owl:onProperty <https://openminds.om-i.org/props/hasParent> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/name> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.om-i.org/props/versionIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.om-i.org/types/QualitativeRelationAssessment> <https://openminds.om-i.org/types/QuantitativeRelationAssessment> ) ] ;
            owl:onProperty <https://openminds.om-i.org/props/relationAssessment> ] .

