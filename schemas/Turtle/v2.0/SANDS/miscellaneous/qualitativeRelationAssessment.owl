@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/criteria> a owl:ObjectProperty ;
    rdfs:label "Criteria" ;
    rdfs:comment "Aspects or standards on which a judgement or decision is based." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/sands/AtlasAnnotation> <https://openminds.ebrains.eu/sands/CustomAnnotation> <https://openminds.ebrains.eu/sands/QualitativeRelationAssessment> <https://openminds.ebrains.eu/sands/QuantitativeRelationAssessment> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/core/ProtocolExecution> .

<https://openminds.ebrains.eu/vocab/inRelationTo> a owl:ObjectProperty ;
    rdfs:label "In relation to" ;
    rdfs:comment "Reference to a related element." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/sands/QualitativeRelationAssessment> <https://openminds.ebrains.eu/sands/QuantitativeRelationAssessment> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/sands/ParcellationEntity> .

<https://openminds.ebrains.eu/vocab/qualitativeOverlap> a owl:ObjectProperty ;
    rdfs:label "Qualitative overlap" ;
    rdfs:comment "Semantic characterization of how much two things occupy the same space." ;
    rdfs:domain <https://openminds.ebrains.eu/sands/QualitativeRelationAssessment> ;
    rdfs:range <https://openminds.ebrains.eu/controlledTerms/QualitativeOverlap> .

<https://openminds.ebrains.eu/sands/QualitativeRelationAssessment> a owl:Class ;
    rdfs:label "Qualitative relation assessment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/ProtocolExecution> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/criteria> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/sands/ParcellationEntity> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/inRelationTo> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/controlledTerms/QualitativeOverlap> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/qualitativeOverlap> ] .

