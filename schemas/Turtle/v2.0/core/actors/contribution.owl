@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/contributionType> a owl:ObjectProperty ;
    rdfs:label "Contribution type" ;
    rdfs:comment "Distinct class of what was given or supplied as a part or share." ;
    rdfs:domain <https://openminds.ebrains.eu/core/Contribution> ;
    rdfs:range <https://openminds.ebrains.eu/controlledTerms/ContributionType> .

<https://openminds.ebrains.eu/vocab/contributor> a owl:ObjectProperty ;
    rdfs:label "Contributor" ;
    rdfs:comment "Legal person that gave or supplied something as a part or share." ;
    rdfs:domain <https://openminds.ebrains.eu/core/Contribution> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Organization> <https://openminds.ebrains.eu/core/Person> ) ] .

<https://openminds.ebrains.eu/core/Contribution> a owl:Class ;
    rdfs:label "Contribution" ;
    rdfs:comment "Structured information on the contribution made to a research product." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/controlledTerms/ContributionType> ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/contributionType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/core/Organization> <https://openminds.ebrains.eu/core/Person> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/contributor> ] .

