@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/additionalRemarks> a owl:DatatypeProperty ;
    rdfs:label "Additional remarks" ;
    rdfs:comment "Mention of what deserves additional attention or notice." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/SubjectGroup> <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> <https://openminds.ebrains.eu/core/TissueSampleCollection> <https://openminds.ebrains.eu/core/TissueSampleCollectionState> <https://openminds.ebrains.eu/core/TissueSampleState> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/lookupLabel> a owl:DatatypeProperty ;
    rdfs:label "Lookup label" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/ProtocolExecution> <https://openminds.ebrains.eu/core/Subject> <https://openminds.ebrains.eu/core/SubjectGroup> <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> <https://openminds.ebrains.eu/core/TissueSample> <https://openminds.ebrains.eu/core/TissueSampleCollection> <https://openminds.ebrains.eu/core/TissueSampleCollectionState> <https://openminds.ebrains.eu/core/TissueSampleState> <https://openminds.ebrains.eu/sands/AtlasAnnotation> <https://openminds.ebrains.eu/sands/CustomAnnotation> <https://openminds.ebrains.eu/sands/Electrode> <https://openminds.ebrains.eu/sands/ElectrodeArray> <https://openminds.ebrains.eu/sands/ElectrodeContact> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/age> a owl:ObjectProperty ;
    rdfs:label "Age" ;
    rdfs:comment "Time of life or existence at which some particular qualification, capacity or event arises." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> <https://openminds.ebrains.eu/core/TissueSampleCollectionState> <https://openminds.ebrains.eu/core/TissueSampleState> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/QuantitativeValue> <https://openminds.ebrains.eu/core/QuantitativeValueRange> ) ] .

<https://openminds.ebrains.eu/vocab/ageCategory> a owl:ObjectProperty ;
    rdfs:label "Age category" ;
    rdfs:comment "Distinct life cycle class that is defined by a similar age or age range (developmental stage) within a group of individual beings." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/controlledTerms/AgeCategory> .

<https://openminds.ebrains.eu/vocab/handedness> a owl:ObjectProperty ;
    rdfs:label "Handedness" ;
    rdfs:comment "Degree to which an organism prefers one hand or foot over the other hand or foot during the performance of a task." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/controlledTerms/Handedness> .

<https://openminds.ebrains.eu/vocab/pathology> a owl:ObjectProperty ;
    rdfs:label "Pathology" ;
    rdfs:comment "Structural and functional deviation from the normal that constitutes a disease or characterizes a particular disease." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> <https://openminds.ebrains.eu/core/TissueSampleCollectionState> <https://openminds.ebrains.eu/core/TissueSampleState> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/controlledTerms/Disease> <https://openminds.ebrains.eu/controlledTerms/DiseaseModel> ) ] .

<https://openminds.ebrains.eu/vocab/weight> a owl:ObjectProperty ;
    rdfs:label "Weight" ;
    rdfs:comment "Amount that a thing or being weighs." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> <https://openminds.ebrains.eu/core/TissueSampleCollectionState> <https://openminds.ebrains.eu/core/TissueSampleState> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/QuantitativeValue> <https://openminds.ebrains.eu/core/QuantitativeValueRange> ) ] .

<https://openminds.ebrains.eu/core/SubjectState> a owl:Class ;
    rdfs:label "Subject state" ;
    rdfs:comment "Structured information on a temporary state of a subject." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/core/QuantitativeValue> <https://openminds.ebrains.eu/core/QuantitativeValueRange> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/weight> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/controlledTerms/AgeCategory> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/ageCategory> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/controlledTerms/Handedness> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/handedness> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/controlledTerms/Disease> <https://openminds.ebrains.eu/controlledTerms/DiseaseModel> ) ] ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/pathology> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/core/QuantitativeValue> <https://openminds.ebrains.eu/core/QuantitativeValueRange> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/age> ] .

