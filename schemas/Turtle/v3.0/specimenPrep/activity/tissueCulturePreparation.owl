@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/cultureMedium> a owl:ObjectProperty ;
    rdfs:label "Culture medium" ;
    rdfs:domain <https://openminds.ebrains.eu/specimenPrep/TissueCulturePreparation> ;
    rdfs:range <https://openminds.ebrains.eu/chemicals/ChemicalMixture> .

<https://openminds.ebrains.eu/vocab/cultureType> a owl:ObjectProperty ;
    rdfs:label "Culture type" ;
    rdfs:domain <https://openminds.ebrains.eu/specimenPrep/TissueCulturePreparation> ;
    rdfs:range <https://openminds.ebrains.eu/controlledTerms/CellCultureType> .

<https://openminds.ebrains.eu/vocab/input> a owl:ObjectProperty ;
    rdfs:label "Input" ;
    rdfs:comment "Something or someone that is put into or participates in a process or machine." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/computation/DataAnalysis> <https://openminds.ebrains.eu/computation/DataCopy> <https://openminds.ebrains.eu/computation/GenericComputation> <https://openminds.ebrains.eu/computation/ModelValidation> <https://openminds.ebrains.eu/computation/Optimization> <https://openminds.ebrains.eu/computation/Simulation> <https://openminds.ebrains.eu/computation/Visualization> <https://openminds.ebrains.eu/core/ProtocolExecution> <https://openminds.ebrains.eu/ephys/CellPatching> <https://openminds.ebrains.eu/ephys/ElectrodePlacement> <https://openminds.ebrains.eu/ephys/RecordingActivity> <https://openminds.ebrains.eu/specimenPrep/CranialWindowPreparation> <https://openminds.ebrains.eu/specimenPrep/TissueCulturePreparation> <https://openminds.ebrains.eu/specimenPrep/TissueSampleSlicing> <https://openminds.ebrains.eu/stimulation/StimulationActivity> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/computation/LocalFile> <https://openminds.ebrains.eu/computation/ValidationTestVersion> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/File> <https://openminds.ebrains.eu/core/FileBundle> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/SoftwareVersion> <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> <https://openminds.ebrains.eu/core/TissueSampleCollectionState> <https://openminds.ebrains.eu/core/TissueSampleState> <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CommonCoordinateSpaceVersion> ) ] .

<https://openminds.ebrains.eu/vocab/output> a owl:ObjectProperty ;
    rdfs:label "Output" ;
    rdfs:comment "Something or someone that comes out of, is delivered or produced by a process or machine." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/computation/DataAnalysis> <https://openminds.ebrains.eu/computation/DataCopy> <https://openminds.ebrains.eu/computation/GenericComputation> <https://openminds.ebrains.eu/computation/ModelValidation> <https://openminds.ebrains.eu/computation/Optimization> <https://openminds.ebrains.eu/computation/Simulation> <https://openminds.ebrains.eu/computation/Visualization> <https://openminds.ebrains.eu/core/ProtocolExecution> <https://openminds.ebrains.eu/ephys/CellPatching> <https://openminds.ebrains.eu/ephys/ElectrodePlacement> <https://openminds.ebrains.eu/ephys/RecordingActivity> <https://openminds.ebrains.eu/specimenPrep/CranialWindowPreparation> <https://openminds.ebrains.eu/specimenPrep/TissueCulturePreparation> <https://openminds.ebrains.eu/specimenPrep/TissueSampleSlicing> <https://openminds.ebrains.eu/stimulation/StimulationActivity> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/computation/LocalFile> <https://openminds.ebrains.eu/core/File> <https://openminds.ebrains.eu/core/FileArchive> <https://openminds.ebrains.eu/core/FileBundle> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> <https://openminds.ebrains.eu/core/TissueSampleCollectionState> <https://openminds.ebrains.eu/core/TissueSampleState> ) ] .

<https://openminds.ebrains.eu/specimenPrep/TissueCulturePreparation> a owl:Class ;
    rdfs:label "Tissue culture preparation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/TissueSampleState> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/output> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/chemicals/ChemicalMixture> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/cultureMedium> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/core/TissueSampleState> <https://openminds.ebrains.eu/core/TissueSampleCollectionState> <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/input> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/controlledTerms/CellCultureType> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/cultureType> ] .

