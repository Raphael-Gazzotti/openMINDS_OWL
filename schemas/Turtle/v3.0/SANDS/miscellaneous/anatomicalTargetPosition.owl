@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/additionalRemarks> a owl:DatatypeProperty ;
    rdfs:label "Additional remarks" ;
    rdfs:comment "Mention of what deserves additional attention or notice." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/chemicals/ChemicalMixture> <https://openminds.ebrains.eu/chemicals/ChemicalSubstance> <https://openminds.ebrains.eu/core/Measurement> <https://openminds.ebrains.eu/core/SubjectGroup> <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> <https://openminds.ebrains.eu/core/TissueSampleCollection> <https://openminds.ebrains.eu/core/TissueSampleCollectionState> <https://openminds.ebrains.eu/core/TissueSampleState> <https://openminds.ebrains.eu/ephys/Recording> <https://openminds.ebrains.eu/sands/AnatomicalTargetPosition> <https://openminds.ebrains.eu/sands/ParcellationEntityVersion> <https://openminds.ebrains.eu/sands/ViewerSpecification> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/anatomicalTarget> a owl:ObjectProperty ;
    rdfs:label "Anatomical target" ;
    rdfs:domain <https://openminds.ebrains.eu/sands/AnatomicalTargetPosition> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/controlledTerms/CellType> <https://openminds.ebrains.eu/controlledTerms/Organ> <https://openminds.ebrains.eu/controlledTerms/OrganismSubstance> <https://openminds.ebrains.eu/controlledTerms/SubcellularEntity> <https://openminds.ebrains.eu/controlledTerms/UBERONParcellation> <https://openminds.ebrains.eu/sands/CustomAnatomicalEntity> <https://openminds.ebrains.eu/sands/ParcellationEntity> <https://openminds.ebrains.eu/sands/ParcellationEntityVersion> ) ] .

<https://openminds.ebrains.eu/vocab/spatialLocation> a owl:ObjectProperty ;
    rdfs:label "Spatial location" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/ephys/ElectrodeUsage> <https://openminds.ebrains.eu/ephys/PipetteUsage> <https://openminds.ebrains.eu/sands/AnatomicalTargetPosition> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/sands/CoordinatePoint> .

<https://openminds.ebrains.eu/vocab/targetIdentificationType> a owl:ObjectProperty ;
    rdfs:label "Target identification type" ;
    rdfs:domain <https://openminds.ebrains.eu/sands/AnatomicalTargetPosition> ;
    rdfs:range <https://openminds.ebrains.eu/controlledTerms/AnatomicalIdentificationType> .

<https://openminds.ebrains.eu/sands/AnatomicalTargetPosition> a owl:Class ;
    rdfs:label "Anatomical target position" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/controlledTerms/CellType> <https://openminds.ebrains.eu/controlledTerms/Organ> <https://openminds.ebrains.eu/controlledTerms/OrganismSubstance> <https://openminds.ebrains.eu/controlledTerms/SubcellularEntity> <https://openminds.ebrains.eu/controlledTerms/UBERONParcellation> <https://openminds.ebrains.eu/sands/CustomAnatomicalEntity> <https://openminds.ebrains.eu/sands/ParcellationEntity> <https://openminds.ebrains.eu/sands/ParcellationEntityVersion> ) ] ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/anatomicalTarget> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/controlledTerms/AnatomicalIdentificationType> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/targetIdentificationType> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/sands/CoordinatePoint> ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/spatialLocation> ] .

