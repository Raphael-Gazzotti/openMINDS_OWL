@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/additionalRemarks> a owl:DatatypeProperty ;
    rdfs:label "Additional remarks" ;
    rdfs:comment "Mention of what deserves additional attention or notice." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/chemicals/ChemicalMixture> <https://openminds.ebrains.eu/chemicals/ChemicalSubstance> <https://openminds.ebrains.eu/core/Measurement> <https://openminds.ebrains.eu/core/SubjectGroup> <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> <https://openminds.ebrains.eu/core/TissueSampleCollection> <https://openminds.ebrains.eu/core/TissueSampleCollectionState> <https://openminds.ebrains.eu/core/TissueSampleState> <https://openminds.ebrains.eu/ephys/Recording> <https://openminds.ebrains.eu/sands/AnatomicalTargetPosition> <https://openminds.ebrains.eu/sands/ParcellationEntityVersion> <https://openminds.ebrains.eu/sands/ViewerSpecification> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/anchorPoint> a owl:ObjectProperty ;
    rdfs:label "Anchor point" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/sands/AtlasAnnotation> <https://openminds.ebrains.eu/sands/CustomAnnotation> <https://openminds.ebrains.eu/sands/ViewerSpecification> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/core/QuantitativeValue> .

<https://openminds.ebrains.eu/vocab/cameraPosition> a owl:ObjectProperty ;
    rdfs:label "Camera position" ;
    rdfs:domain <https://openminds.ebrains.eu/sands/ViewerSpecification> ;
    rdfs:range <https://openminds.ebrains.eu/sands/CoordinatePoint> .

<https://openminds.ebrains.eu/vocab/preferredDisplayColor> a owl:ObjectProperty ;
    rdfs:label "Preferred display color" ;
    rdfs:domain <https://openminds.ebrains.eu/sands/ViewerSpecification> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/controlledTerms/Colormap> <https://openminds.ebrains.eu/sands/SingleColor> ) ] .

<https://openminds.ebrains.eu/sands/ViewerSpecification> a owl:Class ;
    rdfs:label "Viewer specification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/controlledTerms/Colormap> <https://openminds.ebrains.eu/sands/SingleColor> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/preferredDisplayColor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/QuantitativeValue> ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/anchorPoint> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/sands/CoordinatePoint> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/cameraPosition> ] .

