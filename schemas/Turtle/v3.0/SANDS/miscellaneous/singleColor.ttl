@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/sands/SingleColor> a owl:Class ;
    rdfs:label "Single color" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/value> ] .

<https://openminds.ebrains.eu/vocab/value> a owl:DatatypeProperty ;
    rdfs:label "Value" ;
    rdfs:comment "Entry for a property." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Measurement> <https://openminds.ebrains.eu/core/NumericalProperty> <https://openminds.ebrains.eu/core/QuantitativeValue> <https://openminds.ebrains.eu/core/StringProperty> <https://openminds.ebrains.eu/sands/SingleColor> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/QuantitativeValue> <https://openminds.ebrains.eu/core/QuantitativeValueRange> ) ],
        xsd:string .

