@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/sands/Circle> a owl:Class ;
    rdfs:label "Circle" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/QuantitativeValue> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/radius> ] .

<https://openminds.ebrains.eu/vocab/radius> a owl:ObjectProperty ;
    rdfs:label "Radius" ;
    rdfs:domain <https://openminds.ebrains.eu/sands/Circle> ;
    rdfs:range <https://openminds.ebrains.eu/core/QuantitativeValue> .

