@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/length> a owl:ObjectProperty ;
    rdfs:label "Length" ;
    rdfs:domain <https://openminds.ebrains.eu/sands/Rectangle> ;
    rdfs:range <https://openminds.ebrains.eu/core/QuantitativeValue> .

<https://openminds.ebrains.eu/vocab/width> a owl:ObjectProperty ;
    rdfs:label "Width" ;
    rdfs:domain <https://openminds.ebrains.eu/sands/Rectangle> ;
    rdfs:range <https://openminds.ebrains.eu/core/QuantitativeValue> .

<https://openminds.ebrains.eu/sands/Rectangle> a owl:Class ;
    rdfs:label "Rectangle" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/QuantitativeValue> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/width> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/QuantitativeValue> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/length> ] .

