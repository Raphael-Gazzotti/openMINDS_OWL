<https://openminds.ebrains.eu/vocab/author> a owl:ObjectProperty ;
    rdfs:label "Author" ;
    rdfs:comment "Creator of a literary or creative work, as well as a dataset publication." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Dataset> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/publications/Book> <https://openminds.ebrains.eu/publications/Chapter> <https://openminds.ebrains.eu/publications/LearningResource> <https://openminds.ebrains.eu/publications/LivePaper> <https://openminds.ebrains.eu/publications/LivePaperVersion> <https://openminds.ebrains.eu/publications/ScholarlyArticle> <https://openminds.ebrains.eu/sands/BrainAtlas> <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CommonCoordinateSpace> <https://openminds.ebrains.eu/sands/CommonCoordinateSpaceVersion> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Consortium> <https://openminds.ebrains.eu/core/Organization> <https://openminds.ebrains.eu/core/Person> ) ] .

<https://openminds.ebrains.eu/vocab/coordinateSpace> a owl:ObjectProperty ;
    rdfs:label "Coordinate space" ;
    rdfs:comment "Two or three dimensional geometric setting." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CoordinatePoint> <https://openminds.ebrains.eu/sands/CustomAnnotation> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/sands/CommonCoordinateSpaceVersion> <https://openminds.ebrains.eu/sands/CustomCoordinateSpace> ) ] .

<https://openminds.ebrains.eu/vocab/copyright> a owl:ObjectProperty ;
    rdfs:label "Copyright" ;
    rdfs:comment "Exclusive and assignable legal right of an originator to reproduce, publish, sell, or distribute the matter and form of a creative work for a defined time period." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/computation/ValidationTestVersion> <https://openminds.ebrains.eu/computation/WorkflowRecipeVersion> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/SoftwareVersion> <https://openminds.ebrains.eu/core/WebServiceVersion> <https://openminds.ebrains.eu/publications/Book> <https://openminds.ebrains.eu/publications/Chapter> <https://openminds.ebrains.eu/publications/LearningResource> <https://openminds.ebrains.eu/publications/LivePaperVersion> <https://openminds.ebrains.eu/publications/ScholarlyArticle> <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CommonCoordinateSpaceVersion> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/core/Copyright> .

