<https://openminds.ebrains.eu/vocab/majorVersionIdentifier> a owl:DatatypeProperty ;
    rdfs:label "Major version identifier" ;
    rdfs:domain <https://openminds.ebrains.eu/sands/BrainAtlasVersion> ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/ontologyIdentifier> a owl:DatatypeProperty ;
    rdfs:label "Ontology identifier" ;
    rdfs:comment "Term or code used to identify something or someone registered within a particular ontology." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Strain> <https://openminds.ebrains.eu/sands/BrainAtlas> <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CommonCoordinateSpace> <https://openminds.ebrains.eu/sands/CommonCoordinateSpaceVersion> <https://openminds.ebrains.eu/sands/ParcellationEntity> <https://openminds.ebrains.eu/sands/ParcellationEntityVersion> <https://openminds.ebrains.eu/sands/ParcellationTerminology> <https://openminds.ebrains.eu/sands/ParcellationTerminologyVersion> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/accessibility> a owl:ObjectProperty ;
    rdfs:label "Accessibility" ;
    rdfs:comment "Level to which something is accessible to someone or something." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/computation/ValidationTestVersion> <https://openminds.ebrains.eu/computation/WorkflowRecipeVersion> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/SoftwareVersion> <https://openminds.ebrains.eu/core/WebServiceVersion> <https://openminds.ebrains.eu/publications/LivePaperVersion> <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CommonCoordinateSpaceVersion> ) ] ;
