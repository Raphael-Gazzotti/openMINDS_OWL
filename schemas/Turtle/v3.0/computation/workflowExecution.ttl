@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/configuration> a owl:ObjectProperty ;
    rdfs:label "Configuration" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/computation/Environment> <https://openminds.ebrains.eu/computation/ValidationTestVersion> <https://openminds.ebrains.eu/computation/WorkflowExecution> <https://openminds.ebrains.eu/core/Configuration> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Configuration> <https://openminds.ebrains.eu/core/File> <https://openminds.ebrains.eu/core/PropertyValueList> <https://openminds.ebrains.eu/core/WebResource> ) ] .

<https://openminds.ebrains.eu/vocab/recipe> a owl:ObjectProperty ;
    rdfs:label "Recipe" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/computation/DataAnalysis> <https://openminds.ebrains.eu/computation/DataCopy> <https://openminds.ebrains.eu/computation/GenericComputation> <https://openminds.ebrains.eu/computation/ModelValidation> <https://openminds.ebrains.eu/computation/Optimization> <https://openminds.ebrains.eu/computation/Simulation> <https://openminds.ebrains.eu/computation/Visualization> <https://openminds.ebrains.eu/computation/WorkflowExecution> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/computation/WorkflowRecipeVersion> .

<https://openminds.ebrains.eu/vocab/stage> a owl:ObjectProperty ;
    rdfs:label "Stage" ;
    rdfs:domain <https://openminds.ebrains.eu/computation/WorkflowExecution> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/computation/DataAnalysis> <https://openminds.ebrains.eu/computation/DataCopy> <https://openminds.ebrains.eu/computation/GenericComputation> <https://openminds.ebrains.eu/computation/ModelValidation> <https://openminds.ebrains.eu/computation/Optimization> <https://openminds.ebrains.eu/computation/Simulation> <https://openminds.ebrains.eu/computation/Visualization> ) ] .

<https://openminds.ebrains.eu/vocab/startedBy> a owl:ObjectProperty ;
    rdfs:label "Started by" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/computation/DataAnalysis> <https://openminds.ebrains.eu/computation/DataCopy> <https://openminds.ebrains.eu/computation/GenericComputation> <https://openminds.ebrains.eu/computation/ModelValidation> <https://openminds.ebrains.eu/computation/Optimization> <https://openminds.ebrains.eu/computation/Simulation> <https://openminds.ebrains.eu/computation/Visualization> <https://openminds.ebrains.eu/computation/WorkflowExecution> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/computation/SoftwareAgent> <https://openminds.ebrains.eu/core/Person> ) ] .

<https://openminds.ebrains.eu/computation/WorkflowExecution> a owl:Class ;
    rdfs:label "Workflow execution" ;
    rdfs:comment "Structured information about an execution of a computational workflow." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/computation/WorkflowRecipeVersion> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/recipe> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/core/Configuration> <https://openminds.ebrains.eu/core/File> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/configuration> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/computation/DataAnalysis> <https://openminds.ebrains.eu/computation/DataCopy> <https://openminds.ebrains.eu/computation/GenericComputation> <https://openminds.ebrains.eu/computation/ModelValidation> <https://openminds.ebrains.eu/computation/Optimization> <https://openminds.ebrains.eu/computation/Simulation> <https://openminds.ebrains.eu/computation/Visualization> ) ] ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/stage> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/computation/SoftwareAgent> <https://openminds.ebrains.eu/core/Person> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/startedBy> ] .

