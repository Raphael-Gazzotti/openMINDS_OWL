@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/amount> a owl:ObjectProperty ;
    rdfs:label "Amount" ;
    rdfs:domain <https://openminds.ebrains.eu/chemicals/AmountOfChemical> ;
    rdfs:range <https://openminds.ebrains.eu/core/QuantitativeValue> .

<https://openminds.ebrains.eu/vocab/chemicalProduct> a owl:ObjectProperty ;
    rdfs:label "Chemical product" ;
    rdfs:domain <https://openminds.ebrains.eu/chemicals/AmountOfChemical> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/chemicals/ChemicalMixture> <https://openminds.ebrains.eu/chemicals/ChemicalSubstance> <https://openminds.ebrains.eu/controlledTerms/MolecularEntity> ) ] .

<https://openminds.ebrains.eu/chemicals/AmountOfChemical> a owl:Class ;
    rdfs:label "Amount of chemical" ;
    rdfs:comment "Structured information about the amount of a given chemical that was used." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/chemicals/ChemicalMixture> <https://openminds.ebrains.eu/chemicals/ChemicalSubstance> <https://openminds.ebrains.eu/controlledTerms/MolecularEntity> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/chemicalProduct> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/QuantitativeValue> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/amount> ] .

