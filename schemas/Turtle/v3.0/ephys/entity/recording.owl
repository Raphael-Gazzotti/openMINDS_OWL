@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/additionalRemarks> a owl:DatatypeProperty ;
    rdfs:label "Additional remarks" ;
    rdfs:comment "Mention of what deserves additional attention or notice." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/chemicals/ChemicalMixture> <https://openminds.ebrains.eu/chemicals/ChemicalSubstance> <https://openminds.ebrains.eu/core/Measurement> <https://openminds.ebrains.eu/core/SubjectGroup> <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> <https://openminds.ebrains.eu/core/TissueSampleCollection> <https://openminds.ebrains.eu/core/TissueSampleCollectionState> <https://openminds.ebrains.eu/core/TissueSampleState> <https://openminds.ebrains.eu/ephys/Recording> <https://openminds.ebrains.eu/sands/AnatomicalTargetPosition> <https://openminds.ebrains.eu/sands/ParcellationEntityVersion> <https://openminds.ebrains.eu/sands/ViewerSpecification> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/internalIdentifier> a owl:DatatypeProperty ;
    rdfs:label "Internal identifier" ;
    rdfs:comment "Term or code that identifies someone or something within a particular product." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/BehavioralProtocol> <https://openminds.ebrains.eu/core/Subject> <https://openminds.ebrains.eu/core/SubjectGroup> <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> <https://openminds.ebrains.eu/core/TissueSample> <https://openminds.ebrains.eu/core/TissueSampleCollection> <https://openminds.ebrains.eu/core/TissueSampleCollectionState> <https://openminds.ebrains.eu/core/TissueSampleState> <https://openminds.ebrains.eu/ephys/Channel> <https://openminds.ebrains.eu/ephys/Electrode> <https://openminds.ebrains.eu/ephys/ElectrodeArray> <https://openminds.ebrains.eu/ephys/Pipette> <https://openminds.ebrains.eu/ephys/Recording> <https://openminds.ebrains.eu/ephys/RecordingActivity> <https://openminds.ebrains.eu/sands/AtlasAnnotation> <https://openminds.ebrains.eu/sands/CustomAnnotation> <https://openminds.ebrains.eu/stimulation/EphysStimulus> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/name> a owl:DatatypeProperty ;
    rdfs:label "Name" ;
    rdfs:comment "Word or phrase that constitutes the distinctive designation of a being or thing." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/chemicals/ChemicalMixture> <https://openminds.ebrains.eu/computation/Environment> <https://openminds.ebrains.eu/computation/HardwareSystem> <https://openminds.ebrains.eu/computation/LaunchConfiguration> <https://openminds.ebrains.eu/computation/LocalFile> <https://openminds.ebrains.eu/computation/SoftwareAgent> <https://openminds.ebrains.eu/controlledTerms/ActionStatusType> <https://openminds.ebrains.eu/controlledTerms/AgeCategory> <https://openminds.ebrains.eu/controlledTerms/AnalysisTechnique> <https://openminds.ebrains.eu/controlledTerms/AnatomicalAxesOrientation> <https://openminds.ebrains.eu/controlledTerms/AnatomicalIdentificationType> <https://openminds.ebrains.eu/controlledTerms/AnatomicalPlane> <https://openminds.ebrains.eu/controlledTerms/AnnotationCriteriaType> <https://openminds.ebrains.eu/controlledTerms/AnnotationType> <https://openminds.ebrains.eu/controlledTerms/AtlasType> <https://openminds.ebrains.eu/controlledTerms/AuditoryStimulusType> <https://openminds.ebrains.eu/controlledTerms/BiologicalOrder> <https://openminds.ebrains.eu/controlledTerms/BiologicalProcess> <https://openminds.ebrains.eu/controlledTerms/BiologicalSex> <https://openminds.ebrains.eu/controlledTerms/BreedingType> <https://openminds.ebrains.eu/controlledTerms/CellCultureType> <https://openminds.ebrains.eu/controlledTerms/CellType> <https://openminds.ebrains.eu/controlledTerms/ChemicalMixtureType> <https://openminds.ebrains.eu/controlledTerms/Colormap> <https://openminds.ebrains.eu/controlledTerms/ContributionType> <https://openminds.ebrains.eu/controlledTerms/CranialWindowConstructionType> <https://openminds.ebrains.eu/controlledTerms/CranialWindowReinforcementType> <https://openminds.ebrains.eu/controlledTerms/CriteriaQualityType> <https://openminds.ebrains.eu/controlledTerms/DataType> <https://openminds.ebrains.eu/controlledTerms/DeviceType> <https://openminds.ebrains.eu/controlledTerms/DifferenceMeasure> <https://openminds.ebrains.eu/controlledTerms/Disease> <https://openminds.ebrains.eu/controlledTerms/DiseaseModel> <https://openminds.ebrains.eu/controlledTerms/EducationalLevel> <https://openminds.ebrains.eu/controlledTerms/ElectricalStimulusType> <https://openminds.ebrains.eu/controlledTerms/EthicsAssessment> <https://openminds.ebrains.eu/controlledTerms/ExperimentalApproach> <https://openminds.ebrains.eu/controlledTerms/FileBundleGrouping> <https://openminds.ebrains.eu/controlledTerms/FileRepositoryType> <https://openminds.ebrains.eu/controlledTerms/FileUsageRole> <https://openminds.ebrains.eu/controlledTerms/GeneticStrainType> <https://openminds.ebrains.eu/controlledTerms/GustatoryStimulusType> <https://openminds.ebrains.eu/controlledTerms/Handedness> <https://openminds.ebrains.eu/controlledTerms/Language> <https://openminds.ebrains.eu/controlledTerms/Laterality> <https://openminds.ebrains.eu/controlledTerms/LearningResourceType> <https://openminds.ebrains.eu/controlledTerms/MeasuredQuantity> <https://openminds.ebrains.eu/controlledTerms/MeasuredSignalType> <https://openminds.ebrains.eu/controlledTerms/MetaDataModelType> <https://openminds.ebrains.eu/controlledTerms/ModelAbstractionLevel> <https://openminds.ebrains.eu/controlledTerms/ModelScope> <https://openminds.ebrains.eu/controlledTerms/MolecularEntity> <https://openminds.ebrains.eu/controlledTerms/OlfactoryStimulusType> <https://openminds.ebrains.eu/controlledTerms/OperatingDevice> <https://openminds.ebrains.eu/controlledTerms/OperatingSystem> <https://openminds.ebrains.eu/controlledTerms/OpticalStimulusType> <https://openminds.ebrains.eu/controlledTerms/Organ> <https://openminds.ebrains.eu/controlledTerms/OrganismSubstance> <https://openminds.ebrains.eu/controlledTerms/OrganismSystem> <https://openminds.ebrains.eu/controlledTerms/PatchClampVariation> <https://openminds.ebrains.eu/controlledTerms/PreparationType> <https://openminds.ebrains.eu/controlledTerms/ProductAccessibility> <https://openminds.ebrains.eu/controlledTerms/ProgrammingLanguage> <https://openminds.ebrains.eu/controlledTerms/QualitativeOverlap> <https://openminds.ebrains.eu/controlledTerms/SemanticDataType> <https://openminds.ebrains.eu/controlledTerms/Service> <https://openminds.ebrains.eu/controlledTerms/SetupType> <https://openminds.ebrains.eu/controlledTerms/SoftwareApplicationCategory> <https://openminds.ebrains.eu/controlledTerms/SoftwareFeature> <https://openminds.ebrains.eu/controlledTerms/Species> <https://openminds.ebrains.eu/controlledTerms/StimulationApproach> <https://openminds.ebrains.eu/controlledTerms/StimulationTechnique> <https://openminds.ebrains.eu/controlledTerms/SubcellularEntity> <https://openminds.ebrains.eu/controlledTerms/SubjectAttribute> <https://openminds.ebrains.eu/controlledTerms/TactileStimulusType> <https://openminds.ebrains.eu/controlledTerms/Technique> <https://openminds.ebrains.eu/controlledTerms/TermSuggestion> <https://openminds.ebrains.eu/controlledTerms/Terminology> <https://openminds.ebrains.eu/controlledTerms/TissueSampleAttribute> <https://openminds.ebrains.eu/controlledTerms/TissueSampleType> <https://openminds.ebrains.eu/controlledTerms/TypeOfUncertainty> <https://openminds.ebrains.eu/controlledTerms/UBERONParcellation> <https://openminds.ebrains.eu/controlledTerms/UnitOfMeasurement> <https://openminds.ebrains.eu/controlledTerms/VisualStimulusType> <https://openminds.ebrains.eu/core/BehavioralProtocol> <https://openminds.ebrains.eu/core/ContentType> <https://openminds.ebrains.eu/core/File> <https://openminds.ebrains.eu/core/FileBundle> <https://openminds.ebrains.eu/core/FileRepository> <https://openminds.ebrains.eu/core/NumericalProperty> <https://openminds.ebrains.eu/core/Protocol> <https://openminds.ebrains.eu/core/Setup> <https://openminds.ebrains.eu/core/Strain> <https://openminds.ebrains.eu/core/StringProperty> <https://openminds.ebrains.eu/ephys/Electrode> <https://openminds.ebrains.eu/ephys/ElectrodeArray> <https://openminds.ebrains.eu/ephys/Pipette> <https://openminds.ebrains.eu/ephys/Recording> <https://openminds.ebrains.eu/publications/Book> <https://openminds.ebrains.eu/publications/Chapter> <https://openminds.ebrains.eu/publications/LearningResource> <https://openminds.ebrains.eu/publications/LivePaperResourceItem> <https://openminds.ebrains.eu/publications/LivePaperSection> <https://openminds.ebrains.eu/publications/Periodical> <https://openminds.ebrains.eu/publications/ScholarlyArticle> <https://openminds.ebrains.eu/sands/CustomAnatomicalEntity> <https://openminds.ebrains.eu/sands/CustomCoordinateSpace> <https://openminds.ebrains.eu/sands/ParcellationEntity> <https://openminds.ebrains.eu/sands/ParcellationEntityVersion> <https://openminds.ebrains.eu/specimenPrep/SlicingDevice> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/channel> a owl:ObjectProperty ;
    rdfs:label "Channel" ;
    rdfs:domain <https://openminds.ebrains.eu/ephys/Recording> ;
    rdfs:range <https://openminds.ebrains.eu/ephys/Channel> .

<https://openminds.ebrains.eu/vocab/dataLocation> a owl:ObjectProperty ;
    rdfs:label "Data location" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/CustomPropertySet> <https://openminds.ebrains.eu/core/ServiceLink> <https://openminds.ebrains.eu/ephys/Recording> <https://openminds.ebrains.eu/sands/ParcellationTerminology> <https://openminds.ebrains.eu/sands/ParcellationTerminologyVersion> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Configuration> <https://openminds.ebrains.eu/core/File> <https://openminds.ebrains.eu/core/FileArchive> <https://openminds.ebrains.eu/core/FileBundle> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/PropertyValueList> <https://openminds.ebrains.eu/publications/LivePaperResourceItem> <https://openminds.ebrains.eu/sands/ParcellationEntityVersion> ) ] .

<https://openminds.ebrains.eu/vocab/previousRecording> a owl:ObjectProperty ;
    rdfs:label "Previous recording" ;
    rdfs:domain <https://openminds.ebrains.eu/ephys/Recording> ;
    rdfs:range <https://openminds.ebrains.eu/ephys/Recording> .

<https://openminds.ebrains.eu/vocab/recordedWith> a owl:ObjectProperty ;
    rdfs:label "Recorded with" ;
    rdfs:domain <https://openminds.ebrains.eu/ephys/Recording> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/ephys/ElectrodeArrayUsage> <https://openminds.ebrains.eu/ephys/ElectrodeUsage> <https://openminds.ebrains.eu/ephys/PipetteUsage> <https://openminds.ebrains.eu/specimenPrep/SlicingDeviceUsage> ) ] .

<https://openminds.ebrains.eu/vocab/samplingFrequency> a owl:ObjectProperty ;
    rdfs:label "Sampling frequency" ;
    rdfs:domain <https://openminds.ebrains.eu/ephys/Recording> ;
    rdfs:range <https://openminds.ebrains.eu/core/QuantitativeValue> .

<https://openminds.ebrains.eu/ephys/Recording> a owl:Class ;
    rdfs:label "Recording" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/QuantitativeValue> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/samplingFrequency> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/ephys/Recording> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/previousRecording> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/ephys/ElectrodeArrayUsage> <https://openminds.ebrains.eu/ephys/ElectrodeUsage> <https://openminds.ebrains.eu/ephys/PipetteUsage> <https://openminds.ebrains.eu/specimenPrep/SlicingDeviceUsage> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/recordedWith> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/ephys/Channel> ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/channel> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/core/File> <https://openminds.ebrains.eu/core/FileBundle> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/dataLocation> ] .

