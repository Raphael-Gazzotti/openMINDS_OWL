@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/homepage> a owl:DatatypeProperty ;
    rdfs:label "Homepage" ;
    rdfs:comment "Main website of something or someone." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/computation/ValidationTest> <https://openminds.ebrains.eu/computation/ValidationTestVersion> <https://openminds.ebrains.eu/computation/WorkflowRecipe> <https://openminds.ebrains.eu/computation/WorkflowRecipeVersion> <https://openminds.ebrains.eu/core/Consortium> <https://openminds.ebrains.eu/core/Dataset> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/MetaDataModel> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/Model> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/Organization> <https://openminds.ebrains.eu/core/Project> <https://openminds.ebrains.eu/core/Software> <https://openminds.ebrains.eu/core/SoftwareVersion> <https://openminds.ebrains.eu/core/WebService> <https://openminds.ebrains.eu/core/WebServiceVersion> <https://openminds.ebrains.eu/publications/LivePaper> <https://openminds.ebrains.eu/publications/LivePaperVersion> <https://openminds.ebrains.eu/sands/BrainAtlas> <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CommonCoordinateSpace> <https://openminds.ebrains.eu/sands/CommonCoordinateSpaceVersion> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/shortName> a owl:DatatypeProperty ;
    rdfs:label "Short name" ;
    rdfs:comment "Shortened or fully abbreviated name of something or somebody." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/computation/ValidationTest> <https://openminds.ebrains.eu/computation/ValidationTestVersion> <https://openminds.ebrains.eu/computation/WorkflowRecipe> <https://openminds.ebrains.eu/computation/WorkflowRecipeVersion> <https://openminds.ebrains.eu/core/Consortium> <https://openminds.ebrains.eu/core/Dataset> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/License> <https://openminds.ebrains.eu/core/MetaDataModel> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/Model> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/Organization> <https://openminds.ebrains.eu/core/Project> <https://openminds.ebrains.eu/core/Software> <https://openminds.ebrains.eu/core/SoftwareVersion> <https://openminds.ebrains.eu/core/WebService> <https://openminds.ebrains.eu/core/WebServiceVersion> <https://openminds.ebrains.eu/publications/LivePaper> <https://openminds.ebrains.eu/publications/LivePaperVersion> <https://openminds.ebrains.eu/sands/BrainAtlas> <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CommonCoordinateSpace> <https://openminds.ebrains.eu/sands/CommonCoordinateSpaceVersion> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/affiliation> a owl:ObjectProperty ;
    rdfs:label "Affiliation" ;
    rdfs:comment "Declaration of a person being closely associated to an organization." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Organization> <https://openminds.ebrains.eu/core/Person> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/core/Affiliation> .

<https://openminds.ebrains.eu/vocab/digitalIdentifier> a owl:ObjectProperty ;
    rdfs:label "Digital identifier" ;
    rdfs:comment "Digital handle to identify objects or legal persons." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/chemicals/ProductSource> <https://openminds.ebrains.eu/computation/ValidationTest> <https://openminds.ebrains.eu/computation/ValidationTestVersion> <https://openminds.ebrains.eu/computation/WorkflowRecipe> <https://openminds.ebrains.eu/computation/WorkflowRecipeVersion> <https://openminds.ebrains.eu/core/Dataset> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/MetaDataModel> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/Model> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/Organization> <https://openminds.ebrains.eu/core/Person> <https://openminds.ebrains.eu/core/Software> <https://openminds.ebrains.eu/core/SoftwareVersion> <https://openminds.ebrains.eu/core/Strain> <https://openminds.ebrains.eu/ephys/Electrode> <https://openminds.ebrains.eu/ephys/ElectrodeArray> <https://openminds.ebrains.eu/ephys/Pipette> <https://openminds.ebrains.eu/publications/Book> <https://openminds.ebrains.eu/publications/Chapter> <https://openminds.ebrains.eu/publications/LearningResource> <https://openminds.ebrains.eu/publications/LivePaper> <https://openminds.ebrains.eu/publications/LivePaperVersion> <https://openminds.ebrains.eu/publications/Periodical> <https://openminds.ebrains.eu/publications/ScholarlyArticle> <https://openminds.ebrains.eu/sands/BrainAtlas> <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CommonCoordinateSpace> <https://openminds.ebrains.eu/sands/CommonCoordinateSpaceVersion> <https://openminds.ebrains.eu/specimenPrep/SlicingDevice> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/DOI> <https://openminds.ebrains.eu/core/GRIDID> <https://openminds.ebrains.eu/core/ISBN> <https://openminds.ebrains.eu/core/ISSN> <https://openminds.ebrains.eu/core/IdentifiersDotOrgID> <https://openminds.ebrains.eu/core/ORCID> <https://openminds.ebrains.eu/core/RORID> <https://openminds.ebrains.eu/core/RRID> <https://openminds.ebrains.eu/core/SWHID> ) ] .

<https://openminds.ebrains.eu/vocab/fullName> a owl:DatatypeProperty ;
    rdfs:label "Full name" ;
    rdfs:comment "Whole, non-abbreviated name of something or somebody." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/computation/ValidationTest> <https://openminds.ebrains.eu/computation/ValidationTestVersion> <https://openminds.ebrains.eu/computation/WorkflowRecipe> <https://openminds.ebrains.eu/computation/WorkflowRecipeVersion> <https://openminds.ebrains.eu/core/Consortium> <https://openminds.ebrains.eu/core/Dataset> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/License> <https://openminds.ebrains.eu/core/MetaDataModel> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/Model> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/Organization> <https://openminds.ebrains.eu/core/Project> <https://openminds.ebrains.eu/core/Software> <https://openminds.ebrains.eu/core/SoftwareVersion> <https://openminds.ebrains.eu/core/WebService> <https://openminds.ebrains.eu/core/WebServiceVersion> <https://openminds.ebrains.eu/publications/LivePaper> <https://openminds.ebrains.eu/publications/LivePaperVersion> <https://openminds.ebrains.eu/sands/BrainAtlas> <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CommonCoordinateSpace> <https://openminds.ebrains.eu/sands/CommonCoordinateSpaceVersion> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/hasParent> a owl:ObjectProperty ;
    rdfs:label "Has parent" ;
    rdfs:comment "Reference to a parent object or legal person." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Organization> <https://openminds.ebrains.eu/sands/ParcellationEntity> <https://openminds.ebrains.eu/sands/ParcellationEntityVersion> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Organization> <https://openminds.ebrains.eu/sands/ParcellationEntity> <https://openminds.ebrains.eu/sands/ParcellationEntityVersion> ) ] .

<https://openminds.ebrains.eu/core/Organization> a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An entity comprised of one or more natural persons with a particular purpose. [adapted from Wikipedia](https://en.wikipedia.org/wiki/Organization)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/Organization> ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/hasParent> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/core/GRIDID> <https://openminds.ebrains.eu/core/RORID> <https://openminds.ebrains.eu/core/RRID> ) ] ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/digitalIdentifier> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/Affiliation> ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/affiliation> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/fullName> ] .

