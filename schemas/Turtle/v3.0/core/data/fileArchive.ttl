@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/IRI> a owl:DatatypeProperty ;
    rdfs:label "Iri" ;
    rdfs:comment "Stands for Internationalized Resource Identifier which is an internet protocol standard that builds on the URI protocol, extending the set of permitted characters to include Unicode/ISO 10646." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/File> <https://openminds.ebrains.eu/core/FileArchive> <https://openminds.ebrains.eu/core/FileRepository> <https://openminds.ebrains.eu/core/WebResource> <https://openminds.ebrains.eu/publications/Book> <https://openminds.ebrains.eu/publications/Chapter> <https://openminds.ebrains.eu/publications/LearningResource> <https://openminds.ebrains.eu/publications/LivePaperResourceItem> <https://openminds.ebrains.eu/publications/ScholarlyArticle> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/format> a owl:ObjectProperty ;
    rdfs:label "Format" ;
    rdfs:comment "Method of digitally organizing and structuring data or information." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/computation/LocalFile> <https://openminds.ebrains.eu/computation/ValidationTestVersion> <https://openminds.ebrains.eu/computation/WorkflowRecipeVersion> <https://openminds.ebrains.eu/core/Configuration> <https://openminds.ebrains.eu/core/File> <https://openminds.ebrains.eu/core/FileArchive> <https://openminds.ebrains.eu/core/FileBundle> <https://openminds.ebrains.eu/core/FileRepository> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/WebResource> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/core/ContentType> .

<https://openminds.ebrains.eu/vocab/sourceData> a owl:ObjectProperty ;
    rdfs:label "Source data" ;
    rdfs:domain <https://openminds.ebrains.eu/core/FileArchive> ;
    rdfs:range <https://openminds.ebrains.eu/core/File> .

<https://openminds.ebrains.eu/core/FileArchive> a owl:Class ;
    rdfs:label "File archive" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/IRI> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/ContentType> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/format> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/File> ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/sourceData> ] .

