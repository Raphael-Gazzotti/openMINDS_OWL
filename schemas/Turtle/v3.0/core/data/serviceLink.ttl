@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/displayLabel> a owl:DatatypeProperty ;
    rdfs:label "Display label" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/ContentType> <https://openminds.ebrains.eu/core/ServiceLink> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/dataLocation> a owl:ObjectProperty ;
    rdfs:label "Data location" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/CustomPropertySet> <https://openminds.ebrains.eu/core/ServiceLink> <https://openminds.ebrains.eu/ephys/Recording> <https://openminds.ebrains.eu/sands/ParcellationTerminology> <https://openminds.ebrains.eu/sands/ParcellationTerminologyVersion> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Configuration> <https://openminds.ebrains.eu/core/File> <https://openminds.ebrains.eu/core/FileArchive> <https://openminds.ebrains.eu/core/FileBundle> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/PropertyValueList> <https://openminds.ebrains.eu/publications/LivePaperResourceItem> <https://openminds.ebrains.eu/sands/ParcellationEntityVersion> ) ] .

<https://openminds.ebrains.eu/vocab/openDataIn> a owl:DatatypeProperty ;
    rdfs:label "Open data in" ;
    rdfs:domain <https://openminds.ebrains.eu/core/ServiceLink> ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/previewImage> a owl:ObjectProperty ;
    rdfs:label "Preview image" ;
    rdfs:domain <https://openminds.ebrains.eu/core/ServiceLink> ;
    rdfs:range <https://openminds.ebrains.eu/core/File> .

<https://openminds.ebrains.eu/vocab/service> a owl:ObjectProperty ;
    rdfs:label "Service" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/AccountInformation> <https://openminds.ebrains.eu/core/ServiceLink> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/controlledTerms/Service> <https://openminds.ebrains.eu/core/WebService> ) ] .

<https://openminds.ebrains.eu/core/ServiceLink> a owl:Class ;
    rdfs:label "Service link" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/core/File> <https://openminds.ebrains.eu/core/FileArchive> <https://openminds.ebrains.eu/core/FileBundle> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/publications/LivePaperResourceItem> <https://openminds.ebrains.eu/sands/ParcellationEntityVersion> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/dataLocation> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/controlledTerms/Service> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/service> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/core/File> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/previewImage> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/openDataIn> ] .

