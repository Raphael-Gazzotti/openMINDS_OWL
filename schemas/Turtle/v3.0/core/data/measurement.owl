@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/additionalRemarks> a owl:DatatypeProperty ;
    rdfs:label "Additional remarks" ;
    rdfs:comment "Mention of what deserves additional attention or notice." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/chemicals/ChemicalMixture> <https://openminds.ebrains.eu/chemicals/ChemicalSubstance> <https://openminds.ebrains.eu/core/Measurement> <https://openminds.ebrains.eu/core/SubjectGroup> <https://openminds.ebrains.eu/core/SubjectGroupState> <https://openminds.ebrains.eu/core/SubjectState> <https://openminds.ebrains.eu/core/TissueSampleCollection> <https://openminds.ebrains.eu/core/TissueSampleCollectionState> <https://openminds.ebrains.eu/core/TissueSampleState> <https://openminds.ebrains.eu/ephys/Recording> <https://openminds.ebrains.eu/sands/AnatomicalTargetPosition> <https://openminds.ebrains.eu/sands/ParcellationEntityVersion> <https://openminds.ebrains.eu/sands/ViewerSpecification> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/timestamp> a owl:DatatypeProperty ;
    rdfs:label "Timestamp" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Comment> <https://openminds.ebrains.eu/core/Measurement> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/measuredQuantity> a owl:ObjectProperty ;
    rdfs:label "Measured quantity" ;
    rdfs:domain <https://openminds.ebrains.eu/core/Measurement> ;
    rdfs:range <https://openminds.ebrains.eu/controlledTerms/MeasuredQuantity> .

<https://openminds.ebrains.eu/vocab/measuredWith> a owl:ObjectProperty ;
    rdfs:label "Measured with" ;
    rdfs:domain <https://openminds.ebrains.eu/core/Measurement> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/ephys/ElectrodeArrayUsage> <https://openminds.ebrains.eu/ephys/ElectrodeUsage> <https://openminds.ebrains.eu/ephys/PipetteUsage> <https://openminds.ebrains.eu/specimenPrep/SlicingDeviceUsage> ) ] .

<https://openminds.ebrains.eu/vocab/value> a owl:ObjectProperty ;
    rdfs:label "Value" ;
    rdfs:comment "Entry for a property." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Measurement> <https://openminds.ebrains.eu/core/NumericalProperty> <https://openminds.ebrains.eu/core/QuantitativeValue> <https://openminds.ebrains.eu/core/StringProperty> <https://openminds.ebrains.eu/sands/SingleColor> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/QuantitativeValue> <https://openminds.ebrains.eu/core/QuantitativeValueRange> ) ] .

<https://openminds.ebrains.eu/core/Measurement> a owl:Class ;
    rdfs:label "Measurement" ;
    rdfs:comment "Structured information about a measurement performed during a scientific experiment." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/ephys/ElectrodeArrayUsage> <https://openminds.ebrains.eu/ephys/ElectrodeUsage> <https://openminds.ebrains.eu/ephys/PipetteUsage> <https://openminds.ebrains.eu/specimenPrep/SlicingDeviceUsage> ) ] ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/measuredWith> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/core/QuantitativeValue> <https://openminds.ebrains.eu/core/QuantitativeValueRange> ) ] ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/controlledTerms/MeasuredQuantity> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/measuredQuantity> ] .

