@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/maxValue> a owl:DatatypeProperty ;
    rdfs:label "Max value" ;
    rdfs:comment "Greatest quantity attained or allowed." ;
    rdfs:domain <https://openminds.ebrains.eu/core/QuantitativeValueRange> ;
    rdfs:range xsd:decimal .

<https://openminds.ebrains.eu/vocab/maxValueUnit> a owl:ObjectProperty ;
    rdfs:label "Max value unit" ;
    rdfs:domain <https://openminds.ebrains.eu/core/QuantitativeValueRange> ;
    rdfs:range <https://openminds.ebrains.eu/controlledTerms/UnitOfMeasurement> .

<https://openminds.ebrains.eu/vocab/minValue> a owl:DatatypeProperty ;
    rdfs:label "Min value" ;
    rdfs:comment "Smallest quantity attained or allowed." ;
    rdfs:domain <https://openminds.ebrains.eu/core/QuantitativeValueRange> ;
    rdfs:range xsd:decimal .

<https://openminds.ebrains.eu/vocab/minValueUnit> a owl:ObjectProperty ;
    rdfs:label "Min value unit" ;
    rdfs:domain <https://openminds.ebrains.eu/core/QuantitativeValueRange> ;
    rdfs:range <https://openminds.ebrains.eu/controlledTerms/UnitOfMeasurement> .

<https://openminds.ebrains.eu/core/QuantitativeValueRange> a owl:Class ;
    rdfs:label "Quantitative value range" ;
    rdfs:comment "A representation of a range of quantitative values." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/controlledTerms/UnitOfMeasurement> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/minValueUnit> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://openminds.ebrains.eu/controlledTerms/UnitOfMeasurement> ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/maxValueUnit> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/minValue> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/maxValue> ] .

