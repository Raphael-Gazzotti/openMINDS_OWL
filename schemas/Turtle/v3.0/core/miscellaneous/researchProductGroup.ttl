@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/context> a owl:DatatypeProperty ;
    rdfs:label "Context" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/CustomPropertySet> <https://openminds.ebrains.eu/core/ResearchProductGroup> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/hasPart> a owl:ObjectProperty ;
    rdfs:label "Has part" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/chemicals/ChemicalMixture> <https://openminds.ebrains.eu/computation/WorkflowRecipeVersion> <https://openminds.ebrains.eu/core/Project> <https://openminds.ebrains.eu/core/ResearchProductGroup> <https://openminds.ebrains.eu/core/Setup> <https://openminds.ebrains.eu/core/SoftwareVersion> <https://openminds.ebrains.eu/core/WebServiceVersion> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/chemicals/AmountOfChemical> <https://openminds.ebrains.eu/computation/ValidationTest> <https://openminds.ebrains.eu/computation/ValidationTestVersion> <https://openminds.ebrains.eu/computation/WorkflowRecipe> <https://openminds.ebrains.eu/computation/WorkflowRecipeVersion> <https://openminds.ebrains.eu/core/Dataset> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/File> <https://openminds.ebrains.eu/core/FileBundle> <https://openminds.ebrains.eu/core/MetaDataModel> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/Model> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/Setup> <https://openminds.ebrains.eu/core/Software> <https://openminds.ebrains.eu/core/SoftwareVersion> <https://openminds.ebrains.eu/core/WebService> <https://openminds.ebrains.eu/core/WebServiceVersion> <https://openminds.ebrains.eu/ephys/Electrode> <https://openminds.ebrains.eu/ephys/ElectrodeArray> <https://openminds.ebrains.eu/ephys/Pipette> <https://openminds.ebrains.eu/publications/LivePaper> <https://openminds.ebrains.eu/publications/LivePaperVersion> <https://openminds.ebrains.eu/sands/BrainAtlas> <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CommonCoordinateSpace> <https://openminds.ebrains.eu/sands/CommonCoordinateSpaceVersion> <https://openminds.ebrains.eu/specimenPrep/SlicingDevice> ) ] .

<https://openminds.ebrains.eu/core/ResearchProductGroup> a owl:Class ;
    rdfs:label "Research product group" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( <https://openminds.ebrains.eu/computation/ValidationTest> <https://openminds.ebrains.eu/computation/ValidationTestVersion> <https://openminds.ebrains.eu/computation/WorkflowRecipe> <https://openminds.ebrains.eu/computation/WorkflowRecipeVersion> <https://openminds.ebrains.eu/core/Dataset> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/MetaDataModel> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/Model> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/Software> <https://openminds.ebrains.eu/core/SoftwareVersion> <https://openminds.ebrains.eu/core/WebService> <https://openminds.ebrains.eu/core/WebServiceVersion> <https://openminds.ebrains.eu/publications/LivePaper> <https://openminds.ebrains.eu/publications/LivePaperVersion> <https://openminds.ebrains.eu/sands/BrainAtlas> <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CommonCoordinateSpace> <https://openminds.ebrains.eu/sands/CommonCoordinateSpaceVersion> ) ] ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/hasPart> ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty <https://openminds.ebrains.eu/vocab/context> ] .

