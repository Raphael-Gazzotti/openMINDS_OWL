@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://openminds.ebrains.eu/vocab/IRI> a owl:DatatypeProperty ;
    rdfs:label "Iri" ;
    rdfs:comment "Stands for Internationalized Resource Identifier which is an internet protocol standard that builds on the URI protocol, extending the set of permitted characters to include Unicode/ISO 10646." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/File> <https://openminds.ebrains.eu/core/FileArchive> <https://openminds.ebrains.eu/core/FileRepository> <https://openminds.ebrains.eu/core/WebResource> <https://openminds.ebrains.eu/publications/Book> <https://openminds.ebrains.eu/publications/Chapter> <https://openminds.ebrains.eu/publications/LearningResource> <https://openminds.ebrains.eu/publications/LivePaperResourceItem> <https://openminds.ebrains.eu/publications/ScholarlyArticle> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/abstract> a owl:DatatypeProperty ;
    rdfs:label "Abstract" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/publications/Book> <https://openminds.ebrains.eu/publications/Chapter> <https://openminds.ebrains.eu/publications/LearningResource> <https://openminds.ebrains.eu/publications/ScholarlyArticle> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/creationDate> a owl:DatatypeProperty ;
    rdfs:label "Creation date" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/publications/Book> <https://openminds.ebrains.eu/publications/Chapter> <https://openminds.ebrains.eu/publications/LearningResource> <https://openminds.ebrains.eu/publications/ScholarlyArticle> ) ] ;
    rdfs:range xsd:date .

<https://openminds.ebrains.eu/vocab/modificationDate> a owl:DatatypeProperty ;
    rdfs:label "Modification date" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/publications/Book> <https://openminds.ebrains.eu/publications/Chapter> <https://openminds.ebrains.eu/publications/LearningResource> <https://openminds.ebrains.eu/publications/LivePaperVersion> <https://openminds.ebrains.eu/publications/ScholarlyArticle> ) ] ;
    rdfs:range xsd:date .

<https://openminds.ebrains.eu/vocab/pagination> a owl:DatatypeProperty ;
    rdfs:label "Pagination" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/publications/Chapter> <https://openminds.ebrains.eu/publications/ScholarlyArticle> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/versionIdentifier> a owl:DatatypeProperty ;
    rdfs:label "Version identifier" ;
    rdfs:comment "Term or code used to identify the version of something." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/computation/HardwareSystem> <https://openminds.ebrains.eu/computation/ValidationTestVersion> <https://openminds.ebrains.eu/computation/WorkflowRecipeVersion> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/SoftwareVersion> <https://openminds.ebrains.eu/core/WebServiceVersion> <https://openminds.ebrains.eu/publications/Book> <https://openminds.ebrains.eu/publications/Chapter> <https://openminds.ebrains.eu/publications/LearningResource> <https://openminds.ebrains.eu/publications/LivePaperVersion> <https://openminds.ebrains.eu/publications/ScholarlyArticle> <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CommonCoordinateSpaceVersion> <https://openminds.ebrains.eu/sands/ParcellationEntityVersion> ) ] ;
    rdfs:range xsd:string .

<https://openminds.ebrains.eu/vocab/author> a owl:ObjectProperty ;
    rdfs:label "Author" ;
    rdfs:comment "Creator of a literary or creative work, as well as a dataset publication." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Dataset> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/publications/Book> <https://openminds.ebrains.eu/publications/Chapter> <https://openminds.ebrains.eu/publications/LearningResource> <https://openminds.ebrains.eu/publications/LivePaper> <https://openminds.ebrains.eu/publications/LivePaperVersion> <https://openminds.ebrains.eu/publications/ScholarlyArticle> <https://openminds.ebrains.eu/sands/BrainAtlas> <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CommonCoordinateSpace> <https://openminds.ebrains.eu/sands/CommonCoordinateSpaceVersion> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/Consortium> <https://openminds.ebrains.eu/core/Organization> <https://openminds.ebrains.eu/core/Person> ) ] .

<https://openminds.ebrains.eu/vocab/citedPublication> a owl:ObjectProperty ;
    rdfs:label "Cited publication" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/publications/Book> <https://openminds.ebrains.eu/publications/Chapter> <https://openminds.ebrains.eu/publications/LearningResource> <https://openminds.ebrains.eu/publications/ScholarlyArticle> ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/core/DOI> <https://openminds.ebrains.eu/core/ISBN> ) ] .

<https://openminds.ebrains.eu/vocab/copyright> a owl:ObjectProperty ;
    rdfs:label "Copyright" ;
    rdfs:comment "Exclusive and assignable legal right of an originator to reproduce, publish, sell, or distribute the matter and form of a creative work for a defined time period." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( <https://openminds.ebrains.eu/computation/ValidationTestVersion> <https://openminds.ebrains.eu/computation/WorkflowRecipeVersion> <https://openminds.ebrains.eu/core/DatasetVersion> <https://openminds.ebrains.eu/core/MetaDataModelVersion> <https://openminds.ebrains.eu/core/ModelVersion> <https://openminds.ebrains.eu/core/SoftwareVersion> <https://openminds.ebrains.eu/core/WebServiceVersion> <https://openminds.ebrains.eu/publications/Book> <https://openminds.ebrains.eu/publications/Chapter> <https://openminds.ebrains.eu/publications/LearningResource> <https://openminds.ebrains.eu/publications/LivePaperVersion> <https://openminds.ebrains.eu/publications/ScholarlyArticle> <https://openminds.ebrains.eu/sands/BrainAtlasVersion> <https://openminds.ebrains.eu/sands/CommonCoordinateSpaceVersion> ) ] ;
    rdfs:range <https://openminds.ebrains.eu/core/Copyright> .

<https://openminds.ebrains.eu/vocab/custodian> a owl:ObjectProperty ;
    rdfs:label "Custodian" ;
    rdfs:comment "The 'custodian' is a legal person who is responsible for the content and quality of the data, metadata, and/or code of a research product." ;
